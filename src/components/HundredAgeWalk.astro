  { 키: 'college-job-perception-2026', 나이: 20, 주소: '/college-job-perception-2026', 말: '20대 · 대학생이 느끼는 올해 취업 시장(한경협 조사)' },
  { 키: 'irregular-share-by-age', 나이: 15, 주소: '/irregular-share-by-age', 말: '15세~60세+ · 임금근로자 중 비정규직 비중, 나이·성별로' },
  { 키: 'unemployment-by-age', 나이: 15, 주소: '/unemployment-by-age', 말: '15세~70세+ · 나이대별 실업률, 2015·2020·2025' },
  { 키: 'participation-by-age-sex', 나이: 15, 주소: '/participation-by-age-sex', 말: '15세~70세+ · 경제활동참가율, 남녀·나이별' },
  { 키: 'career-interrupted-by-child-age', 나이: 30, 주소: '/career-interrupted-by-child-age', 말: '20대~50대 · 막내 자녀 나이별 기혼여성의 경력보유 비중' },
  { 키: 'career-interrupted-reason-by-age', 나이: 30, 주소: '/career-interrupted-reason-by-age', 말: '20대~50대 · 나이대별 경력보유여성이 일을 그만둔 사유' },
  { 키: 'twenties-jan-aug-employment', 주소: '/twenties-jan-aug-employment', 말: '20~29세 · 1~8월 누적 취업자, 작년보다 얼마나 줄었나' },
  { 키: 'work-gap', 주소: '/work-gap', 말: '일하는 동안 · 월급이 갈리는 건 업종·규모·지역 중 무엇 때문일까' },
  { 키: 'business-age', 주소: '/business-age', 말: '일하는 동안 · 오래 버티는 업종은 따로 있을까' },
