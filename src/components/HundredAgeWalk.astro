  { 키: 'youth-budget-2027', 주소: '/youth-budget-2027', 말: '0~34세 · 2027년 예산안 지원 제도' },
  { 키: 'mental-health', 주소: '/mental-health', 말: '19세 이상 · 나이대별 스트레스·우울감' },
