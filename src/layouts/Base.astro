---
import Masthead from '../components/Masthead.astro';
import { 데이터세트채우기 } from '../lib/dataset-채운다';
import Analytics from '../components/Analytics.astro';
import PrivacyGate from '../components/PrivacyGate.astro';
import Footer from '../components/Footer.astro';
import PreferredSource from '../components/선호출처.astro';
import { SITE, SITE_URL, PUBLISHER, ADS } from '../consts';
import { cleanPath } from '../lib/format';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** 기사 페이지에서 넘기는 JSON-LD 객체 */
  jsonLd?: unknown;
  ogType?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  /**
   * 이 페이지에는 광고를 **절대** 붙이지 않는다.
   *
   * ⚠ 2026-08-03 KST — 약속이 아니라 코드로 막는 자리다.
   *   Riot 개발자 약관은 **Production 승인 전에 광고를 붙이는 것을 금지**한다.
   *   그런데 `/esports` 는 다른 페이지와 같은 레이아웃을 쓰므로, 나중에 누군가
   *   `ADS.client` 를 채우는 순간 **아무도 의도하지 않은 채로 위반이 된다.**
   *   그리고 그 위반의 벌은 API 접근 영구 박탈이다.
   *
   *   Riot 신청서에 「승인 전에는 광고를 켜지 않는다」고 적었다.
   *   문서에만 적어 두면 언젠가 어긋난다. 여기서 막는다.
   */
  noAds?: boolean;
}

const {
  title,
  description,
  jsonLd,
  ogType = 'website',
  image,
  noindex = false,
  noAds = false,
} = Astro.props;

const path = cleanPath(Astro.url.pathname);
const canonical = path === '/' ? SITE_URL : new URL(path, SITE_URL).href;

// AdSense 「저가치 콘텐츠」 방지(2026-08-24 주의 확인) — 비편집·법무·얇은 지면엔 광고를 아예 싣지 않는다.
// 광고는 실제 편집 콘텐츠(기사·홈·갈래 목록·데이터 지면)에만. noAds prop 이거나 아래 경로면 끈다.
const 비편집경로 = /^\/(terms|privacy|refund|contact|newsletter|community|about|pricing|404)\/?$/.test(path);
const 광고끔 = noAds || 비편집경로;
const ogImage = new URL(image ?? '/og-default.png', SITE_URL).href;
const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;

const adsPush =
  "document.querySelectorAll('ins.adsbygoogle').forEach(function(){(window.adsbygoogle=window.adsbygoogle||[]).push({})});";

// 사이트 전역 Organization/WebSite 마크업 — YMYL 심사에서 발행 주체 식별에 쓰인다.
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  '@id': `${SITE_URL}/#organization`,
  name: SITE.name,
  legalName: PUBLISHER.legalName,
  url: SITE_URL,
  email: PUBLISHER.email,
  foundingDate: PUBLISHER.openedOn,
  address: { '@type': 'PostalAddress', streetAddress: PUBLISHER.address, addressCountry: 'KR' },
  publishingPrinciples: `${SITE_URL}/about`,
  diversityPolicy: `${SITE_URL}/about`,
  ethicsPolicy: `${SITE_URL}/about`,
  // /about 에 실재하는 「Corrections」 절이 우리 정정 정책이다 — 없는 정책을 주장하지 않는다(신조).
  correctionsPolicy: `${SITE_URL}/about`,
};
---

<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* 구글 서치콘솔 소유확인 — seoulmarkets.com 접두어 속성 (사장님 개인계정, 2026-09-03).
        ⛔ 지우면 소유확인이 풀려 노출·클릭·색인 오류를 못 보게 된다.
        ⚠ 토큰은 사이트마다 다르다 — 다른 사이트 레이아웃에 이 값을 옮겨 쓰지 않는다. */}
    <meta name="google-site-verification" content="Jl6p2ZMObUuuq-vyMJiwp9pvXt6g7HNhSQn_W88LCE4" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/*
      네이버 소유확인 (2026-08-08 · 사장님이 서치어드바이저에서 받아 주신 코드).
      ⚠ `HundredYear.astro` 에 「영문 매체에는 넣지 않는다 — 독자가 해외다」라고 적혀 있었다.
        그건 우리 판단이었고, 사장님이 오늘 직접 서울마켓을 네이버에 등록하셨다.
        한국에서 한국 시장 데이터를 찾는 손님은 네이버로 온다.
      ⛔ 소유확인이 끝나도 **이 태그를 지우지 않는다.** 지우면 확인이 풀린다.
    */}
    <meta name="naver-site-verification" content="fb7b0650be3bca9b51c81a625dc82e78f4fcad0e" />
    {/*
      🔴 [2026-10-13 14:0x · 사장님 지시] **네이버 애널리틱스.**
      사장님이 코드를 그대로 주셨다. 원문 그대로 넣는다 — 손대지 않는다.
      wa 값은 «측정 아이디»다. 비밀이 아니라 브라우저로 그대로 나가는 값이다.

      ⚠ 케이라이프맵에는 CSP 가 빡빡해 script-src 에 wcs.pstatic.net 을 열어야 했다.
        여기(SeoulMarkets)는 CSP 가 base-uri·object-src·frame-ancestors 뿐이라 열 것이 없다.
        ⛔ 그렇다고 「열 필요 없다」를 기억으로 적지 않았다 — 라이브 헤더를 재서 확인했다.

      ⛔ 「붙였다」를 「센다」로 읽지 않는다 — 라이브에서 wcs_do 가 실제로 도는지 잰다.
      ⛔ 이 태그를 지우지 않는다. 지우면 그날부터 손님 수가 통째로 빈다.
    */}
    {/* 2026-11-28 GDPR/CCPA: PrivacyGate first; the Naver tag loads only when the gate allows it (see PrivacyGate.astro). */}
    <PrivacyGate />
    <script type="text/javascript" is:inline>
      if (!window.__privacyHold) {
        var wcsTag = document.createElement('script');
        wcsTag.src = 'https://wcs.pstatic.net/wcslog.js';
        wcsTag.onload = function () {
          if (!window.wcs_add) window.wcs_add = {};
          window.wcs_add["wa"] = "127a65fcc0cbb30";
          if (window.wcs) { wcs_do(); }
        };
        document.head.appendChild(wcsTag);
      }
    </script>
    {/*
      애드센스 소유확인 (2026-09-02 · 사장님 직접 지시).
      pub 넘버는 사이트마다 같다(계정 하나). 메타태그만으로 소유확인이 안 돼 스크립트도 넣으라 하셨다.

      🔴 [2026-09-02 · 5번] 여기 있던 «둘째 로더»(같은 pub 을 조건 없이 부르던 한 줄)를 뺐다.
        · `ADS.client` 를 새 계정(3547185342873229)으로 바꿨으므로 아래 129줄 로더가 이미 그것을 부른다
        · 그 한 줄은 **조건이 없었다** — `광고끔` 지면에도 로더가 실린다. 이 파일이 바로 위에
          「noAds 인 페이지에서는 스크립트 자체를 안 부른다」고 적어 둔 함정이다(Auto Ads 는
          슬롯이 없어도 스크립트만 보고 광고를 꽂는다)
        · 옛 주석은 「옛 ADS.client 는 이미 승인받아 광고를 부르는 계정」이라고 적혀 있었다.
          **그 말이 틀렸다** — 재 보니 네 사이트 전부 광고 자리(ins.adsbygoogle) 0개이고
          `slots` 가 빈 문자열이라 옛 계정으로 나가는 광고가 처음부터 없었다
          (사장님 「광고 안나가」). 그 틀린 주석이 「옛 계정을 지켜야 한다」는 판단을 만들었다.
        ⛔ 로더를 다시 더하기 전에 라이브를 한 줄로 잰다 —
          curl -s <주소> | grep -c 'class="adsbygoogle"'
    */}
    <meta name="google-adsense-account" content="ca-pub-3547185342873229" />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/* 🔴 [2026-09-15 · 사장님 「SMarket 으로 변경해」] 아이폰 「홈 화면에 추가」가
        집어 오는 이름은 «이 태그»가 먼저다. 매니페스트 short_name 보다 앞선다.
        이것이 없어서 <title> 을 긁어 「SeoulMarkets」로 떠 있었다.
        ⚠ 길게 두면 홈 화면에서 잘린다. 로고와 똑같이 한 낱말로 둔다. */}
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <meta name="application-name" content={SITE.name} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* 🔴 [2026-09-10 · 5번] 홈화면 아이콘 선언이 «아예 없었다». 그래서 사장님이 폰 홈에
        얹어 두신 SeoulMarkets 이 회색 「K」로 떠 있었다(스크린샷 2026-09-10 20:34).
        사장님: 「케이라이프맵처럼 이미지가 뜨게 좀 하라고」
        아이콘은 `node scripts/make-app-icons.mjs --굽는다` 가 굽는다 — 180x180 불투명. */}
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} is:inline />
      {/* 🔴 [2026-10-05 23:0x · 5번] **Dataset 에 빠진 칸을 여기서 채운다.**
      사장님이 넘겨 주신 구글 메일 — 「데이터세트 구조화된 데이터 문제가 감지됨」.
      서치콘솔은 「'license' 누락 · 항목 1」이라 했는데 저장소를 재 보니
      license 가 179파일, url 이 208파일 빠져 있었다.
      ⛔ 232 파일을 손으로 고치면 **다음에 새로 만든 지면이 또 빠진다.**
      ⭐ 내보내는 줄 하나에서 채우면 지금 것도 앞으로 것도 다 채워진다.
      ⛔ 이미 있는 값은 안 덮는다. 정본을 모르면 url 을 안 넣는다. */}
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(데이터세트채우기(jsonLd, 'seoulmarkets', canonical))} is:inline />}

    {/* 광고를 붙이기 전까지 이 사이트가 부르는 외부 스크립트는 0개다.
        ⚠ noAds 인 페이지에서는 **스크립트 자체를 안 부른다.** 슬롯만 빼면
          Auto Ads 가 스크립트만 보고 알아서 광고를 꽂을 수 있기 때문이다. */}
    {
      ADS.client !== '' && !광고끔 && (
        <script is:inline set:html={`if(!window.__privacyHold){var adTag=document.createElement('script');adTag.async=true;adTag.crossOrigin='anonymous';adTag.src='https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADS.client}';document.head.appendChild(adTag);}`} />
      )
    }
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Masthead />
    <main id="main">
      <slot />
    </main>
    {/* 구글 「선호 출처」 — 자격이 서는 날 저절로 켜진다. 안 서면 아무것도 안 낸다 */}
    <div style="max-width:min(1100px,92vw); margin:0 auto;"><PreferredSource lang="en" /></div>
    <Footer />
    {/*
      인쇄본에만 나오는 발행 정보. 화면에서는 보이지 않는다.

      ⚠ 인쇄하면 머리말·꼬리말을 숨기므로 **종이에는 발행 주체가 사라진다.**
        금융(YMYL) 기사에서 누가 냈는지 없는 인쇄본은 출처를 잃은 종이다.
        인쇄된 것도 우리 매체의 얼굴이라는 것이 필수지시 9의 뜻이다.
        (「리포트도, 웹페이지도 고객이 보는 시작과 결과는 엔진보다 더 치밀해야 한다」)
    */}
    <p class="print-only print-imprint">
      {SITE.name} · {PUBLISHER.legalName} · <span>{canonical}</span>
    </p>
    {/* ins 하나당 한 번씩 광고 요청. 페이지당 스크립트 한 줄로 끝낸다. */}
    {ADS.client !== '' && !광고끔 && <script is:inline set:html={adsPush} />}
  </body>
</html>
