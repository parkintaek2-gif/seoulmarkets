import fs from 'node:fs';
import { 데이터세트채우기 } from '../lib/dataset-채운다';
import Analytics from '../components/Analytics.astro';
import { ADS } from '../consts';
import path from 'node:path';
import { 자매링크 } from '../lib/sister-link';
import ContentRail from '../components/ContentRail.astro';
import AdSlot from '../components/AdSlot.astro';
import PreferredSource from '../components/선호출처.astro';

/** CSS 파일이 바뀌면 저절로 바뀌는 판 번호. ⛔ 손으로 올리지 않는다 —
 *  손으로 올리게 두면 반드시 잊는다(오늘만 규칙을 손으로 적었다가 다섯 곳이 어긋났다). */
const 스타일판 = (() => {
  try {
    const p = path.resolve(process.cwd(), 'public/100y/style.css');
    const 글 = fs.readFileSync(p);
    let h = 0;
    for (let i = 0; i < 글.length; i++) h = (h * 31 + 글[i]) >>> 0;
    return h.toString(36);
  } catch {
    return 'x';
  }
})();
/**
 * HundredYear.astro — 백년지도 공통 레이아웃
 *
 * 왜 Base 를 안 쓰나 — Base 는 SeoulMarkets 의 머리말·꼬리말이 붙어 있다.
 *   금융 매체 얼굴이 교육 사이트에 나오면 안 된다 (100y/index.astro 주석 참조).
 *
 * ⭐ 2026-08-04 — **klifemap.ai 와 같은 디자인 체계로 맞췄다** (사장님 지시).
 *   색·글꼴·간격을 `klifemap/public/index.html` 의 값에서 그대로 가져왔다.
 *   한 회사의 두 사이트가 남처럼 보이면 안 된다.
 *
 * ⭐ 글자 크기 체계 — 사장님 지시: **제목 > 부제1 > 부제2 > 본문 = 표**
 * ```
 *   --fs-title  제목   h1   clamp(27px, 6.2vw, 46px)   Serif 900
 *   --fs-sub1   부제1  h2   clamp(21px, 4.6vw, 30px)   Serif 900
 *   --fs-sub2   부제2  h3   16px                       Serif 700
 *   --fs-body   본문 = 표   15px                        ← 둘이 **같다**
 *   --fs-note   보조(출처·주석) 13px                     위계 밖. 읽는 글이 아니라 딸린 글이다
 * ```
 * ⚠ 표를 본문보다 작게 두지 않는다. 표는 우리 콘텐츠의 몸통이지 각주가 아니다.
 *
 * ⚠ **이 파일이 디자인의 유일한 자리다.** 페이지마다 `.answer`·`.nums`·`.warn` 을
 *   따로 정의하고 있었는데, 그래서 새로 만든 대학 페이지 377장에 스타일이 안 붙었다.
 *   여기로 모아 `is:inline` 로 내보낸다 — 레이아웃의 **스코프** 스타일은
 *   `<slot />` 으로 들어온 페이지 내용에는 **안 걸리기** 때문이다.
 *   (`is:global` 이 아니라 `is:inline` 인 이유는 `<style>` 바로 위 주석 참조 — /_astro 404)
 *
 * ⭐ 2026-08-05 — **인쇄 스타일을 넣었다.** 없어서 종이에서 글자가 사라지고 있었다.
 *   금 2.29 · 본문 1.21 · 흐림 2.63 (읽히려면 4.5). 학부모가 뽑아서 아이와 보는 지면이다.
 *
 * 지키는 것 (스토리보드 §11)
 *   · 모바일이 기본이다. 360px 에서 먼저 그리고 넓힌다
 *   · word-break: keep-all  — 없으면 한글 단어가 어색하게 끊긴다
 *   · 탭 영역 최소 44×44px
 *   · 표는 표 자체만 가로 스크롤(본문은 안 밀린다)
 *
 * ⚠ 다크모드 자동전환을 뺐다. klifemap.ai 가 **다크 한 벌**이라 거기 맞췄다.
 * ⚠ 웹폰트(Noto Serif/Sans KR)가 들어왔다. 첫 화면이 시스템 폰트보다 늦어진다 —
 *   `preconnect` + `display=swap` 으로 줄였지만 0 이 되지는 않는다.
 *
 * ⭐⭐ **2026-08-05 — 기본값을 뒤집었다. 이제 기본이 「열림」이다.**
 *
 * 사장님 결정(18:0x): 「**얇은 것만 빼고 지금 떼라**」
 * ```
 * ▶ 연다   학과 925 · 학교 2,525 중 학과 있는 곳 · 대학 377 · 국책연구 90 · 표 3종 = 2,512장
 * ⏸ 닫는다 학과가 없는 일반고 1,353장 — 이름·주소뿐이라 검색에 올라와도 줄 게 없다
 *          404 — 검색 결과에 실패 화면이 뜨면 안 된다
 * ```
 *
 * **왜 페이지마다가 아니라 기본값을 뒤집었나** — 열 지면이 아홉 곳이고 닫을 곳이 둘이다.
 * 아홉 곳을 고치면 그 파일들을 동시에 만지는 다른 세션과 충돌한다. 둘만 고치는 편이 안전하다.
 *
 * 🔴 **그래서 새 지면을 만들면 자동으로 열린다.** 내용이 얇으면 **직접 `noindex={true}` 를
 *    넘겨라.** 얇은 지면이 많으면 사이트 전체 품질 평가가 깎인다.
 *
 * ⚠ 그리고 `sitemap.xml.ts` 에서 **noindex 인 지면을 빼야 한다** —
 *   사이트맵에 넣어 놓고 noindex 를 걸면 구글에 모순된 신호를 준다.
 */
import { PUBLISHER } from '../consts';

interface Props {
  title: string;
  description: string;
  /** 기본은 **열림**이다. 얇은 지면은 `noindex={true}` 를 직접 넘긴다 */
  noindex?: boolean;
  /** 스토리보드 §11 — og:image 는 카카오톡 유통 경로다. 빈 카드가 나가면 안 퍼진다 */
  ogImage?: string;
  jsonLd?: unknown;
}

const { title, description, noindex = false, ogImage, jsonLd } = Astro.props;

/* 지면이 스스로 「광고 안 받는다」고 말할 수 있게 한다 — 3번이 쓸 자리다 */
const { noAds = false } = Astro.props as { noAds?: boolean };
const FULL = `${title} — 백년지도`;

/**
 * 정본 주소(canonical).
 *
 * ⚠ 빌드 경로에는 `/100y` 가 붙어 있지만, 방문자가 보는 주소에는 없다.
 *   server.mjs 가 Host 헤더를 보고 붙여 주는 **우리 사정**이라서다.
 *   누가 `100yearmap.com/100y/major/조리과` 로 들어와도 같은 페이지가 열리는데,
 *   그러면 검색엔진이 한 문서를 둘로 세고 신호가 갈라진다.
 *   그래서 정본을 **접두사 없는 주소 하나로** 못 박는다.
 */
const ORIGIN = 'https://100yearmap.com';
/** ⚠ `Astro.url.pathname` 은 두 가지를 이미 갖고 있다. 손대면 오히려 망가진다.
 *   ① `.html` 이 붙어 있다 — 빌드가 `dist/100y/major/조리과.html` 로 내기 때문.
 *      우리가 쓰는 정본 주소에는 확장자가 없다(server.mjs 도 그렇게 모아 준다).
 *   ② **이미 퍼센트 인코딩돼 있다.** 여기서 한 번 더 인코딩하면 `%EC` 가 `%25EC` 가 된다.
 *      실제로 그렇게 나갔었다. 그대로 쓴다. */
const canonical =
  ORIGIN +
  (Astro.url.pathname
    .replace(/\/index\.html$/, '/')
    .replace(/\.html$/, '')
    .replace(/^\/100y(?=\/|$)/, '') || '/');

/**
 * ⭐ 기본 OG 카드. **비워 두면 카카오톡에 빈 카드가 나간다.**
 *
 * 2026-08-05 실측 — Props 주석에 「빈 카드가 나가면 안 퍼진다」고 적어 놓고
 *   정작 백년지도에는 한 장도 안 걸어 놨었다. 서울마켓은 걸려 있었다. 내 잘못이다.
 *
 * ⚠ 주소에 `/100y` 를 붙이지 않는다 — 방문자가 보는 주소가 아니다.
 *   파일은 `public/100y/og.png` 에 두고 server.mjs 가 Host 를 보고 `dist/100y/` 에서 찾는다.
 * ⚠ 다시 구우려면 `node scripts/make-og-100yearmap.mjs` — 몇 초다.
 *   브랜드가 바뀌어도 **이 카드 한 장만** 다시 구우면 된다. 지면마다 만들지 않는다.
 * ⚠ 카드에 로고 밑줄(「백년MAP」)은 넣지 않았다. 사장님이 아직 안 정하셨다.
 */
const OG = ogImage ?? `${ORIGIN}/og.png`;
/**
 * 애드센스 로더를 이 지면에서 부를 것인가.
 * ⛔ 이 판단을 지면마다 손으로 적지 않는다 — 손으로 적으면 새 지면에서 반드시 잊는다.
 */
/**
 * 애드센스 로더를 이 지면에서 부를 것인가.
 *
 * 🔴 이 판단이 한 번 조용히 틀렸다(2026-08-24). 두 가지를 같이 둔다 —
 *   ① `noAds` prop — 지면이 스스로 「나는 광고 안 받는다」고 말하는 것. 이게 주다.
 *   ② 길 목록 — 지면이 말하는 것을 잊었을 때의 그물.
 *
 * ⛔ `Astro.url.pathname` 은 손님이 보는 주소가 «아니다.** `build.format: 'file'` 이라
 *   `/esports` 로 나가는 지면의 내부 길은 `/wikitip/esports` 다. 그래서 앞에서 자르지
 *   않고 «마지막 칸»으로 본다. 손님 주소로 조건을 적으면 조용히 통과한다.
 */
const 이지면 = (Astro.url?.pathname ?? '').replace(/\.html$/, '').replace(/\/$/, '');
const 광고빼는지면 = [];
const 광고안받는길 = 광고빼는지면.some((p) => 이지면 === p || 이지면.endsWith(p));
/**
 * 🔴 [2026-11-10 · 5번 · 사장님 「광고 게재해」] **광고 자리를 이제 만든다.**
 *   9월 심사 때 「로더만 두고 자리(ins)는 안 만든다」고 정해 놓고 승인이 난 뒤
 *   아무도 자리를 넣으러 돌아오지 않았다. 11-09 에 재서 알았다 — 백년지도는
 *   하루 손님이 우리 중 가장 많은데(69명) 광고 단위가 **0개**였다.
 *   ⭐ 승인과 수입은 다른 일이다. 「심사 통과」를 「광고가 나간다」로 읽지 않는다.
 *
 * ⛔ 비편집 지면(약관·개인정보·환불·문의·404)은 뺀다. 애드센스가 「저가치 콘텐트」로
 *   보는 자리다 — Base.astro 가 서울마켓츠에서 같은 목록을 이미 쓰고 있다.
 * ✅ 지역 리포트(`/report/...`)에는 **건다.** 2026-11-10 에 사장님 지시로 유료가
 *   완전히 없어졌다(값 지면 `/price` 를 내렸다). 파는 것이 없으니 겹칠 것도 없다.
 *
 * ⚠ `이지면` 은 **빌드 길**이라 `/100y` 가 붙어 있다. 손님 주소로 재야 조건이 맞는다.
 */
const 손님길 = canonical.slice(ORIGIN.length) || '/';
const 비편집길 = /^\/(terms|privacy|refund|contact|404)(\/|$)/.test(손님길);
const 광고를부르나 = ADS.client !== '' && !noAds && !광고안받는길 && !비편집길;
/**
 * ins 하나당 한 번씩 광고 요청. 지면당 이 한 줄로 끝낸다(Base.astro 와 같은 자).
 *
 * 🔴 [2026-11-10 · 5번] **배포한 뒤에 재서 찾았다 — 답이 안 오는 칸이 있다.**
 *   라이브 400px 에서 우리 칸이 `처리=done` 인데 `답(data-ad-status)=null` 인 채로
 *   **385×385 빈 상자**로 남았다(20초 기다려 잼). 같은 지면의 자동 광고 칸은
 *   `unfilled` 을 받아 접혔다. 서울마켓츠에서는 우리 칸도 `unfilled` 을 받는다.
 *   ⇒ 사이트에 따라 답이 아예 안 오는 경우가 있다.
 *
 * ⭐ 400px 화면에서 385px 짜리 빈 상자는 **한 화면을 통째로 먹는다.**
 *   사장님이 올인하라 하신 것이 체류시간인데, 광고를 넣은 날 그것을 깎으면 거꾸로 간 것이다.
 *   CSS 는 `unfilled` 만 접는다 — 답이 «없는» 것은 못 접는다. 그래서 여기서 접는다.
 *
 * ⛔ 채워진 광고를 숨기지 않는다. 광고가 들어오면 구글이 `data-ad-status="filled"` 를
 *   반드시 적는다. 그래서 「요청은 끝났는데(done) 답이 없는 것」만 접는다 — 숨길 광고가 없다.
 * ⚠ 4초를 기다린다. 너무 짧으면 오는 광고를 접고, 너무 길면 빈 상자를 그만큼 보여 준다.
 */
const 광고요청 =
  "document.querySelectorAll('ins.adsbygoogle').forEach(function(){(window.adsbygoogle=window.adsbygoogle||[]).push({})});" +
  "setTimeout(function(){document.querySelectorAll('ins.adsbygoogle').forEach(function(e){" +
  "if(e.getAttribute('data-adsbygoogle-status')==='done'&&!e.getAttribute('data-ad-status')){e.style.display='none';}" +
  "});},4000);";
