---
/*
 * Korea Valuation Tape — 무료 영문 지면(F6 깔때기). (seoulmarkets.com/data/valuation)
 *
 * ── 왜 (사장님 2026-09-10) ─────────────────────────────────────────────
 *   「우리는 영문판 fnGuide이라고 했잖아...여기에 맞춰 실행계획, 개발 일정을 다시 짜야 하지 않나?」
 *   「서울마켓츠일에 80%쓰라는 건데」
 *   FnGuide 의 본체 다섯 축 가운데 재무제표만 없었고, 그것을 오늘 받았다(F1 2,506/2,709).
 *   이 지면은 그 위에 선 F2 를 «무료로» 열어 유입을 만드는 자리다. QUICK 의
 *   Japan Markets View 가 그 자리를 하고 있다 — 무료 영문 콘텐트가 유료 상품의 깔때기다.
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────────────
 * ⛔ 화면에 한국어를 내지 않는다 — 손님이 영어권이다. nameEn·industryEn 이 2,709/2,709 붙었다.
 * ⛔ 「업종 평균」을 만들지 않는다 — 평균이 규범이 되면 나침반이 아니라 압박이다.
 * ⛔ 못 붙은 줄을 숨기지 않는다. 분모를 먼저 적고 그 다음에 붙은 수를 적는다.
 * ⛔ 「싸다·비싸다」를 말하지 않는다. 투자자문이 아니다.
 * 🔴 가장 중요한 고백 — 이 배수는 TTM 이 아니라 «연간 후행»이다. 시총은 하루,
 *   이익·자본은 사업연도 것이라 두 날짜 사이가 몇 달이다. 그것을 표 위에 적는다.
 *
 * 🔴 Astro 앞말(`---` 사이)은 TypeScript 다. JSX 를 넣으면 빌드가 죽는다.
 */
import Base from '../../layouts/Base.astro';
import { SITE_URL } from '../../consts';
import tape from '../../data/korea-valuation-tape.json';
import BuyBar from '../../components/BuyBar.astro';
import CiteAs from '../../components/CiteAs.astro';
/* 🔴 [2026-11-09 · 5번] 광고 자리가 없던 화면이다 — 28일에 9세션이 내려앉는다
   (ChatGPT 6 · 빙 3). Base.astro 기준으로 데이터 화면은 광고를 실어도 되는 편집 콘텐츠다. */
import AdSlot from '../../components/AdSlot.astro';

type Row = {
  ticker: string | null; name: string | null; nameEn: string | null; market: string | null;
  industry: string | null; industryEn: string | null;
  priceAsOf: string | null; fiscalYear: number | null; report: string; basis: string | null;
  marketCap: number | null; netIncome: number | null; totalEquity: number | null;
  totalAssets: number | null; revenue: number | null; operatingIncome: number | null;
  per: number | null; pbr: number | null; roe: number | null; debtToEquity: number | null;
  notMeasured: string | null;
};

const meta = (tape as any)._meta as Record<string, any>;
const rows = ((tape as any).rows ?? []) as Row[];

const fmtDd = (s: string | null) =>
  (s && s.length === 8 ? `${s.slice(0, 4)}-${s.slice(4, 6)}-${s.slice(6, 8)}` : (s ?? '—'));

/* ⛔ 분모를 먼저 센다. 「붙은 수」만 내면 좋아 보이는 수가 된다 */
const total = rows.length;
const withPer = rows.filter((r) => r.per !== null).length;
const withPbr = rows.filter((r) => r.pbr !== null).length;
const withRoe = rows.filter((r) => r.roe !== null).length;

/* PER 이 없는 까닭을 «갈래로» 센다 — 「못 붙었다」로 뭉치지 않는다 */
const joined = rows.filter((r) => !r.notMeasured);
const lossMaking = joined.filter((r) => r.netIncome !== null && r.netIncome <= 0).length;
const notJoined = rows.filter((r) => r.notMeasured);
const reasonCounts = new Map<string, number>();
for (const r of notJoined) reasonCounts.set(r.notMeasured!, (reasonCounts.get(r.notMeasured!) ?? 0) + 1);
const reasons = [...reasonCounts].sort((a, b) => b[1] - a[1]);

/* 화면에 낼 것 — 시총 큰 20곳. ⛔ 「추천」이 아니라 「제일 큰 곳들」이다 */
const biggest = rows
  .filter((r) => r.marketCap !== null)
  .sort((a, b) => (b.marketCap ?? 0) - (a.marketCap ?? 0))
  .slice(0, 20);

/* PER 이 «있는» 것들의 분포를 통으로 보여 준다. ⛔ 평균을 내지 않는다 — 분포를 낸다 */
const perBuckets: Array<{ label: string; test: (n: number) => boolean }> = [
  { label: 'under 5', test: (n) => n < 5 },
  { label: '5 to 10', test: (n) => n >= 5 && n < 10 },
  { label: '10 to 20', test: (n) => n >= 10 && n < 20 },
  { label: '20 to 50', test: (n) => n >= 20 && n < 50 },
  { label: '50 to 100', test: (n) => n >= 50 && n < 100 },
  { label: '100 and above', test: (n) => n >= 100 },
];
const perDist = perBuckets.map((b) => ({
  label: b.label,
  n: rows.filter((r) => r.per !== null && b.test(r.per)).length,
}));
const perDistMax = Math.max(1, ...perDist.map((d) => d.n));

/* 시장별 — E 는 여기 없다. 상장 셋만 있다 */
const marketNames: Record<string, string> = { Y: 'KOSPI', K: 'KOSDAQ', N: 'KONEX' };
const byMarket = ['Y', 'K', 'N'].map((k) => ({
  label: marketNames[k],
  n: rows.filter((r) => r.market === k).length,
  withPer: rows.filter((r) => r.market === k && r.per !== null).length,
}));

const priceDate = fmtDd(meta.priceAsOf);
const fiscalYear = meta.fiscalYear;

/* 🔴 [2026-10-16 · 5번] 이 지면은 AI 검색이 28일에 7번 내린 «우리 최다» 지면인데,
 * 구글에서는 「korea pe ratio」·「kospi pe ratio」 에 노출이 «0회» 였다. 까닭을 재 보니
 * 지면 전체에 「PE ratio」 라는 말이 «한 글자도» 없었다 — 우리는 PER 이라고만 썼다.
 * ⭐ PER 은 한국·일본식 줄임말이고, 영어권 손님은 「PE ratio」 라고 친다.
 *   자동완성 실측 — kospi pe ratio(1번째·파생 5줄) · korea pe ratio(1번째) ·
 *   south korea pe ratio(1번째) · korean stock pe ratio(1번째) · korea pbr(1번째).
 * ⇒ 제목·H1·리드에 「PE ratio」 를 넣고 우리 내부어 「tape」 를 앞에서 뺐다.
 * ⛔ 2026-10-30 전에는 이 제목을 다시 고치지 않는다 (식은기간 14일).
 * ⛔ 고칠 때는 TITLE·H1·DESC 셋을 «같이» 본다. 따로 고치면 서로 다른 말을 한다.
 */
const TITLE = 'Korea PE ratio by company — KOSPI and KOSDAQ valuation (PER, PBR, ROE)';
const DESC =
  `PE ratio (PER), PBR and ROE for ${total.toLocaleString('en-GB')} companies listed on KOSPI, KOSDAQ and KONEX, `
  + `built from DART annual filings for ${fiscalYear} against market caps on ${priceDate}. `
  + `${withPer.toLocaleString('en-GB')} have a PER — the rest are loss-making or unfiled, and we say `
  + `which. Free, in English, with both dates on every row so you can recompute. Not investment advice.`;

const datasetLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Korea Valuation Tape — PER, PBR, ROE by company',
  description: DESC,
  url: `${SITE_URL}/data/valuation`,
  keywords: ['Korea', 'South Korea', 'KOSPI', 'KOSDAQ', 'KONEX', 'PER', 'price-earnings ratio',
    'PBR', 'price-book ratio', 'ROE', 'return on equity', 'valuation', 'DART', 'financial statements',
    'Korean stocks', 'debt to equity'],
  creator: { '@type': 'Organization', name: 'SeoulMarkets', url: SITE_URL },
  publisher: { '@type': 'Organization', name: 'SeoulMarkets', url: SITE_URL },
  license: `${SITE_URL}/terms`,
  isAccessibleForFree: true,
  measurementTechnique:
    'PER = market capitalisation divided by annual net income; PBR = market capitalisation divided '
    + 'by total equity; ROE = annual net income divided by total equity. Financial statement figures '
    + 'come from the Korean Financial Supervisory Service DART open API (fnlttSinglAcntAll, annual '
    + 'report code 11011), consolidated where filed and separate otherwise. Market capitalisation '
    + 'comes from the Korean public data portal daily price dataset. Ratios are null rather than '
    + 'negative or infinite when the denominator is not positive.',
  spatialCoverage: { '@type': 'Place', name: 'Republic of Korea' },
  dateModified: priceDate,
  temporalCoverage: `${fiscalYear}/${priceDate}`,
  variableMeasured: ['PER', 'PBR', 'ROE', 'debt to equity', 'market capitalisation', 'net income',
    'total equity', 'total assets', 'revenue', 'operating income'],
  /* 🔴 [2026-09-10] 무료로 내려받는 것은 «표본»이다 — 스키마에도 그렇게 적는다.
     ⛔ 「전량 CSV」라고 적어 두면 구조화 데이터가 거짓을 말한다. */
  distribution: [{
    '@type': 'DataDownload',
    name: 'Korea valuation tape — free sample (100 largest companies, all columns, CSV)',
    encodingFormat: 'text/csv',
    contentUrl: `${SITE_URL}/data/korea-valuation.csv`,
  }],
};

/* FAQ — ⛔ 화면에 «실제로 보이는» 문장과 같아야 한다(구글 규칙) */
const faq: Array<[string, string]> = [
  /* 🔴🔴 [2026-10-14 · 사장님] 「에스마켓츠에서 꼭 참조하도록」 — K-IFRS 1118(2027 시행).
     영업이익의 정의가 바뀐다(지분법손익이 빠지고 외화손익이 들어온다). 소급 적용이다.
     ⛔ 우리 수치는 «옛 기준»인데 안 밝히고 있었다. 2027년에 어긋나면 우리가 틀려 보인다.
     검사: scripts/잰다-새회계기준을-참조하고있나.mjs */
  ["Will the new accounting standard change these ratios?",
    "It will change the earnings side of them. Korea adopts K-IFRS 1118 (the local form of IFRS 18) for fiscal years beginning on or after 1 January 2027, with early adoption permitted, and it redefines operating profit: equity-method income moves out, foreign-exchange results move in. PER and PBR here are computed from figures filed on the pre-1118 basis. Because the standard is applied retrospectively, the same company may later restate the same year. We do not recompute on the new basis — our tape does not carry equity-method income or FX results, and we will not publish a number we have not measured."],
  ['How many Korean listed companies have a PER?',
    `${withPer.toLocaleString('en-GB')} of ${total.toLocaleString('en-GB')} listed companies have a `
    + `price-earnings ratio here. The gap is mostly companies that did not earn a profit: of the `
    + `${joined.length.toLocaleString('en-GB')} companies whose filing we could read, `
    + `${lossMaking.toLocaleString('en-GB')} reported net income of zero or less, so a PER would be `
    + `negative or undefined and we leave it empty instead.`],
  ['What is the PER of Samsung Electronics?',
    (() => {
      const s = rows.find((r) => r.ticker === '005930');
      if (!s || s.per === null) return 'We could not compute it from the filing we hold, so we are not publishing a number.';
      return `On a ${s.fiscalYear} annual basis against its market capitalisation on ${fmtDd(s.priceAsOf)}, `
        + `Samsung Electronics shows a PER of ${s.per} and a PBR of ${s.pbr}, with ROE of `
        + `${s.roe === null ? 'not available' : `${(s.roe * 100).toFixed(1)}%`}. This is a trailing `
        + `annual figure, not trailing twelve months.`;
    })()],
  ['Where does this Korean valuation data come from?',
    'Financial statements come from DART, the disclosure system run by Korea’s Financial '
    + 'Supervisory Service, through its open API. Market capitalisation comes from the Korean '
    + 'government public data portal daily price dataset. Both are public sources and both are '
    + 'named on every row, with the dates used.'],
  ['Why is the PER on this page different from other sites?',
    'Because this is a trailing annual multiple, not trailing twelve months. The market '
    + 'capitalisation is a single trading day and the earnings figure is the full annual report for '
    + 'the fiscal year, so months separate the two. Both dates ship as columns so the ratio can be '
    + 'recomputed against any other price date.'],
  ['Is Korean company data available in English?',
    `Yes. Every one of the ${total.toLocaleString('en-GB')} rows here carries an English company `
    + 'name and an English industry label. A free CSV sample of the 100 largest is on this page.'],
  ['How many companies are listed on KOSPI and KOSDAQ?',
    byMarket.map((m) => `${m.label} ${m.n.toLocaleString('en-GB')}`).join(', ')
    + '. This counts companies with a DART filing identity, not separate preferred lines.'],
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q, a]) => ({
    '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
const jsonLd = [datasetLd, faqLd];

const pct = (n: number, d: number) => (d === 0 ? '—' : `${((n / d) * 100).toFixed(1)}%`);
const trn = (n: number | null) => (n === null ? '—' : `${(n / 1e12).toFixed(1)}`);
---

<Base title={TITLE} description={DESC} jsonLd={jsonLd}>
  <article class="wrap">
    <h1>Korea PE ratio by company</h1>
    <p class="lead">
      The PE ratio — written PER in Korea and Japan — with PBR and ROE for every company listed in Korea, in English, free.
      Market capitalisation as of <b>{priceDate}</b>; earnings and equity from the{' '}
      <b>{fiscalYear}</b> annual report. Both dates sit on every row.
    </p>
    <BuyBar 자리="top" />

    {/* ⚠ 광고는 «소개 아래»에 둔다 — 위에 두면 휴대폰 첫 화면이 여백이 된다(2026-09-14 실측) */}
    <AdSlot slot="banner" />

    <section class="stats">
      <div class="stat"><b>{total.toLocaleString('en-GB')}</b><span>companies</span></div>
      <div class="stat"><b>{withPer.toLocaleString('en-GB')}</b><span>have a PER</span></div>
      <div class="stat"><b>{withPbr.toLocaleString('en-GB')}</b><span>have a PBR</span></div>
      <div class="stat"><b>{withRoe.toLocaleString('en-GB')}</b><span>have an ROE</span></div>
    </section>

    <section>
      <h2>Read the dates before the numbers</h2>
      <p class="warn">
        These are <b>trailing annual</b> multiples, not trailing twelve months. The market
        capitalisation column is one trading day. The earnings and equity columns are the full annual
        report for {fiscalYear}. Months separate those two dates, so a company whose earnings moved
        since its last annual filing reads high or low here. That is why both dates are columns and
        not a footnote: the ratio can be recomputed against any other price date.
      </p>
      <p class="note">
        This is data, not advice. Nothing here says a company is cheap or expensive, and no sector
        averages are computed — an average would turn into a norm, and a norm is not a compass.
      </p>
    </section>

    <section>
      <h2>Why {(total - withPer).toLocaleString('en-GB')} companies have no PER</h2>
      <p>
        Of the {joined.length.toLocaleString('en-GB')} companies whose filing we could read,{' '}
        <b>{lossMaking.toLocaleString('en-GB')} reported net income of zero or less</b>. A PER built on
        that is negative or undefined, so the cell is empty rather than misleading.
        {joined.length.toLocaleString('en-GB')} − {lossMaking.toLocaleString('en-GB')} =
        {' '}{withPer.toLocaleString('en-GB')}, which is the count above.
      </p>
      <p>The remaining {notJoined.length.toLocaleString('en-GB')} rows could not be joined at all:</p>
      <ul class="why">
        {reasons.map(([why, n]) => (
          <li>
            <b>{n.toLocaleString('en-GB')}</b>{' '}
            {why.includes('자본총계')
              ? 'filed an annual report we could read, but without the equity or net income lines we need'
              : why.includes('시가총액')
                ? 'have no market capitalisation on that trading day'
                : 'have no annual report for that fiscal year — newly listed, merged, or a shell'}
          </li>
        ))}
      </ul>
      <p class="note">
        These rows stay in the file with the reason in a column. Dropping them would remove the
        denominator and leave a flattering count.
      </p>
    </section>

    <section>
      <h2>Where the PERs sit</h2>
      <p class="note">
        A distribution, not an average. {withPer.toLocaleString('en-GB')} companies with a positive
        earnings figure, counted into bands.
      </p>
      <table class="dist">
        <tbody>
          {perDist.map((d) => (
            <tr>
              <th>{d.label}</th>
              <td class="bar">
                <span style={`width:${Math.round((d.n / perDistMax) * 100)}%`}></span>
              </td>
              <td class="n">{d.n.toLocaleString('en-GB')}</td>
              <td class="p">{pct(d.n, withPer)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section>
      <h2>By market</h2>
      <table class="grid">
        <thead><tr><th>Market</th><th>Companies</th><th>With a PER</th><th>Share</th></tr></thead>
        <tbody>
          {byMarket.map((m) => (
            <tr>
              <td>{m.label}</td>
              <td class="n">{m.n.toLocaleString('en-GB')}</td>
              <td class="n">{m.withPer.toLocaleString('en-GB')}</td>
              <td class="n">{pct(m.withPer, m.n)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <BuyBar 자리="mid" />
    <section>
      <h2>The twenty largest by market value</h2>
      <p class="note">
        The largest, not a selection. Market cap in trillions of won on {priceDate}.
        Basis says whether the filing was consolidated or separate — the two are not mixed.
      </p>
      <div class="scroll">
        <table class="grid">
          <thead>
            <tr>
              <th>Company</th><th>Industry</th><th>Mkt</th>
              <th class="n">Cap (₩tn)</th><th class="n">PER</th><th class="n">PBR</th>
              <th class="n">ROE</th><th>Basis</th>
            </tr>
          </thead>
          <tbody>
            {biggest.map((r) => (
              <tr>
                <td class="nm">{r.nameEn}</td>
                <td class="ind">{r.industryEn ?? '—'}</td>
                <td>{r.market ? marketNames[r.market] ?? r.market : '—'}</td>
                <td class="n">{trn(r.marketCap)}</td>
                <td class="n">{r.per ?? '—'}</td>
                <td class="n">{r.pbr ?? '—'}</td>
                <td class="n">{r.roe === null ? '—' : `${(r.roe * 100).toFixed(1)}%`}</td>
                <td class="bs">{r.basis ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">
        A dash means the ratio is not defined on this basis — most often net income of zero or less.
        It does not mean the company was left out.
      </p>
    </section>

    <section>
      <h2>Take a sample now, licence the tape when you need all of it</h2>
      <p>
        <b>Free sample</b> — the 100 largest companies by market value, with every column:
        {' '}<a href="/data/korea-valuation.csv">korea-valuation.csv</a>.
        English company name, English industry, market, market cap, net income, total equity, total
        assets, revenue, operating income, PER, PBR, ROE, debt to equity, the price date, the fiscal
        year, the report code, the basis, and the reason where a row could not be computed.
      </p>
      <p>
        <b>The full tape</b> covers all {total.toLocaleString('en-GB')} listed companies — same
        columns, same method, same dates, {(total - 100).toLocaleString('en-GB')} more rows — plus
        the daily rebuild and the query API.
        {' '}<a href="/data">See what is in the catalogue</a>.
      </p>
      <p class="note">
        We show the sample with every column rather than a trimmed version of everything, because
        you should be able to judge the quality of a row before licensing 2,709 of them. The page
        above counts the whole tape, not the sample, and says so wherever the two differ.
      </p>
    </section>

    <section class="faq">
      <h2>Questions</h2>
      {faq.map(([q, a]) => (
        <div class="qa"><h3>{q}</h3><p>{a}</p></div>
      ))}
    </section>

    {/* [2026-09-11 · 5번 문안 Ⅳ, 2번] 실측: total(tape.rows.length)·Row 열쇠 21개·meta.builtAt */}
    <aside class="licence-cta">
      <p>
        This page shows a slice. The full dataset — <strong>{total.toLocaleString('en-GB')} rows,
        21 columns, built {meta.builtAt}</strong> — is available as CSV and Parquet.{' '}
        <a href="/data#licence">See licence options</a>.
      </p>
    </aside>

    <section>
      <h2>Sources, and what this cannot tell you</h2>
      <p class="note">
        Financial statements: DART open API (Financial Supervisory Service), annual report code
        11011, {fiscalYear}. Market capitalisation: Korean public data portal daily price dataset,
        {' '}{priceDate}. Built {meta.builtAt}.
      </p>
      <p class="note">
        It cannot tell you a fair price, a forecast, or a recommendation. It cannot adjust for
        one-off gains, seasonality, or anything that happened after the annual report was filed.
        It does not compute sector averages. <b>This is not investment advice.</b>
      </p>
    </section>
    <CiteAs title={TITLE} path="/data/valuation" year={2026} />
  <BuyBar 자리="bottom" />
  </article>
</Base>

<style>
  .wrap { max-width: 62rem; margin: 0 auto; padding: 1rem 1.1rem 4rem; }
  h1 { font-size: clamp(1.6rem, 4vw, 2.3rem); line-height: 1.15; margin: 0 0 .6rem; }
  .lead { font-size: 1.05rem; line-height: 1.6; color: #333; margin: 0 0 1.6rem; }
  section { margin: 2.2rem 0; }
