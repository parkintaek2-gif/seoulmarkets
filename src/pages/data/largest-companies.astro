---
/*
 * **The largest companies in Korea, ranked four ways** — 무료 영문 지면(F6 깔때기).
 * (seoulmarkets.com/data/largest-companies)
 *
 * ── 🔴 왜 이 지면을 만들었나 — 짐작이 아니라 실측이다 (2026-09-11 · 5번) ──────────
 *   서치콘솔 28일치(2026-08-11~09-08)를 받아 재니 우리 검색 수요가 «한 갈래»에 몰려 있었다.
 *     biggest korean companies 16 · largest korean companies 7 · largest south korean companies 5
 *     top 10 korean companies 5 · biggest south korean companies 4 · korea largest companies 3 …
 *     ⇒ 같은 뜻의 물음이 **노출 60회 남짓**, 사이트 전체 질의 노출 159회의 **38%**
 *   그런데 그 물음을 받는 지면이 «기사» 하나(`/article/korea-largest-listed-companies`)이고
 *   **평균 순위가 34.9위**다. 넉 장 뒤다. 28일 동안 클릭 1.
 *   ⛔ 그 기사를 다시 쓰는 것으로는 안 된다 — 2026-09-10 에 이미 쟀다:
 *     지면을 닮게 고치는 것과 색인은 상관 +0.19 로 «거꾸로»였다. 말투를 바꿔서 오르지 않는다.
 *   ✅ 오르는 길은 **남이 못 내는 사실을 얹는 것**이다. 그래서 표를 만든다.
 *
 * ── ⭐ 우리만 낼 수 있는 축 — 「제일 큰 열 곳」은 «스물한 곳»이다 ─────────────────
 *   시가총액·매출·자산·영업이익 네 잣대의 상위 10을 합치면 **21곳**이 된다.
 *   네 잣대에 다 드는 곳은 삼성전자와 현대차 둘뿐이다.
 *   SK스퀘어는 시총 3위인데 매출 270위, 한국전력은 매출 5위인데 시총 34위다.
 *   ⇒ 위키백과·포브스 목록은 «한 줄»을 준다. 우리는 **네 줄이 어긋나는 모양**을 준다.
 *   ⭐ 이것이 우리 강령 그대로다 — 「지형을 그려 놓고
 *      」. 「제일 큰 회사」를 우리가 정해 주지 않는다.
 *
 * ── ⛔ 이 지면이 지키는 것 ────────────────────────────────────────────
 * ⛔ 화면에 한국어를 내지 않는다 — 손님이 영어권이다.
 * ⛔ 「1위는 여기다」를 말하지 않는다. 네 잣대를 나란히 놓고 어긋나는 것을 보여 준다.
 * ⛔ 매출 칸이 빈 곳을 목록에서 빼지 않는다. 왜 비었는지를 «세어서» 적는다
 *   (시총 상위 100 가운데 19곳 — 대부분 금융·보험이다).
 * ⛔ 평균을 내지 않는다. 「업종 평균 시총」 같은 것을 만들면 그 순간 규범이 된다.
 * ⛔ 「싸다·비싸다·좋다」를 말하지 않는다. 투자자문이 아니다.
 * 🔴 잣대마다 날짜가 다르다는 것을 표 «위»에 적는다 — 시총은 하루치, 매출·자산·이익은
 *   사업연도치다. 그 사이가 몇 달이다. 각주로 내리지 않는다.
 *
 * 🔴 Astro 앞말(`---` 사이)은 TypeScript 다. JSX 를 넣으면 빌드가 죽는다.
 * ⚠ 줄바꿈만으로 두 글월을 띄우면 «붙어» 나간다("theBoth"). 사이에 {' '} 를 넣는다.
 */
import Base from '../../layouts/Base.astro';
import { SITE_URL } from '../../consts';
import tape from '../../data/korea-valuation-tape.json';
import BuyBar from '../../components/BuyBar.astro';
/* 🔴 [2026-11-09 · 5번] 광고 자리가 없던 화면이다 — 28일에 25번 열린다.
   Base.astro 기준으로 데이터 화면은 광고를 실어도 되는 편집 콘텐츠다. */
import AdSlot from '../../components/AdSlot.astro';

type Row = {
  ticker: string | null; name: string | null; nameEn: string | null; market: string | null;
  industry: string | null; industryEn: string | null;
  priceAsOf: string | null; fiscalYear: number | null; report: string; basis: string | null;
  marketCap: number | null; netIncome: number | null; totalEquity: number | null;
  totalAssets: number | null; revenue: number | null; operatingIncome: number | null;
  per: number | null; pbr: number | null; roe: number | null; debtToEquity: number | null;
  notMeasured: string | null;
};

const meta = (tape as any)._meta as Record<string, any>;
const rows = ((tape as any).rows ?? []) as Row[];
const total = rows.length;

const fmtDd = (s: string | null) =>
  (s && s.length === 8 ? `${s.slice(0, 4)}-${s.slice(4, 6)}-${s.slice(6, 8)}` : (s ?? '—'));
const priceDate = fmtDd(meta.priceAsOf);
const fiscalYear = meta.fiscalYear as number;

const marketNames: Record<string, string> = { Y: 'KOSPI', K: 'KOSDAQ', N: 'KONEX' };
const mkt = (r: Row) => (r.market ? marketNames[r.market] ?? r.market : '—');

/**
 * 네 잣대. `key` 는 자료 칸 이름, `unit` 은 화면에 낼 단위다.
 * ⚠ 잣대마다 «몇 곳에 값이 있나»를 따로 센다. 분모가 잣대마다 다르기 때문이다 —
 *   한 분모로 뭉치면 매출 칸이 빈 274곳이 조용히 사라진다.
 */
type AxisKey = 'marketCap' | 'revenue' | 'totalAssets' | 'operatingIncome';
const axes: Array<{
  key: AxisKey; label: string; short: string; blurb: string; asOf: string;
}> = [
  { key: 'marketCap', label: 'Market value', short: 'Value',
    blurb: 'What the market paid for the whole company on one trading day.',
    asOf: priceDate },
  { key: 'revenue', label: 'Revenue', short: 'Revenue',
    blurb: 'What came in the door over the financial year.',
    asOf: `${fiscalYear} annual report` },
  { key: 'totalAssets', label: 'Total assets', short: 'Assets',
    blurb: 'What the company holds on its balance sheet, borrowed money included.',
    asOf: `${fiscalYear} annual report` },
  { key: 'operatingIncome', label: 'Operating profit', short: 'Profit',
    blurb: 'What the business earned before financing and tax.',
    asOf: `${fiscalYear} annual report` },
];

/** 한 잣대의 내림차순 목록 — 값이 «있는» 것만. ⛔ 없는 것을 0 으로 채우지 않는다 */
const orderBy = (key: AxisKey) =>
  rows.filter((r) => r[key] !== null).sort((a, b) => (b[key] as number) - (a[key] as number));

const lists = axes.map((a) => {
  const ordered = orderBy(a.key);
  return {
    ...a,
    n: ordered.length,
    top: ordered.slice(0, 25),
    rank: new Map(ordered.map((r, i) => [r.ticker, i + 1])),
  };
});
const byKey = new Map(lists.map((l) => [l.key, l]));

/**
 * ⭐ 이 지면의 핵심 — 네 잣대의 상위 10을 «합집합»으로 모은다.
 *   넷이 같은 회사를 가리키면 10곳이다. 어긋나는 만큼 수가 늘어난다.
 */
const TOP = 10;
const unionTickers: string[] = [];
for (const l of lists) {
  for (const r of l.top.slice(0, TOP)) {
    if (r.ticker && !unionTickers.includes(r.ticker)) unionTickers.push(r.ticker);
  }
}
const byTicker = new Map(rows.map((r) => [r.ticker, r]));
const rankOf = (ticker: string | null, key: AxisKey) =>
  (ticker ? byKey.get(key)!.rank.get(ticker) ?? null : null);

/** 네 잣대 «전부»에 상위 10으로 든 곳 */
const inAllFour = unionTickers.filter((t) =>
  axes.every((a) => { const v = rankOf(t, a.key); return v !== null && v <= TOP; }));

/** 어긋남이 가장 큰 곳 — 네 순위의 최고와 최저 차이 */
const spread = unionTickers.map((t) => {
  const rs = axes.map((a) => rankOf(t, a.key)).filter((v): v is number => v !== null);
  return { ticker: t, best: Math.min(...rs), worst: Math.max(...rs), gap: Math.max(...rs) - Math.min(...rs) };
}).sort((a, b) => b.gap - a.gap);

/* 합집합 표는 시가총액 순으로 놓는다 — 없으면 맨 뒤로 */
const unionRows = unionTickers
  .map((t) => byTicker.get(t)!)
  .sort((a, b) => (b.marketCap ?? -1) - (a.marketCap ?? -1));

/**
 * ⛔ 매출 칸이 빈 곳을 세어서 적는다. 「대부분 있다」로 넘기지 않는다.
 *   시총 상위 100 안에서 세는 것이 손님에게 중요한 수다 — 전체 2,709 안에서 세면
 *   「작은 회사 이야기」로 읽히는데, 실제로 빈 곳은 «큰 금융회사»들이다.
 */
const cap100 = orderBy('marketCap').slice(0, 100);
const noRevenue100 = cap100.filter((r) => r.revenue === null);
const noRevenueAll = rows.filter((r) => r.revenue === null).length;
/**
 * 🔴 [2026-09-11 · 6번 검수로 잡힘] **빈 매출 칸의 까닭이 «하나»가 아니라 «둘»이다.**
 *   처음에 나는 274곳 전부를 「표준 계정에 매출 줄이 없다」로 적었다. 6번이 재 보니
 *   상위 100 안의 19곳 가운데 6곳은 그것이 아니라 **우리 수집기가 못 붙인 것**이었고
 *   (SK이노베이션·고려아연·가온전선·SK바이오팜은 매출 계정이 «있는» 회사다),
 *   전체 2,709 로 넓히면 274곳 중 **205곳**이 그 갈래였다.
 *
 * ⛔ 우리 구멍을 「자료에 없다」로 적는 것은 손님에게 틀린 까닭을 말하는 것이다.
 *   회사 규율 그대로다 — 「못 잰 것은 못 쟀다고 적는다」. 남의 탓으로 돌리지 않는다.
 * ✅ 그래서 수를 손으로 박지 않고 «자료에서» 가른다. 6번이 수집기를 고치면 이 수가
 *   저절로 따라 움직이고, 화면 글도 같이 맞는다.
 *     notMeasured 가 비어 있다 → 재무제표는 읽혔는데 그 계정이 없다 (은행·보험·지주)
 *     notMeasured 가 차 있다   → 우리가 그 회사 재무제표를 아직 못 붙였다
 */
const 계정이없다 = (r: Row) => r.revenue === null && !r.notMeasured;
const 우리가못붙였다 = (r: Row) => r.revenue === null && !!r.notMeasured;
const noAccount100 = cap100.filter(계정이없다).length;
const notJoined100 = cap100.filter(우리가못붙였다).length;
const noAccountAll = rows.filter(계정이없다).length;
const notJoinedAll = rows.filter(우리가못붙였다).length;
/* 업종 표는 «계정이 없는» 쪽만 센다 — 우리 구멍을 업종 탓으로 보이게 하지 않는다 */
const noRevenueIndustry = (() => {
  const m = new Map<string, number>();
  for (const r of cap100.filter(계정이없다)) m.set(r.industryEn ?? 'Unclassified', (m.get(r.industryEn ?? 'Unclassified') ?? 0) + 1);
  return [...m].sort((a, b) => b[1] - a[1]);
})();
/* 우리가 못 붙인 큰 회사는 «이름으로» 적는다. 숨기면 그 수가 영영 안 줄어든다 */
const notJoinedNames = cap100.filter(우리가못붙였다).map((r) => r.nameEn).filter(Boolean) as string[];

/* 시장별로 시총 상위 100이 어디에 있나 */
const cap100ByMarket = ['Y', 'K', 'N']
  .map((k) => ({ label: marketNames[k], n: cap100.filter((r) => r.market === k).length }))
  .filter((m) => m.n > 0);

/**
 * 서수 — 🔴 [2026-09-11] 라이브에 「SK Square is **3th** by market value」가 나갔다.
 *   `${순위}th` 로 붙여 적은 탓이다. 손님이 영어권인데 영어가 틀리면 그 지면의 수도 의심받는다.
 * ⚠ 11·12·13 은 예외다(11st 가 아니라 11th). 그래서 100 으로 나눈 나머지를 먼저 본다.
 */
const 서수 = (n: number | null | undefined) => {
  if (n === null || n === undefined) return '—';
  const v = Number(n); const 백 = v % 100; const 십 = v % 10;
  const 꼬리 = (백 >= 11 && 백 <= 13) ? 'th' : 십 === 1 ? 'st' : 십 === 2 ? 'nd' : 십 === 3 ? 'rd' : 'th';
  return `${v.toLocaleString('en-GB')}${꼬리}`;
};
/* ⚠ 조 단위. 백조가 넘으면 소수점을 버리되 «쉼표»는 넣는다 — 「1576 trillion」이 라이브에 나갔다 */
const trn = (n: number | null) => (n === null ? '—'
  : (n / 1e12) >= 100 ? Math.round(n / 1e12).toLocaleString('en-GB') : (n / 1e12).toFixed(1));
const num = (n: number) => n.toLocaleString('en-GB');

const samsung = rows.find((r) => r.ticker === '005930');
const kepco = rows.find((r) => r.nameEn?.startsWith('KOREA ELECTRIC POWER'));
const skSquare = rows.find((r) => r.nameEn?.startsWith('SK Square'));

/**
 * 🔴🔴 [2026-10-04 05:4x · 5번] 제목을 **손님이 실제로 치는 말**에 맞춘다.
 *
 *   이 지면은 「한국에서 가장 큰 회사들」 물음을 받으려고 만든 것이다. 그 물음의
 *   변종 여덟이 우리 노출의 3분의 1이다(2026-10-01 실측) —
 *   ```
 *   biggest korean companies 14 · top 10 korean companies 6 · top korean companies 6
 *   biggest south korean companies 5 · korean companies 5 · largest companies in south korea 5
 *   south korean companies 5 · biggest companies korea 4           합 50
 *   ```
 *   그런데 옛 제목에는 **`biggest` 도 `South Korea` 도 없었다** — `largest … in Korea` 였다.
 *   ⇒ 가장 많이 치는 두 낱말을 앞에 세운다. 우리 차별점(`ranked four ways`)은 그대로 둔다.
 *
 * 🔴 고치기 «전» 기준선 (2026-10-04, 그래야 다음에 갈라낼 수 있다)
 *   이 지면의 노출 **0**. 구글이 「Discovered - currently not indexed」라고 답했고
 *   마지막 크롤 기록이 «없다». 그 물음은 66~80위인 옛 기사가 받고 있었다.
 *   ⇒ 같은 날 첫 화면에도 문을 냈다. 둘을 같이 넣었으므로 **갈라서 재지 못한다** —
 *     그래도 넣는다. 문이 없으면 제목을 고쳐도 구글이 보러 오지 않기 때문이다.
 * ⛔ 2026-10-18 전에는 이 줄을 다시 고치지 않는다 (식은기간 14일 + 구글이 다시 훑을 며칠).
 */
const TITLE = 'The biggest companies in South Korea, ranked four ways (KOSPI & KOSDAQ)';
const DESC =
  `The biggest companies on the Korean stock market (KOSPI and KOSDAQ) by market value, revenue, `
  + `total assets and operating profit — four rankings from one dataset of ${num(total)} listed companies, in English and free. `
  + `The four lists disagree: the top ten is ${unionTickers.length} different companies, and only `
  + `${inAllFour.length} appear in all four. Built from DART annual filings for ${fiscalYear} and `
  + `market caps on ${priceDate}. Not investment advice.`;

const datasetLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Largest Korean companies — four size rankings',
  description: DESC,
  url: `${SITE_URL}/data/largest-companies`,
  keywords: ['largest Korean companies', 'biggest South Korean companies', 'top Korean companies',
    'Korea market capitalisation', 'Korean companies by revenue', 'KOSPI', 'KOSDAQ', 'KONEX',
    'Samsung Electronics', 'SK hynix', 'Hyundai Motor', 'Korean company rankings', 'DART'],
  creator: { '@type': 'Organization', name: 'SeoulMarkets', url: SITE_URL },
  publisher: { '@type': 'Organization', name: 'SeoulMarkets', url: SITE_URL },
  license: `${SITE_URL}/terms`,
  isAccessibleForFree: true,
  measurementTechnique:
    'Companies are ordered separately on four measures and no composite score is built. Market '
    + 'capitalisation comes from the Korean public data portal daily price dataset for a single '
    + 'trading day. Revenue, total assets and operating profit come from the Korean Financial '
    + 'Supervisory Service DART open API (fnlttSinglAcntAll, annual report code 11011), '
    + 'consolidated where filed and separate otherwise. A company with no figure on a measure is '
    + 'left out of that ranking rather than entered as zero, and the count of such companies is '
    + 'published on the page.',
  spatialCoverage: { '@type': 'Place', name: 'Republic of Korea' },
  dateModified: priceDate,
  temporalCoverage: `${fiscalYear}/${priceDate}`,
  variableMeasured: ['market capitalisation', 'revenue', 'total assets', 'operating income'],
  distribution: [{
    '@type': 'DataDownload',
    name: 'Korea valuation tape — free sample (100 largest companies, all columns, CSV)',
    encodingFormat: 'text/csv',
    contentUrl: `${SITE_URL}/data/korea-valuation.csv`,
  }],
};

/* FAQ — ⛔ 화면에 «실제로 보이는» 문장과 같아야 한다(구글 규칙) */
const faq: Array<[string, string]> = [
  /* 🔴🔴 [2026-10-14 · 사장님] 「에스마켓츠에서 꼭 참조하도록」 — K-IFRS 1118(2027 시행).
     영업이익의 정의가 바뀐다(지분법손익이 빠지고 외화손익이 들어온다). 소급 적용이다.
     ⛔ 우리 수치는 «옛 기준»인데 안 밝히고 있었다. 2027년에 어긋나면 우리가 틀려 보인다.
     검사: scripts/잰다-새회계기준을-참조하고있나.mjs */
  ["Does the new accounting standard change this ranking?",
    "It can change the profit ranking, not the market-value one. Korea adopts K-IFRS 1118 (the local form of IFRS 18) for fiscal years beginning on or after 1 January 2027. Equity-method income leaves operating profit and foreign-exchange results enter it. Holding companies — whose earnings are largely equity-method income — can move from a large operating profit to an operating loss with no change in the underlying business. The operating-profit figures here are on the pre-1118 basis, as filed, and companies will restate prior years when they adopt."],
  ['What is the largest company in South Korea?',
    `It depends on what you measure. ${samsung?.nameEn ?? 'Samsung Electronics'} is first by market `
    + `value at ${trn(samsung?.marketCap ?? null)} trillion won on ${priceDate} and first by revenue `
    + `for ${fiscalYear}, but it is ${서수(rankOf('005930', 'totalAssets'))} by total assets, `
    + `where ${byKey.get('totalAssets')!.top[0]?.nameEn} is first. This page publishes all four `
    + `orders side by side rather than picking one.`],
  ['What are the top 10 biggest companies in Korea?',
    `There is no single top ten. Taking the top ten on each of the four measures and putting them `
    + `together gives ${unionTickers.length} companies, not ten. Only ${inAllFour.length} appear in `
    + `all four lists: ${inAllFour.map((t) => byTicker.get(t)?.nameEn).join(' and ')}.`],
  ['Why do the rankings disagree so much?',
    `Because the four measures answer different questions. `
    + `${skSquare?.nameEn ?? 'SK Square'} is `
    + `${서수(rankOf(skSquare?.ticker ?? null, 'marketCap'))} by market value and `
    + `${서수(rankOf(skSquare?.ticker ?? null, 'revenue'))} by revenue. `
    + `${kepco?.nameEn ?? 'KEPCO'} is ${서수(rankOf(kepco?.ticker ?? null, 'revenue'))} by revenue `
    + `and ${서수(rankOf(kepco?.ticker ?? null, 'marketCap'))} by market value. Market value is `
    + `what buyers paid on one day; revenue is what came in the door over a year. Neither is the `
    + `true size, and we do not combine them into a score.`],
  ['Are Korean banks missing from the revenue ranking?',
    `Some are, for two different reasons, and we separate them. Of the 100 largest companies by `
    + `market value, ${noRevenue100.length} have no revenue figure here: ${noAccount100} because `
    + `their filing carries no revenue account at all — banks, insurers and holding companies `
    + `report interest, premiums or equity-method income instead — and ${notJoined100} because our `
    + `own collector has not yet attached their statements. Across all ${num(total)} companies it `
    + `is ${num(noAccountAll)} and ${num(notJoinedAll)}. The second number is our gap, not the `
    + `market's, and we publish it rather than folding it into the first.`],
  ['Where does this data come from and is it free?',
    `It is free and in English. Financial figures come from the Korean Financial Supervisory `
    + `Service DART open API, annual report code 11011 for ${fiscalYear}. Market capitalisation `
    + `comes from the Korean government public data portal daily price dataset for ${priceDate}. `
    + `A CSV of the 100 largest with every column is on this page.`],
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q, a]) => ({
    '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
const jsonLd = [datasetLd, faqLd];
---

<Base title={TITLE} description={DESC} jsonLd={jsonLd}>
  <article class="wrap">
    {/* 🔴 [2026-10-04 · 5번] `<title>` 만 고치고 이 줄을 잊었다가 실물을 띄워 보고 잡았다.
        구글은 H1 도 보고, 손님이 «처음 읽는» 말이 이것이다. 둘이 다른 말을 하면 안 된다.
        ⛔ 제목을 고칠 때는 `<title>`·H1·`DESC` 셋을 «같이» 본다. */}
    <h1>The biggest companies in South Korea</h1>
    <p class="lead">
      Four rankings, one dataset, {num(total)} listed companies. Market value on{' '}
      <b>{priceDate}</b>; revenue, assets and operating profit from the <b>{fiscalYear}</b>{' '}
      annual reports. We do not merge them into a single order, because they do not agree.
    </p>
    <BuyBar 자리="top" />

    {/* ⚠ 광고는 «소개 아래»에 둔다 — 위에 두면 휴대폰 첫 화면이 여백이 된다(2026-09-14 실측) */}
    <AdSlot slot="banner" />

    <section class="stats">
      <div class="stat"><b>{unionTickers.length}</b><span>companies make a top ten</span></div>
      <div class="stat"><b>{inAllFour.length}</b><span>make all four</span></div>
      <div class="stat"><b>{spread[0]?.gap ?? 0}</b><span>widest rank gap</span></div>
      <div class="stat"><b>{num(total)}</b><span>companies measured</span></div>
    </section>

    <section>
      <h2>&ldquo;The ten largest&rdquo; is {unionTickers.length} companies</h2>
      <p>
        Rank each of the four measures, take the top ten of each, and put them in one pile. If the
        measures agreed you would get ten names. You get <b>{unionTickers.length}</b>. Only{' '}
        <b>{inAllFour.length}</b> — {inAllFour.map((t) => byTicker.get(t)?.nameEn).join(' and ')} —
        {' '}appear in every one.
      </p>
      <div class="scroll">
        <table class="grid">
          <thead>
            <tr>
              <th>Company</th><th>Industry</th><th>Mkt</th>
              {axes.map((a) => <th class="n">{a.short}</th>)}
            </tr>
          </thead>
          <tbody>
            {unionRows.map((r) => (
              <tr>
                <td class="nm">{r.nameEn}</td>
                <td class="ind">{r.industryEn ?? '—'}</td>
                <td>{mkt(r)}</td>
                {axes.map((a) => {
                  const v = rankOf(r.ticker, a.key);
                  return <td class={v !== null && v <= TOP ? 'n hit' : 'n'}>{v ?? '—'}</td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">
        Numbers are ranks, not values — 1 is the largest on that measure. A shaded cell is a top
        ten. A dash means the company has no figure on that measure; it is not a zero, and the
        company is not ranked last. The section below counts how many those are and which they are.
      </p>
    </section>

    <section>
      <h2>Read the dates before the ranks</h2>
      <p class="warn">
        The four columns are not measured on the same day. Market value is <b>one trading day</b>
        {' '}({priceDate}). Revenue, assets and operating profit are the <b>full financial year</b>
        {' '}({fiscalYear} annual report). Months separate them, so a company whose business moved
        since its last annual filing will sit high on one column and low on another for that reason
        alone. Both dates are printed on every row of the underlying file rather than kept in a
        footnote, so any ranking here can be rebuilt against another price date.
      </p>
      <p class="note">
        This is data, not advice. Nothing here says a company is large in a way that matters, or
        that being large is good. No sector averages are computed — an average becomes a norm, and a
        norm is not a compass.
      </p>
    </section>

    {lists.map((l) => (
      <section>
        <h2>By {l.label.toLowerCase()}</h2>
        <p class="note">
          {l.blurb} {num(l.n)} of {num(total)} companies have this figure. As of {l.asOf}.
        </p>
        <div class="scroll">
          <table class="grid">
            <thead>
              <tr>
                <th class="n">#</th><th>Company</th><th>Industry</th><th>Mkt</th>
                <th class="n">{l.label} (&#8361;tn)</th>
                <th class="n">Rank by value</th><th class="n">Rank by revenue</th>
              </tr>
            </thead>
            <tbody>
              {l.top.map((r, i) => (
                <tr>
                  <td class="n rk">{i + 1}</td>
                  <td class="nm">{r.nameEn}</td>
                  <td class="ind">{r.industryEn ?? '—'}</td>
                  <td>{mkt(r)}</td>
                  <td class="n">{trn(r[l.key])}</td>
                  <td class="n">{rankOf(r.ticker, 'marketCap') ?? '—'}</td>
                  <td class="n">{rankOf(r.ticker, 'revenue') ?? '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}

    <section>
      <h2>Who has no revenue figure — and which half of that is our fault</h2>
      <p>
        Of the 100 largest companies by market value, <b>{noRevenue100.length}</b> have no revenue
        figure here. That is not one fact but two, and they deserve different answers, so we count
        them separately. Across all {num(total)} companies the split is{' '}
        <b>{num(noAccountAll)}</b> and <b>{num(notJoinedAll)}</b>.
      </p>
      <table class="grid">
        <thead>
          <tr><th>Why the cell is empty</th><th class="n">In the largest 100</th><th class="n">All {num(total)}</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>The filing carries no revenue account</td>
            <td class="n">{noAccount100}</td><td class="n">{num(noAccountAll)}</td>
          </tr>
          <tr>
            <td><b>Our collector has not attached the statements yet</b></td>
            <td class="n">{notJoined100}</td><td class="n">{num(notJoinedAll)}</td>
          </tr>
        </tbody>
      </table>
      <p class="warn">
        The second row is <b>our gap, not the market's</b>. Those companies file a revenue figure;
        we have not read it yet. Rolling it into the first row would make this page look complete
        and would be false, so it sits here as its own line and will shrink as we fix the collector.
        {notJoinedNames.length > 0 && (
          <> In the largest 100 they are: {notJoinedNames.join(' · ')}</>
        )}
      </p>
      <p>
        The first row is a real property of the filings. Banks, insurers and holding companies file
        an income statement built around interest, premiums or equity-method income rather than a
        single revenue line, so the standardised account is simply not there. Filling those cells
        with a substitute would make the revenue ranking look complete while comparing two different
        things.
      </p>
      <table class="grid">
        <thead><tr><th>Industry, where the account does not exist</th><th class="n">In the largest 100</th></tr></thead>
        <tbody>
          {noRevenueIndustry.map(([ind, n]) => (
            <tr><td>{ind}</td><td class="n">{n}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="note">
        None of these companies is dropped. They still rank by market value, total assets and
        operating profit; they are absent only from the revenue column.
      </p>
    </section>

    <BuyBar 자리="mid" />
    <section>
      <h2>Where the largest are listed</h2>
      <table class="grid">
        <thead><tr><th>Market</th><th class="n">In the largest 100 by value</th></tr></thead>
        <tbody>
          {cap100ByMarket.map((m) => (
            <tr><td>{m.label}</td><td class="n">{m.n}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="note">
        Company counts, not share lines: a company with preferred shares is counted once, under its
        DART filing identity.
      </p>
    </section>

    <section>
      <h2>Take the file</h2>
      <p>
        <b>Free sample</b> — the 100 largest companies by market value, every column:
        {' '}<a href="/data/korea-valuation.csv">korea-valuation.csv</a>. English company name,
        English industry, market, market cap, net income, total equity, total assets, revenue,
        operating income, PER, PBR, ROE, debt to equity, the price date, the fiscal year, the report
        code, the basis, and the reason where a row could not be computed.
      </p>
      <p>
        Ratios for the same companies are on the{' '}
        <a href="/data/valuation">Korea valuation tape</a>. The full tape covers all {num(total)}{' '}
        listed companies with the same columns and the same dates —{' '}
        <a href="/data">see what is in the catalogue</a>.
      </p>
    </section>

    <section class="faq">
      <h2>Questions</h2>
      {faq.map(([q, a]) => (
        <div class="qa"><h3>{q}</h3><p>{a}</p></div>
      ))}
    </section>

    {/* [2026-09-11 · 5번 문안 Ⅳ, 2번] 실측: total(tape.rows.length)·Row 열쇠 21개·meta.builtAt */}
    <aside class="licence-cta">
      <p>
        This page shows a slice. The full dataset — <strong>{total.toLocaleString('en-GB')} rows,
        21 columns, built {meta.builtAt}</strong> — is available as CSV and Parquet.{' '}
        <a href="/data#licence">See licence options</a>.
      </p>
    </aside>

    <section>
      <h2>Sources, and what this cannot tell you</h2>
      <p class="note">
        Financial statements: DART open API (Financial Supervisory Service), annual report code
        11011, {fiscalYear}. Market capitalisation: Korean public data portal daily price dataset,
        {' '}{priceDate}. Built {meta.builtAt}.
      </p>
      <p class="note">
        It cannot tell you which company is the largest, because that is a choice of measure and the
        choice is yours. It cannot adjust for anything that happened after the annual report was
        filed, and it does not rank private companies, which do not file this way.{' '}
        <b>This is not investment advice.</b>
      </p>
    </section>
  <BuyBar 자리="bottom" />
  </article>
</Base>

<style>
  .wrap { max-width: 62rem; margin: 0 auto; padding: 1rem 1.1rem 4rem; }
  h1 { font-size: clamp(1.6rem, 4vw, 2.3rem); line-height: 1.15; margin: 0 0 .6rem; }
  .lead { font-size: 1.05rem; line-height: 1.6; color: #333; margin: 0 0 1.6rem; }
  section { margin: 2.2rem 0; }
  h2 { font-size: 1.15rem; margin: 0 0 .6rem; }
  h3 { font-size: .98rem; margin: 0 0 .3rem; }
  p { line-height: 1.65; margin: 0 0 .7rem; }
  .note { font-size: .88rem; color: #555; }
  .warn { font-size: .95rem; line-height: 1.65; background: #fffaf2; border-left: 3px solid #d08700;
          padding: .7rem .9rem; margin: 0 0 .7rem; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: .7rem; }
  .stat { border: 1px solid #e3e3e3; border-radius: 6px; padding: .8rem .9rem; background: #fcfcfc; }
  .stat b { display: block; font-size: 1.45rem; line-height: 1.1; }
  .stat span { font-size: .82rem; color: #666; }
  table { border-collapse: collapse; width: 100%; font-size: .9rem; }
  .grid th, .grid td { border-bottom: 1px solid #ececec; padding: .38rem .5rem; text-align: left; }
  .grid thead th { border-bottom: 2px solid #ddd; font-weight: 600; }
  .n { text-align: right; font-variant-numeric: tabular-nums; }
  .nm { font-weight: 600; }
  .rk { color: #666; }
  .ind { color: #555; font-size: .84rem; }
  .hit { background: #eef5f0; font-weight: 600; }
  /* ⚠ 표가 좁은 화면에서 «값 칸»을 밀어내지 않게 가로 스크롤을 준다 */
  .scroll { overflow-x: auto; }
  .scroll .grid { min-width: 44rem; }
  .qa { margin: 0 0 1rem; }
  a { color: #1a5c9c; }
  .licence-cta { margin: 1.6rem 0; padding: .9rem 1.1rem; border: 1px solid #e3e3e3;
                 border-radius: 8px; background: #fcfcfc; font-size: .88rem; }
  .licence-cta p { margin: 0; }
  @media (prefers-color-scheme: dark) {
    .lead { color: #cfcfcf; }
    .note { color: #a8a8a8; }
    .warn { background: #2a2318; border-left-color: #c08a20; }
    .stat { border-color: #333; background: #1b1b1b; }
    .grid th, .grid td { border-bottom-color: #2c2c2c; }
    .grid thead th { border-bottom-color: #3a3a3a; }
    .ind, .rk { color: #a0a0a0; }
    .hit { background: #1e2b23; }
    a { color: #7ab3e8; }
    .licence-cta { border-color: #333; background: #1b1b1b; }
  }
</style>
