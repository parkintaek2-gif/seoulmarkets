          .catch(function () {
            /* ⛔ 페이팔은 이미 구독을 승인했다 — 여기서 실패해도 손님은 이미 낸 돈의
               권리가 있다. 다시 확인이 안 되면 링크만 임시로 만들어 그대로 드린다
               (다음에 /api/download 를 부르면 그때 다시 확인된다). */
            글(알림, '');
            끝났다('your subscription is active.',
              '/api/download?order=' + encodeURIComponent(data.subscriptionID) +
              '&product=' + encodeURIComponent(고른품.코드) +
              (고른셋 ? '&dataset=' + encodeURIComponent(고른셋.코드) : ''),
              'Subscription ' + data.subscriptionID +
              '. Cancel any time in your PayPal account. Trouble? admin@klifedesign.net');
          });
      };
    } else {
      옵션.createOrder = function () {
        return fetch('/api/pay/order', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ product: 고른품.코드, dataset: 고른셋 ? 고른셋.코드 : null, email: (메일칸 && 메일칸.value || '').trim() }),
        }).then(function (r) { return r.json(); })
          .then(function (j) { if (!j.ok) throw new Error(j.error || 'order failed'); return j.id; });
      };
      옵션.onApprove = function (data) {
        글(알림, 'Confirming your payment...');
        return fetch('/api/pay/capture', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ orderID: data.orderID, product: 고른품.코드, dataset: 고른셋 ? 고른셋.코드 : null, email: (메일칸 && 메일칸.value || '').trim() }),
        }).then(function (r) { return r.json(); })
          .then(function (j) {
            if (!j.ok) throw new Error(j.error || 'not confirmed');
            끝났다('payment received.', j.downloadUrl,
              'Keep this link \u2014 it does not expire. Order ' + data.orderID +
              '. Receipt ' + (j.receipt || '') +
              '. Lost it? Go to seoulmarkets.com/recover and enter that order ID \u2014 PayPal emailed it to you too.' +
              ' Trouble? admin@klifedesign.net');
          });
      };
    }

    옵션.onError = function (err) {
      /* 조용히 실패하지 않는다 — 손님이 무엇을 해야 하는지 말해 준다 */
