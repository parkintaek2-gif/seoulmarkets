    셋줄.hidden = !(고른품 && 고른품.고르기);
    값칸.textContent = 고른품 ? ('Total: ' + 고른품.값글 + ' \u2014 ' + 고른품.기간글) : '';
    단추칸.innerHTML = '';
    if (!살수있나()) {
      글(알림, 고른품 && 고른품.고르기 ? 'Choose a dataset to continue.' : 'Choose a licence to continue.');
      return;
    }
    if (!메일유효()) {
      글(알림, 'Enter a valid email above (for your receipt and download link) to continue.');
      return;
