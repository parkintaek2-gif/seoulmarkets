  function 끝났다(무엇, 링크, 영수증) {
    글(알림, '');
    단추칸.innerHTML = '';
    끝칸.hidden = false; 끝칸.innerHTML = '';
    var h = document.createElement('p');
    var st = document.createElement('strong'); st.textContent = 'Thank you \u2014 ' + 무엇;
    h.appendChild(st); 끝칸.appendChild(h);
    if (링크) {
      var a = document.createElement('p');
      var l = document.createElement('a'); l.href = 링크; l.textContent = 'Download your files (.tar.gz)';
      a.appendChild(l); 끝칸.appendChild(a);
    }
    var f = document.createElement('p'); f.className = 'fine'; f.textContent = 영수증;
    끝칸.appendChild(f);
  }

  function 판고르기() {
    return 주기 === 'month' ? window.paypal_sub : window.paypal_once;
  }

  function 그리자() {
    var pp = 판고르기();
    if (!pp || !pp.Buttons) { 글(알림, 'Checkout is still loading...'); return; }
    var 옵션 = { style: { layout: 'vertical', shape: 'rect', label: 주기 === 'month' ? 'subscribe' : 'pay' } };

    if (주기 === 'month') {
      /* 정기결제는 페이팔이 청구를 맡는다. 우리는 가입했나만 확인한다 */
      옵션.createSubscription = function (data, actions) {
