  var 메일칸 = document.getElementById('buyEmail');
  function 메일유효() { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test((메일칸 && 메일칸.value || '').trim()); }
  if (메일칸) 메일칸.addEventListener('input', 다시그리기);
  var 주기칸 = document.getElementById('buyCycle');
  var 품칸 = document.getElementById('buyProducts');
