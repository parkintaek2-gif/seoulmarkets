  { key: 'uae', 이름: 'Abu Dhabi · Dubai', 나라: 'UAE', 찾을말: /uae|adx|dfm|abu dhabi|dubai|gulf|dirham/i },
  { key: 'japan', 이름: 'Tokyo', 나라: 'Japan', 찾을말: /japan|jpx|edinet|tokyo|topix|yen/i },
  { key: 'taiwan', 이름: 'Taipei', 나라: 'Taiwan', 찾을말: /taiwan|twse|taipei|new taiwan dollar|twd/i },
];

/** 한 상품이 어느 시장 것인가. ⛔ 못 가리면 «비워 둔다» — 짐작으로 한국에 넣지 않는다 */
function 시장찾기(p) {
  if (Array.isArray(p.시장)) return p.시장;                 /* 손으로 적어 둔 것이 먼저다 */
  const 글 = String(p.name || '') + ' ' + String(p.one || '');
  const 것 = 시장표.filter((m) => m.찾을말.test(글)).map((m) => m.key);
  return 것;
}

