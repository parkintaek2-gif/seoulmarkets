---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { CATEGORIES, SITE, SITE_URL } from '../consts';
import { publishedArticles } from '../lib/articles';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug }, props: { cat: c } }));
}

const { cat } = Astro.props;
const articles = await publishedArticles(cat.slug);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${cat.label} — ${SITE.name}`,
  description: cat.blurb,
  url: `${SITE_URL}/${cat.slug}`,
  isPartOf: { '@id': `${SITE_URL}/#organization` },
};
---

<Base title={('seoTitle' in cat && cat.seoTitle) ? cat.seoTitle : cat.label} description={`${cat.blurb} ${SITE.description}`} jsonLd={jsonLd}>
  <div class="wrap">
    {/* 🔴🔴 [2026-11-15 · 사장님] 「**광고는 케이컬쳐만 승인 받은. 거기에만 광고 넣어. 더하지마**」
         승인된 것은 **케이컬처와이어 하나**다. 여기 있던 광고 자리를 뺐다.
         ⛔ 승인 없이 자리를 두면 빈 칸만 남고, 애드센스에도 좋지 않다.
         ✅ 다시 넣는 것은 그 사이트가 승인된 뒤다 — `node scripts/check-ad-fill.mjs` 로 잰다. */}

    <div class="page-head">
      <p class="kicker">Section</p>
      <h1>{cat.label}</h1>
      <p>{cat.blurb}</p>
    </div>

    {
      articles.length === 0 ? (
        <p class="empty">Nothing filed in {cat.label} yet.</p>
      ) : (
        <ul class="stream">
          {articles.map((entry) => (
            <ArticleCard entry={entry} />
          ))}
        </ul>
      )
    }

    <a class="backlink" href="/">&larr; All sections</a>
  </div>
</Base>
