---
/**
 * /100y/irregular-women-share-by-age — 비정규직 안의 여자 몫과 임금근로자 안의 여자 몫 (나이대별, 2016·2026년 8월)
 *
 * 출처  KOSIS 101/DT_1DE7006S 경제활동인구조사 근로형태별 부가조사 — irregular-share-by-age.json 의 사람 수.
 * 이 쪽에서 한 일은 나눗셈뿐이다. 원인 추측·조언은 싣지 않는다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import HundredAgeWalk from '../../../components/HundredAgeWalk.astro';
import 원본 from '../../../data/100yearmap/irregular-share-by-age.json';

const 자료 = 원본 as any;
const 월들: string[] = 자료.월;
const 처음 = 월들[0];
const 최신 = 월들[월들.length - 1];
const 연 = (m: string) => m.slice(0, 4);
const 연령: string[] = 자료.연령;
const 비정 = (성: string, a: string, m: string): number => 자료.값[성][a][m].비정규직;
const 임 = (성: string, a: string, m: string): number => 자료.값[성][a][m].임금근로자;
const 만 = (n: number) => `${(n / 10).toLocaleString('ko-KR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}만명`;
const 퍼 = (n: number) => `${n.toFixed(1)}%`;
const 부호 = (n: number) => `${n > 0 ? '+' : ''}${n.toFixed(1)}%p`;
const 여몫비정 = (a: string, m: string) => (비정('여자', a, m) / 비정('계', a, m)) * 100;
const 여몫임금 = (a: string, m: string) => (임('여자', a, m) / 임('계', a, m)) * 100;
const 이름 = (a: string) => (a === '60세이상' ? '60세 이상' : a === '계' ? '전체' : a.replace('-', '~'));

const 전체비정 = 여몫비정('계', 최신);
const 전체임금 = 여몫임금('계', 최신);
const 십오 = 여몫비정('60세이상', 최신);

const desc =
  `경제활동인구조사 8월 부가조사(KOSIS)에서 ${연(최신)}년 8월 비정규직 ${만(비정('계', '계', 최신))} 가운데 여자는 ${만(비정('여자', '계', 최신))}(${퍼(전체비정)})입니다. ` +
  `임금근로자 전체에서 여자 몫은 ${퍼(전체임금)}입니다. 나이대별로 두 몫을 나란히 놓았습니다.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: '비정규직 안의 여자 몫 — 나이대별, 경제활동인구조사 근로형태별 부가조사',
  description: desc,
  dateModified: 자료.만든날,
  creator: { '@type': 'Organization', name: '백년지도' },
  sourceOrganization: { '@type': 'Organization', name: 자료.출처.이름 },
  isBasedOn: 자료.출처.주소,
  variableMeasured: ['비정규직 취업자 수', '임금근로자 수', '성별', '연령대'],
};
---

<HundredYear
  title={`비정규직 ${퍼(전체비정)}가 여자, 임금근로자 중 여자는 ${퍼(전체임금)} — 나이대별 (${연(최신)}년 8월)`}
  description={desc}
  jsonLd={jsonLd}
>
  <h1>비정규직 열 명 가운데<br />여자는 몇 명일까요</h1>
  <p class="sub">
    경제활동인구조사 8월 부가조사에는 성별·나이대별 비정규직 수와 임금근로자 수가 있습니다. 비정규직 안에서 여자가 차지하는 몫과 임금근로자 전체 안에서 여자가 차지하는 몫을 이 쪽에서 계산해 나란히 놓았습니다.
  </p>

  <div class="answer">
    <p class="answer-label">{연(최신)}년 8월, 비정규직 중 여자 몫</p>
    <p class="answer-num">{퍼(전체비정)}</p>
    <p class="answer-sub">{만(비정('여자', '계', 최신))} / {만(비정('계', '계', 최신))} · 임금근로자 중 여자 {퍼(전체임금)} · {연(처음)}년 {퍼(여몫비정('계', 처음))}</p>
  </div>

  <h2>나이대별, 두 몫을 나란히 ({연(최신)}년 8월)</h2>
  <div class="tablewrap">
    <table>
      <thead>
        <tr>
          <th>나이대</th>
          <th>비정규직 중 여자</th>
          <th>임금근로자 중 여자</th>
          <th>두 몫의 차이</th>
        </tr>
      </thead>
      <tbody>
        {['계', ...연령].map((a) => (
          <tr>
            <td>{이름(a)}</td>
            <td><strong>{퍼(여몫비정(a, 최신))}</strong> ({만(비정('여자', a, 최신))})</td>
            <td>{퍼(여몫임금(a, 최신))} ({만(임('여자', a, 최신))})</td>
            <td>{부호(여몫비정(a, 최신) - 여몫임금(a, 최신))}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">괄호는 여자 사람 수입니다. 차이는 앞 칸에서 뒤 칸을 뺀 값입니다.</p>

  <h2>{연(처음)}년 8월과 비교</h2>
  <div class="tablewrap">
    <table>
      <thead>
        <tr>
          <th>나이대</th>
          <th>비정규직 중 여자 {연(처음)}년</th>
          <th>{연(최신)}년</th>
          <th>변화</th>
        </tr>
      </thead>
      <tbody>
        {['계', ...연령].map((a) => (
          <tr>
            <td>{이름(a)}</td>
            <td>{퍼(여몫비정(a, 처음))}</td>
            <td><strong>{퍼(여몫비정(a, 최신))}</strong></td>
            <td>{부호(여몫비정(a, 최신) - 여몫비정(a, 처음))}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>같은 표에서 읽히는 것</h2>
  <ul>
    <li>{연(최신)}년 8월 비정규직 가운데 여자 몫은 60세 이상에서 {퍼(십오)}, 30~39세에서 {퍼(여몫비정('30-39세', 최신))}, 20~29세에서 {퍼(여몫비정('20-29세', 최신))}입니다.</li>
    <li>임금근로자 가운데 여자 몫이 가장 낮은 나이대는 {(() => { const l = [...연령].sort((x, y) => 여몫임금(x, 최신) - 여몫임금(y, 최신))[0]; return `${이름(l)}(${퍼(여몫임금(l, 최신))})`; })()}입니다.</li>
    <li>여자 비정규직은 {연(처음)}년 {만(비정('여자', '계', 처음))}에서 {연(최신)}년 {만(비정('여자', '계', 최신))}으로, 남자 비정규직은 {만(비정('남자', '계', 처음))}에서 {만(비정('남자', '계', 최신))}으로 변했습니다.</li>
  </ul>

  <h2>⚠ 이 자료로 말할 수 없는 것</h2>
  <ul>
    <li>매년 다른 표본을 조사한 값입니다. 같은 사람을 따라간 것이 아닙니다.</li>
    <li>여자 몫이 큰 이유(일의 종류, 근무 시간, 선택 여부)는 이 표에 없습니다.</li>
    <li>비정규직은 통계청 분류(한시적·시간제·비전형 근로자)이며, 임금이나 일자리의 질을 직접 재는 값이 아닙니다.</li>
    <li>임금근로자만 조사 대상입니다. 자영업자는 들어 있지 않습니다.</li>
    <li>15~19세는 표본이 작아 매년 값이 크게 움직일 수 있습니다.</li>
    <li>나이대 안에서 비정규직으로 일하는 여자의 비율(비정규직 비중)은 <a href="/irregular-share-by-age">비정규직 비중 페이지</a>에 있습니다. 이 쪽 값은 비정규직 사람들 안에서의 여자 몫이라 다른 값입니다.</li>
  </ul>

  <p class="note">
    출처 — {자료.출처.이름}, 표 {자료.출처.표}. 기준 {월들.map(연).join('·')}년 8월. 주소 <a href={자료.출처.주소} rel="noopener">{자료.출처.주소}</a>. 만든날 {자료.만든날}. 이용허락범위: {자료.출처.이용허락범위}.
  </p>

  <p class="note">
    <a href="/wage-worker-age-mix">← 임금근로자의 나이 구성</a>
    <br />
    <a href="/participation-by-age-sex">→ 나이·성별 경제활동참가율</a>
  </p>

  <HundredAgeWalk 키="irregular-women-share-by-age" />
  <NextQuestionBrief 모은것="경제활동인구조사 비정규직 안의 여자 몫" />
</HundredYear>
