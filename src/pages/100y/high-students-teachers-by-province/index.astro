---
/**
 * /100y/high-students-teachers-by-province — 고등학교 학생·학급·수업교원 합계와 학급당·교원 1명당 학생, 시도별 (2024 공시)
 *
 * 출처  학교알리미 2024 공시 「학년별·학급별 학생수」 + NEIS 지역 — src/lib/high-school-province.ts 가 학교 코드로 잇는다.
 *       이 쪽에서 한 일은 시도로 더하고 나눈 것뿐이다. 초·중은 /elementary-teacher-ratio-by-province, /middle-teacher-ratio-by-province 가 있다.
 * 같은 소재의 /high-teacher-ratio-spread-by-province 는 10명 이하·14명 이상 «학교 수»를 센다. 이 페이지는 «시도 전체를 더한 값»이다.
 * ⛔ 「수업교원」을 「교원 수」라 쓰지 않는다. 공표 교원수와 세는 범위가 다르다.
 * ⛔ 「적을수록 좋다」 같은 판단과 원인 추측을 쓰지 않는다. 수만 적는다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import HundredAgeWalk from '../../../components/HundredAgeWalk.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import { 값있는, 못이은, 합, 묶기, 소수1, 수 } from '../../../lib/high-school-students';

const 교원있는 = 값있는.filter((r) => r.교원 !== null && (r.교원 as number) > 0);
const 줄 = (이름: string, a: typeof 값있는) => {
  const 학생 = 합(a, (r) => r.학생);
  const 학급 = 합(a, (r) => r.학급);
  const b = a.filter((r) => r.교원 !== null && (r.교원 as number) > 0);
  const 교원 = 합(b, (r) => r.교원);
  const 교원학생 = 합(b, (r) => r.학생);
  return { 이름, 곳: a.length, 학생, 학급, 교원, 학급당: 학급 ? 학생 / 학급 : 0, 교원당: 교원 ? 교원학생 / 교원 : 0 };
};
const 시도들 = [...묶기(값있는, (r) => r.시도).entries()].filter(([k]) => k).map(([k, a]) => 줄(k, a)).sort((a, b) => b.학급당 - a.학급당);
const 전체 = 줄('전체', 값있는);
const 교원빠진 = 값있는.length - 교원있는.length;
const 학급맨위 = 시도들[0];
const 학급둘째 = 시도들[1];
const 학급맨아래 = 시도들[시도들.length - 1];
const 교원순 = [...시도들].sort((a, b) => b.교원당 - a.교원당);
const 교원맨위 = 교원순[0];
const 교원맨아래 = 교원순[교원순.length - 1];
const 학생많은 = [...시도들].sort((a, b) => b.학생 - a.학생)[0];

const TITLE = `고등학교 학급당 학생 ${소수1(전체.학급당)}명, 수업교원 1명당 ${소수1(전체.교원당)}명 — 시도별로 학급당 ${학급맨위.이름} ${소수1(학급맨위.학급당)}명, ${학급맨아래.이름} ${소수1(학급맨아래.학급당)}명`;
const desc = `학교알리미 2024 공시로 고등학교 ${수(전체.곳)}곳의 학생 ${수(전체.학생)}명, 학급 ${수(전체.학급)}개, 수업교원 ${수(전체.교원)}명을 시도별로 더했습니다. 학급당 학생이 가장 많은 시도는 ${학급맨위.이름} ${소수1(학급맨위.학급당)}명, 수업교원 1명당 학생이 가장 많은 시도는 ${교원맨위.이름} ${소수1(교원맨위.교원당)}명입니다.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: '고등학교 학생·학급·수업교원 — 시도별',
    description: desc,
    creator: { '@type': 'Organization', name: '백년지도' },
    sourceOrganization: { '@type': 'Organization', name: '학교알리미(한국교육학술정보원)' },
    spatialCoverage: '대한민국 시·도',
    variableMeasured: ['고등학교 학생 수', '학급 수', '수업교원 수', '학급당 학생 수', '수업교원 1명당 학생 수'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '고등학교 학급당 학생 수는 전국에서 몇 명인가요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `학교알리미 2024 공시 기준 고등학교 ${수(전체.곳)}곳의 학생 ${수(전체.학생)}명을 학급 ${수(전체.학급)}개로 나누면 학급당 ${소수1(전체.학급당)}명입니다. 수업교원 1명당 학생은 ${소수1(전체.교원당)}명입니다.`,
        },
      },
      {
        '@type': 'Question',
        name: '학급당 학생이 가장 많은 시도는 어디인가요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `${시도들.slice(0, 3).map((x) => `${x.이름} ${소수1(x.학급당)}명`).join(', ')} 순입니다. 가장 적은 시도는 ${학급맨아래.이름} ${소수1(학급맨아래.학급당)}명입니다.`,
        },
      },
    ],
  },
];
---

<HundredYear title={TITLE} description={desc} jsonLd={jsonLd}>
  <h1>고등학교 학생과 학급, 수업교원은<br class="pcbr" /> 시도마다 얼마나 될까요</h1>
  <p class="sub">
    학교알리미 2024 공시의 학생·학급·수업교원 수를 시도별로 더하고, 학급당 학생과 수업교원 1명당 학생을 나눴습니다. 초등·중학교는 따로 있고 이 페이지는 고등학교입니다.
  </p>

  <div class="answer">
    <p class="answer-label">고등학교 {수(전체.곳)}곳 — 학급당 학생 · 수업교원 1명당 학생</p>
    <p class="answer-num">{소수1(전체.학급당)}명 · {소수1(전체.교원당)}명</p>
    <p class="answer-sub">학생 {수(전체.학생)}명 · 학급 {수(전체.학급)}개 · 수업교원 {수(전체.교원)}명</p>
  </div>

  <h2>시도별 학생·학급·수업교원</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>시·도</th><th>학교</th><th>학생</th><th>학급</th><th>수업교원</th><th>학급당 학생</th><th>수업교원 1명당 학생</th></tr></thead>
      <tbody>
        {시도들.map((x) => (
          <tr>
            <th>{x.이름}</th>
            <td class="num">{수(x.곳)}곳</td>
            <td class="num">{수(x.학생)}명</td>
            <td class="num">{수(x.학급)}개</td>
            <td class="num">{수(x.교원)}명</td>
            <td class="num"><strong>{소수1(x.학급당)}명</strong></td>
            <td class="num"><strong>{소수1(x.교원당)}명</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">표는 학급당 학생이 많은 순입니다. 전남과 광주는 NEIS의 지역 구분대로 따로 셌습니다. 수업교원 1명당 학생은 수업교원 값이 있는 학교만으로 계산했습니다.</p>

  <h2>같은 표에서 읽히는 것</h2>
  <ul>
    <li>학급당 학생이 가장 많은 시도는 {학급맨위.이름} {소수1(학급맨위.학급당)}명, 두 번째는 {학급둘째.이름} {소수1(학급둘째.학급당)}명입니다. 가장 적은 시도는 {학급맨아래.이름} {소수1(학급맨아래.학급당)}명입니다.</li>
    <li>수업교원 1명당 학생이 가장 많은 시도는 {교원맨위.이름} {소수1(교원맨위.교원당)}명, 가장 적은 시도는 {교원맨아래.이름} {소수1(교원맨아래.교원당)}명입니다.</li>
    <li>학생 수가 가장 많은 시도는 {학생많은.이름} {수(학생많은.학생)}명입니다.</li>
  </ul>

  <h2>⚠ 이 자료로 말할 수 없는 것</h2>
  <ul>
    <li>학교알리미 2024 공시의 학생·학급·수업교원 수입니다. 학교 코드로 잇지 못했거나 학생 수가 0으로 온 {수(못이은)}곳은 뺐습니다.{교원빠진 > 0 ? ` 수업교원 값이 없는 ${수(교원빠진)}곳은 수업교원 1명당 학생 계산에서 뺐습니다.` : ''}</li>
    <li>수업교원은 공표 통계의 교원 수와 세는 범위가 다릅니다. 교장·교감·보건·상담 등은 들어 있지 않습니다.</li>
    <li>학급당 학생과 수업교원 1명당 학생은 시도 전체를 더해 나눈 값이라, 한 학교나 한 반이 겪는 값과 다를 수 있습니다.</li>
    <li>수업의 질이나 학업 결과는 이 자료에 없습니다.</li>
  </ul>

  <p class="note">
    출처 — 학교알리미(한국교육학술정보원) 공개용데이터 「학년별·학급별 학생수」 2024 공시(공공누리 제1유형), NEIS 교육정보 개방 포털 학교기본정보 고등학교.
  </p>

  <p class="note">
    <a href="/high-teacher-ratio-spread-by-province">← 수업교원 1명당 학생 10명 이하·14명 이상 학교, 시도별</a>
    <br />
    <a href="/middle-teacher-ratio-by-province">→ 중학교 수업교원 1명당 학생, 시도별</a>
  </p>

  <HundredAgeWalk 키="high-students-teachers-by-province" />
  <NextQuestionBrief 모은것="학교알리미 고등학교 학생·학급·수업교원 수를 시도별로 더한 실측" />
</HundredYear>

<style>
  .num { text-align: right; font-variant-numeric: tabular-nums; }
</style>
