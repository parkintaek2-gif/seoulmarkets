---
/**
 * /100y/high-class-size-spread-by-province — 학급당 학생 28명 이상·20명 미만 고등학교, 시도별·시군구별 (2024 공시)
 *
 * 출처  학교알리미 공개용데이터 「학년별·학급별 학생수」 2024 공시 — src/data/100yearmap/school-class-size.json (학교별 학급당 학생 수)
 *       NEIS 학교기본정보로 시도·시군구를 붙였다. 이 쪽에서 한 일은 학교 수를 센 것뿐이다.
 * 같은 소재의 /class-size-by-area 는 시군구별 «평균»이다. 이 페이지은 «학교 수»를 센다 — 평균이 같아도 학교마다 갈리는 모양이 다를 수 있다.
 * ⛔ 「과밀학급」이라는 말을 쓰지 않는다. 공시는 학교 평균이라 반 하나하나는 모른다. 28명·20명은 이 페이지가 정한 선이다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import HundredAgeWalk from '../../../components/HundredAgeWalk.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import { 고교들, 공시표출처, 받은때, 수, 퍼글, 중앙, 시도로, 구로 } from '../../../lib/high-school-province';

const 큰선 = 28;
const 작은선 = 20;
const 학교들 = 고교들.filter((r) => r.학급당 != null);
const 못이은 = 고교들.length - 학교들.length;
const 큰가 = (r: any) => r.학급당 >= 큰선;
const 작은가 = (r: any) => r.학급당 < 작은선;
const 큰수 = 학교들.filter(큰가).length;
const 작은수 = 학교들.filter(작은가).length;
const 가운데 = 중앙(학교들.map((r) => r.학급당))!;

const 시도들 = 시도로(학교들, 큰가).map((x) => {
  const 해당 = 학교들.filter((r) => r.시도 === x.이름);
  return { ...x, 큰곳: x.센곳, 작은곳: 해당.filter(작은가).length, 가운데: 중앙(해당.map((r) => r.학급당))! };
});
const 구큰 = 구로(학교들, 큰가, 5);
const 곳들 = 구큰.올린곳;
const 높은쪽 = 곳들.slice(0, 15);
const 큰곳없는곳 = 곳들.filter((r) => r.센곳 === 0).length;
const 맨위 = 시도들[0];
const 둘째 = 시도들[1];
const 맨아래 = 시도들[시도들.length - 1];
const 큰많은시도 = [...시도들].sort((a, b) => b.큰곳 - a.큰곳)[0];
const 작은률맨위 = [...시도들].sort((a, b) => b.작은곳 / b.곳 - a.작은곳 / a.곳)[0];
const 높은쪽경기 = 높은쪽.filter((r) => r.시도 === '경기도').length;
const 구간 = [['20명 미만', 0, 19.99], ['20~24.9명', 20, 24.99], ['25~27.9명', 25, 27.99], ['28~29.9명', 28, 29.99], ['30명 이상', 30, 999]];
const 구간수 = 구간.map(([이름, 낮, 높]: any) => ({ 이름, n: 학교들.filter((r) => r.학급당 >= 낮 && r.학급당 <= 높).length }));
const 유형 = ['일반고', '특성화고', '자율고', '특목고'].map((g) => {
  const 해당 = 학교들.filter((r) => r.유형 === g);
  return { 이름: g, 곳: 해당.length, 큰: 해당.filter(큰가).length, 작은: 해당.filter(작은가).length, 가운데: 중앙(해당.map((r) => r.학급당)) };
});

const TITLE = `학급당 학생 ${큰선}명 이상 고등학교 ${수(큰수)}곳(${퍼글(큰수, 학교들.length)}), ${작은선}명 미만 ${수(작은수)}곳 — 시도별 ${큰선}명 이상 비중은 ${맨위.이름} ${퍼글(맨위.큰곳, 맨위.곳)}, ${둘째.이름} ${퍼글(둘째.큰곳, 둘째.곳)}`;
const desc =
  `학교알리미 ${공시표출처.공시연도}년 공시를 이은 고등학교 ${수(학교들.length)}곳 가운데 학급당 학생 수가 ${큰선}명 이상인 학교는 ${수(큰수)}곳, ${작은선}명 미만인 학교는 ${수(작은수)}곳입니다. ` +
  `${큰선}명 이상 비중이 가장 높은 시도는 ${맨위.이름} ${퍼글(맨위.큰곳, 맨위.곳)}, 가장 낮은 시도는 ${맨아래.이름} ${퍼글(맨아래.큰곳, 맨아래.곳)}입니다. 학교별 학급당 학생 수 가운데값은 ${가운데.toFixed(1)}명입니다.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: `학급당 학생 ${큰선}명 이상·${작은선}명 미만 고등학교 수 — 시도·시군구별`,
    description: desc,
    dateModified: 받은때,
    creator: { '@type': 'Organization', name: '백년지도' },
    sourceOrganization: { '@type': 'Organization', name: 공시표출처.이름 },
    spatialCoverage: '대한민국 시·도, 시·군·구',
    variableMeasured: ['고등학교 수', '학급당 학생 수', `학급당 학생 ${큰선}명 이상 학교 수`],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: `학급당 학생이 ${큰선}명 이상인 고등학교는 몇 곳인가요?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `학교알리미 ${공시표출처.공시연도}년 공시를 이은 고등학교 ${수(학교들.length)}곳 가운데 ${수(큰수)}곳(${퍼글(큰수, 학교들.length)})입니다. 개수가 가장 많은 시도는 ${큰많은시도.이름}으로 ${수(큰많은시도.큰곳)}곳입니다.`,
        },
      },
      {
        '@type': 'Question',
        name: '고등학교 학급당 학생 수는 학교마다 얼마나 다른가요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `학교별 가운데값은 ${가운데.toFixed(1)}명이고, ${작은선}명 미만인 학교가 ${수(작은수)}곳, ${큰선}명 이상인 학교가 ${수(큰수)}곳입니다.`,
        },
      },
    ],
  },
];
---

<HundredYear title={TITLE} description={desc} jsonLd={jsonLd}>
  <h1>학급당 학생이 28명 넘는 고등학교는<br class="pcbr" /> 어느 시도에 얼마나 있나요</h1>
  <p class="sub">
    학교알리미가 공개한 {공시표출처.공시연도}년 공시에서 고등학교 {수(학교들.length)}곳의 학급당 학생 수를 학교별로 보고, {큰선}명 이상인 학교와 {작은선}명 미만인 학교를 시도와 시군구로 셌습니다.
  </p>

  <div class="answer">
    <p class="answer-label">학급당 학생 {큰선}명 이상 고등학교 — 공시를 이은 {수(학교들.length)}곳 가운데</p>
    <p class="answer-num">{수(큰수)}곳 · {퍼글(큰수, 학교들.length)}</p>
    <p class="answer-sub">{작은선}명 미만 {수(작은수)}곳({퍼글(작은수, 학교들.length)}) · 학교별 학급당 학생 수 가운데값 {가운데.toFixed(1)}명</p>
  </div>

  <p>
    ⚠ <strong>{큰선}명과 {작은선}명은 이 페이지에서 정한 기준입니다.</strong> 법이나 공표 통계의 구분이 아닙니다. 그리고 공시는 학교마다 학생 수와 학급 수만 내므로, 이것은 «학교의 반 평균»입니다. 반 하나하나가 몇 명인지는 모릅니다.
  </p>

  <h2>시도별 학급당 학생 {큰선}명 이상·{작은선}명 미만 고등학교</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>시·도</th><th>고등학교</th><th>{큰선}명 이상</th><th>비중</th><th>{작은선}명 미만</th><th>학교별 가운데값</th></tr></thead>
      <tbody>
        {시도들.map((x) => (
          <tr>
            <th>{x.이름}</th>
            <td class="num">{수(x.곳)}곳</td>
            <td class="num">{수(x.큰곳)}곳</td>
            <td class="num"><strong>{퍼글(x.큰곳, x.곳)}</strong></td>
            <td class="num">{수(x.작은곳)}곳 · {퍼글(x.작은곳, x.곳)}</td>
            <td class="num">{x.가운데.toFixed(1)}명</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">비중은 {큰선}명 이상 학교가 그 시도의 공시를 이은 고등학교에서 차지하는 몫이고, 표는 이 비중이 높은 순입니다. 전남과 광주는 NEIS의 지역 구분대로 따로 셌습니다.</p>

  <h2>{큰선}명 이상 비중이 높은 시군구 15곳</h2>
  <p class="note">고등학교가 5곳 이상인 시군구 {곳들.length}곳 가운데입니다. 그보다 적은 {구큰.빠진곳}곳은 표에서 뺐습니다. {큰선}명 이상 학교가 한 곳도 없는 시군구는 {수(큰곳없는곳)}곳입니다. 15곳 가운데 경기도는 {높은쪽경기}곳입니다.</p>
  <div class="tablewrap">
    <table>
      <thead><tr><th>지역</th><th>고등학교</th><th>{큰선}명 이상</th><th>비중</th></tr></thead>
      <tbody>
        {높은쪽.map((r) => (
          <tr>
            <th>{r.시도} {r.구}</th>
            <td class="num">{r.곳}곳</td>
            <td class="num">{r.센곳}곳</td>
            <td class="num"><strong>{퍼글(r.센곳, r.곳)}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>학급당 학생 수 구간별 고등학교</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>학급당 학생 수</th><th>학교</th><th>몫</th></tr></thead>
      <tbody>
        {구간수.map((x) => (
          <tr>
            <th>{x.이름}</th>
            <td class="num">{수(x.n)}곳</td>
            <td class="num">{퍼글(x.n, 학교들.length)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>고등학교 종류별로 보면</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>종류</th><th>학교</th><th>{큰선}명 이상</th><th>{작은선}명 미만</th><th>가운데값</th></tr></thead>
      <tbody>
        {유형.map((x) => (
          <tr>
            <th>{x.이름}</th>
            <td class="num">{수(x.곳)}곳</td>
            <td class="num">{수(x.큰)}곳 · {퍼글(x.큰, x.곳)}</td>
            <td class="num">{수(x.작은)}곳 · {퍼글(x.작은, x.곳)}</td>
            <td class="num">{x.가운데 == null ? '—' : `${x.가운데.toFixed(1)}명`}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">종류는 NEIS 학교기본정보의 고교유형 칸입니다.</p>

  <h2>같은 표에서 읽히는 것</h2>
  <ul>
    <li>{큰선}명 이상 비중이 가장 높은 시도는 {맨위.이름} {퍼글(맨위.큰곳, 맨위.곳)}({수(맨위.큰곳)}곳), 두 번째는 {둘째.이름} {퍼글(둘째.큰곳, 둘째.곳)}입니다. 가장 낮은 시도는 {맨아래.이름} {퍼글(맨아래.큰곳, 맨아래.곳)}입니다.</li>
    <li>개수로는 {큰많은시도.이름}이 {큰선}명 이상 학교 {수(큰많은시도.큰곳)}곳으로 가장 많습니다.</li>
    <li>{작은선}명 미만 학교의 비중이 가장 높은 시도는 {작은률맨위.이름} {퍼글(작은률맨위.작은곳, 작은률맨위.곳)}입니다.</li>
    <li>시도별 학교 가운데값은 {Math.min(...시도들.map((x) => x.가운데)).toFixed(1)}명부터 {Math.max(...시도들.map((x) => x.가운데)).toFixed(1)}명까지입니다.</li>
  </ul>

  <h2>⚠ 이 자료로 말할 수 없는 것</h2>
  <ul>
    <li>학교알리미 공시를 이은 고등학교는 {수(학교들.length)}곳이고, NEIS 학교 목록 {수(고교들.length)}곳 가운데 {수(못이은)}곳은 이어지지 않아 빠졌습니다. 이 {수(못이은)}곳의 값은 모르고, 0으로 채우지 않았습니다.</li>
    <li>학생 수가 0명으로 공시된 곳은 뺐습니다.</li>
    <li>학급당 학생 수는 학교 단위 평균입니다. 학년마다, 반마다 다른 값은 이 표에 없습니다.</li>
    <li>수업의 질이나 학생이 느끼는 환경은 이 숫자로 알 수 없습니다.</li>
    <li>학생이 사는 곳이 아니라 학교가 있는 곳으로 셌습니다.</li>
  </ul>

  <p class="note">
    출처 — {공시표출처.이름} 「{공시표출처.공시항목}」 {공시표출처.공시연도}년 공시, 고등학교. 이용허락범위: {공시표출처.이용허락범위}. 받은 날 {받은때}. 학교 목록·주소·고교유형은 NEIS 교육정보 개방 포털 학교기본정보입니다.
  </p>

  <p class="note">
    <a href="/class-size-by-area">← 고등학교 학급당 학생 수 지역별(시군구 평균)</a>
    <br />
    <a href="/class-size-distribution">→ 학급당 학생 수, 학교마다 이렇게 다릅니다</a>
  </p>

  <HundredAgeWalk 키="high-class-size-spread-by-province" />
  <NextQuestionBrief 모은것="학교알리미 고등학교 학급당 학생 수 공시를 학교 수로 시도·시군구별로 센 실측" />
</HundredYear>

<style>
  .num { text-align: right; font-variant-numeric: tabular-nums; }
</style>
