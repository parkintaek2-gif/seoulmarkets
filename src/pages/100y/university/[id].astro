---
/**
 * /100y/university/[id] — 대학 페이지 377장
 *
 * 백년지도의 **두 번째 축**이다. 여태는 고등학교밖에 없었다(대학 페이지 0장).
 * 2026-08-04 대학알리미가 열리면서 생겼다.
 *
 * 화면 순서 — 학과 페이지(P1)와 같은 뼈대
 *   ❶ 한 줄 답      — 「졸업한 100명 중 60명이 취업했습니다」
 *   ❷ 숫자 넷       — 취업률 · 중도탈락률 · 재학생충원율 · 전임교원확보율
 *   ❸ 해석 한 문단   — 규칙이 만든 문장. LLM 이 쓰지 않는다
 *   ❹ 이 숫자는 어디서 왔나 (접어서)
 *   ❺ 다음 걸음
 *
 * ⭐ **첫 숫자는 취업률이다.** 중도탈락이 아니다.
 *   백년지도가 답하기로 한 질문은 「그 길로 가면 **졸업하고 나서** 어떻게 되나」다.
 *   중도탈락은 「들어가서 어떻게 되나」라 그 다음이다.
 *
 * ⛔ 「몇 위」·「상위 몇 %」를 쓰지 않는다. 그게 줄세우기다.
 *    쓰는 것은 **전국 평균과의 차이**뿐이다 — 등수가 아니라 위치다.
 *
 * ⛔ 「좋은 학교/나쁜 학교」로 읽히게 쓰지 않는다.
 *    중도탈락에는 편입·반수·전공변경이 다 섞여 있다. 그 말을 ❸에 반드시 붙인다.
 *    취업률도 마찬가지다 — 대학원에 간 사람은 취업자에 들어가지 않는다.
 *
 * ⭐ 평균은 **공시가 발표한 값**(`indctAvg`)이다. 우리가 계산하지 않았다.
 *    처음엔 우리가 중앙값을 냈었는데, 공식 평균이 있는 걸 알고 전부 바꿨다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import { 퍼센트 } from '../../../lib/number-format';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import { href, lastSegment } from '../../../lib/hundredyear';
import { 수치있음, 캠퍼스인가, 본교찾기, 권할만한, 폐교정보, 폐교출처 } from '../../../lib/university';
import { 대학연구, 전체편수 } from '../../../lib/research';
import { 조사 } from '../../../lib/josa';
import universities from '../../../data/100yearmap/pages-university.json';

/** ⚠ 페이지마다 다시 고르면 377번 돈다. 모듈 최상위에서 한 번만 고른다 */
const 관련연구 = 대학연구();

export async function getStaticPaths() {
  return (universities as any[]).map((u) => ({
    params: { id: lastSegment(u.url) },
    props: { uni: u },
  }));
}

const { uni } = Astro.props as { uni: any };

/** 같은 지역 · 같은 종류 학교 — ❺ 다음 걸음. 가나다순(등수가 아니다)
 *  ⚠ 2026-08-05 — **수치가 하나도 없는 학교를 여기서 뺐다.**
 *    강원 지역 대학교 13곳 중 5곳이 그랬다(캠퍼스 4 + 한중대학교).
 *    누르면 텅 빈 페이지가 나온다 — 없는 선택지를 학부모에게 내밀고 있었다.
 *  ⛔ 페이지를 지운 것이 아니다. **우리 쪽에서 먼저 권하지 않을 뿐**이다. */
const 이웃 = 권할만한(
  (universities as any[]).filter(
    (u) => u.schlId !== uni.schlId && u.지역 === uni.지역 && u.종류 === uni.종류,
  ),
)
  .sort((a, b) => a.표시명.localeCompare(b.표시명, 'ko'))
  .slice(0, 12);

/** 이 페이지에 보여 줄 수치가 하나라도 있나 · 캠퍼스면 본교는 어디인가 */
const 값있음 = 수치있음(uni);
const 캠퍼스 = 캠퍼스인가(uni);
const 본교 = 본교찾기(uni, universities as any[]);
/** 🔴 문을 닫은 학교인가. 있으면 **그 사실을 페이지 맨 위에** 말한다 */
const 폐교 = 폐교정보(uni);

const 취 = uni.취업률;
const 탈 = uni.중도탈락률;

/** 「평균보다 2.7%p 낮습니다」 — 등수가 아니라 기준선에서 얼마나 떨어져 있나 */
/**
 * 🔴 **반올림이 비교를 뒤집던 것을 고쳤다** (2026-08-06 · 사장님이 직접 잡으신 것 · 8곳)
 *
 * 우리는 「100명 가운데 **63명**이 취업했습니다」라고 **사람 수로 반올림해** 말해 놓고,
 * 바로 옆에서 「전국 평균 **62.8%**보다 낮습니다」라고 했다. 읽는 사람에게는 이렇게 보인다.
 *
 *     63명인데  62.8보다 낮다?      ← 63 > 62.8 이다. 말이 스스로 어긋난다
 *
 * 경기대 62.7%(→63명) vs 전국 62.8%. 329곳 중 여덟 곳이 그랬다.
 *
 * ⭐ **고치는 자리는 비교가 아니라 「본문 숫자」다.**
 *
 *     ⛔ 「100명 가운데 63명」은 친절하지만 **바로 옆에 소수점 비교가 오면 못 쓴다**
 *     ✅ 본문과 비교를 **같은 자리수로** — 「62.7%입니다. 전국 평균 62.8%보다 0.1%p 낮습니다」
 *
 *   두 숫자가 한 문단에 나란히 서면 독자가 **계산한다.** 자리수가 다르면 계산이 안 맞는다.
 *   자리수를 맞추면 어긋날 수가 없다 — **문턱으로 가리는 것이 아니라 원인을 없앤다.**
 *
 * ⚠ 「몇 명」을 아예 버리지는 않는다. 실제 수(2,345명 중 1,470명)를 뒤에 그대로 붙인다.
 *   버리는 것은 **비교 옆에 선 반올림값 하나**뿐이다.
 * ⚠ 이 규칙은 `scripts/check-100yearmap-launch.mjs` 가 **만들어진 페이지를 읽어** 지킨다.
 *   자료가 갱신돼도 다시 잡힌다.
 */
/**
 * 🔴 **나눌 사람이 0명인 학교** — 이 검사를 만들다 딸려 나왔다 (2026-08-06 · 10곳)
 *
 *   광주가톨릭대  취업대상자 **0명** · 취업자 0명  →  페이지는 이렇게 말하고 있었다
 *   「0%가 취업했습니다. 전국 평균 62.8%보다 **62.8%p 낮습니다**」
 *
 * 0/0 이다. **비율이 아예 만들어지지 않는 것**을 「전국 꼴찌」로 내보내고 있었다.
 * 신학대·가톨릭대·승가대 아홉 곳과 한국에너지공대(2022년 개교)다.
 * 학부모가 이 페이지를 보면 「이 학교는 취업이 0이구나」로 읽는다. **사실과 정반대다.**
 *
 * ⚠ 학교마다 이유가 다르므로(성직자 양성 / 아직 졸업생이 없음) **이유는 단정하지 않는다.**
 *   우리가 아는 사실은 하나뿐이다 — **셀 대상이 0명이었다.**
 */
const 셀대상없음 = uni.취업대상자 === 0;

/**
 * 🔴 **「전국 평균」이 하나가 아니다** (2026-08-16 · 3번이 자료를 재서 찾음)
 *
 * 다섯 지표 **전부** 평균이 구분마다 따로다. 재 보면 이렇다 —
 *
 *     취업률         대학 62.8 / 전문대학 72.1
 *     중도탈락률      대학  5.5 / 전문대학  9.0
 *     전임교원확보율   대학 89.6 / 전문대학 62.8   ← 27%p 나 벌어진다
 *
 * 그런데 페이지는 그냥 「전국 평균」이라고만 했다. 전문대 학생은 72.1% 와 견주고 있는데
 * 옆 학교 페이지의 62.8% 를 같은 「전국 평균」으로 읽으면 **없는 격차가 보인다.**
 * ⇒ 어느 무리의 평균인지 **문장 안에서** 밝힌다.
 *
 * ⚠ 무리 이름은 **자료에서 잰 것**만 쓴다 — 구분 「대학」에 든 종류는 대학교·교육대학이고,
 *   구분 「전문대학」에 든 종류는 전문대학뿐이다(377곳을 세어 확인).
 *   넘겨짚어 「4년제」라고 쓰지 않는다. 우리가 본 것은 구분 칸과 종류 칸뿐이다.
 */
const 무리이름 = uni.구분 === '전문대학' ? '전문대학' : '대학교·교육대학';

const 견줌 = (d: any) => {
  if (!d || d.차이 == null) return null;
  if (d.차이 === 0) return `${무리이름} 전국 평균(${d.전국평균}%)과 같습니다`;
  return `${무리이름} 전국 평균 ${d.전국평균}%보다 ${Math.abs(d.차이)}%p ${d.차이 > 0 ? '높습니다' : '낮습니다'}`;
};

/** ❸ 해석 — 규칙이 만든다. 숫자가 바뀌면 문장도 같이 바뀐다 */
function 해석문(): string[] {
  /** ⚠ 수치가 없는 경우의 설명은 페이지 위쪽 블록이 이미 한다(캠퍼스인지 아닌지로 갈라서).
   *  여기서 또 쓰면 같은 말이 두 번 나온다. 비워 둔다. */
  if (!취 && !탈) return [];
  const 조각: string[] = [];

  if (취 && 셀대상없음) {
    /* 🔴 나눌 사람이 0명인 학교 — 여기서 「0%」와 「62.8%p 낮습니다」를 내보내면 안 된다 */
    조각.push(
      `${uni.표시명}${조사(uni.표시명, '은는', '는')} 취업률이 나오지 않습니다. 대학정보공시에서 취업할 수 있는 자리에 있던 사람이 0명으로 집계됐기 때문입니다. 나눌 사람이 없으면 비율 자체가 만들어지지 않습니다.`,
    );
    조각.push(
      `⚠ 이것을 「아무도 취업하지 못했다」로 읽으면 안 됩니다. 정반대에 가깝습니다 — 졸업 뒤의 길이 취업통계가 세는 방식과 아예 다른 학교들이 여기 들어갑니다. 학교에 직접 물어보시는 편이 정확합니다.`,
    );
  } else if (취) {
    조각.push(
      `${uni.표시명}${조사(uni.표시명, '을를', '를')} 졸업하고, 취업할 수 있는 자리에 있던 사람 가운데 ${취.값}%가 취업했습니다.` +
        (견줌(취) ? ` ${견줌(취)}.` : '') +
        (uni.취업자 != null && uni.취업대상자 != null
          ? ` 실제 수로는 ${uni.취업대상자.toLocaleString()}명 중 ${uni.취업자.toLocaleString()}명입니다.`
          : ''),
    );
    조각.push(
      `⚠ 나머지를 「놀고 있는 사람」으로 읽으면 안 됩니다 — 대학원에 간 사람, 군에 간 사람, 시험을 준비하는 사람은 애초에 취업대상자에서 빠집니다.`,
    );
  }

  if (탈) {
    조각.push(
      `이 학교에 다니던 학생 가운데 ${탈.값}%가 그 해에 학교를 떠났습니다.` +
        (견줌(탈) ? ` ${견줌(탈)}.` : ''),
    );
    조각.push(
      `다만 이것을 학교의 성적표로 읽으면 안 됩니다 — 자퇴에는 편입, 반수, 재수, 전공을 바꾸려는 결정이 모두 섞여 있습니다. 떠난 사람이 많다는 것은 「나쁜 학교」라는 뜻이 아니라, 들어와 보고 생각이 달라진 사람이 그만큼 있었다는 뜻입니다.`,
    );
  }
  return 조각;
}

const 문단 = 해석문();
/**
 * 🔴 **간판에 찾는 낱말이 없었다** (2026-08-09 10:4x · 2번 실측).
 *   「서일대학교 — 백년지도」 ⛔ 찾는 말은 **「서일대학교 취업률」**이다.
 * ⛔ 취업률을 못 잰 곳(48곳)에는 안 붙인다. 이름만 둔다.
 */
/**
 * 🔴🔴 [2026-11-18 · 5번] **수치를 제목에 올린다.**
 * 묶음별로 한 장이 버는 사람을 재니 쉰 배가 갈렸고, 까닭은 색인이 아니라 경쟁이었다 —
 * 짧은 말은 블로그가 다 먹는다. report(4.83명/장)가 이긴 것은 제목이 «좁아서»다.
 * ⇒ 「강원대학교 취업률」이 아니라 「강원대학교 취업률 68.2%」로 좁힌다.
 *   「취업률 몇 퍼센트」를 치는 사람을 잡는다. 같은 날 college-major 837장에 먼저 넣었다.
 * ⛔ 못 잰 48곳에는 여전히 안 붙인다 — 위 규칙 그대로다.
 * ⛔ 0% 는 넣지 않는다. 사실이어도 아무도 치지 않는 말이고 자리만 먹는다.
 */
const 취값수 = 취 ? Number(취.값) : NaN;
const 제목 = !취
  ? uni.표시명
  : (Number.isFinite(취값수) && 취값수 > 0
    ? `${uni.표시명} 취업률 ${취.값}%`
    : `${uni.표시명} 취업률`);
const desc = 취
  ? `${제목}(${uni.지역} · ${uni.설립} ${uni.종류}) 졸업생 취업률은 ${취.값}%입니다. 전국 평균은 ${취.전국평균}%입니다. ${uni.공시연도}년 대학정보공시 기준입니다.`
  : `${제목}(${uni.지역} · ${uni.설립} ${uni.종류})의 ${uni.공시연도}년 대학정보공시 자료입니다.`;

/** ❷ 숫자 칸 — 값이 있는 것만 넣는다. 빈 칸을 「—」로 채우면 없는 것이 있는 것처럼 보인다 */
const 칸 = [
  /* ⚠ 셀 대상이 0명이면 취업률 칸을 아예 빼 둔다. 「0%」와 「전국 62.8%」가 나란히 서면
     위에서 아무리 설명해도 **눈은 두 숫자만 본다.** 없는 값은 없다고 두는 편이 맞다 */
  { d: 셀대상없음 ? null : 취, k: '취업률' },
  { d: 탈, k: '중도탈락률' },
  { d: uni.재학생충원율, k: '재학생 충원율' },
  { d: uni.전임교원확보율, k: '전임교원 확보율' },
].filter((x) => x.d);

/**
 * ⭐ FAQPage — 6번이 검증한 지렛대. 검색 실측(「우송대 취업률」15노출·자리5.5,
 * 「충북대 취업률」·「한성대 취업률」)이 짚어 준 자리 — 제목과 같은 말을 그대로 묻는다.
 * ⛔ 취업률을 못 잰 곳(셀대상없음 포함)은 FAQ를 안 만든다 — 답할 것이 없다.
 */
/**
 * 🔴 [2026-09-05] 취업률을 못 잰 58곳은 여태 구조화 데이터가 «아예 없었다»(5번 geo-fit 자).
 *   FAQPage 를 못 만드는 곳도 최소한 Article 은 낸다 — school 페이지가 데이터 없어도
 *   HighSchool 한 줄은 내는 것과 같은 이치다. 없는 답을 지어내지 않는다.
 */
const faqJsonLd =
  취 && !셀대상없음
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: `${uni.표시명} 취업률`,
            acceptedAnswer: { '@type': 'Answer', text: 문단[0] },
          },
        ],
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: 제목,
        description: desc,
        inLanguage: 'ko',
        isAccessibleForFree: true,
      };
---

<HundredYear title={제목} description={desc} jsonLd={faqJsonLd}>
  <h1>{제목}</h1>
  <p class="sub">
    {uni.지역} · {uni.설립} {uni.종류}
    {uni.재적학생 != null && <> · 재적학생 {uni.재적학생.toLocaleString()}명</>}
  </p>

  {/* 🔴 **문을 닫은 학교면 그 사실이 제일 먼저다.**
