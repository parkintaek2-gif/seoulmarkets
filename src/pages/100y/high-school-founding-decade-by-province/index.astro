---
/**
 * /100y/high-school-founding-decade-by-province — 고등학교는 언제 문을 열었나, 설립 연대별·시도별
 *
 * 출처  NEIS 교육정보 개방 포털 학교기본정보 — src/data/100yearmap/pages-school.json (고등학교의 설립일).
 *       이 쪽에서 한 일은 설립연을 10년 단위로 세고 시도·시군구로 더한 것뿐이다. 지금 문을 연 학교만 있다.
 * ⛔ 설립일은 NEIS 값이다. 연대별 수를 「그때 학교가 많이 생겼다」의 이유로 풀지 않는다.
 *   문을 닫거나 합쳐진 학교가 빠져 있어 그 시기에 실제로 문을 연 학교 수와 다르다.
 * 같은 소재의 /high-school-age-by-area 는 시군구별 «가운데 설립연»이다. 이 페이지은 연대별 분포와 시도별 몫을 센다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import HundredAgeWalk from '../../../components/HundredAgeWalk.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import { 고교들, 수, 퍼글, 중앙, 시도로, 구로 } from '../../../lib/high-school-province';

const 새선 = 2000;
const 옛선 = 1960;
const 학교들 = 고교들.filter((r) => r.설립연 != null);
const 못센 = 고교들.length - 학교들.length;
const 새가 = (r: any) => r.설립연 >= 새선;
const 옛가 = (r: any) => r.설립연 < 옛선;
const 새수 = 학교들.filter(새가).length;
const 옛수 = 학교들.filter(옛가).length;
const 가운데 = 중앙(학교들.map((r) => r.설립연!))!;
const 가장옛 = [...학교들].sort((a, b) => a.설립연! - b.설립연!)[0];
const 가장새 = [...학교들].sort((a, b) => b.설립연! - a.설립연!)[0];

const 연대들 = (() => {
  const m = new Map<number, number>();
  for (const r of 학교들) {
    const d = r.설립연! < 1900 ? 1880 : Math.floor(r.설립연! / 10) * 10;
    m.set(d, (m.get(d) ?? 0) + 1);
  }
  return [...m.entries()].sort((a, b) => a[0] - b[0]).map(([d, n]) => ({ 이름: d === 1880 ? '1900년 이전' : `${d}년대`, n }));
})();
const 최다연대 = [...연대들].sort((a, b) => b.n - a.n)[0];

const 시도들 = 시도로(학교들, 새가).map((x) => {
  const 해당 = 학교들.filter((r) => r.시도 === x.이름);
  return { ...x, 새곳: x.센곳, 옛곳: 해당.filter(옛가).length, 가운데: 중앙(해당.map((r) => r.설립연!))! };
});
const 구새 = 구로(학교들, 새가, 5);
const 곳들 = 구새.올린곳;
const 높은쪽 = 곳들.slice(0, 15);
const 새없는곳 = 곳들.filter((r) => r.센곳 === 0).length;
const 맨위 = 시도들[0];
const 둘째 = 시도들[1];
const 맨아래 = 시도들[시도들.length - 1];
const 새많은시도 = [...시도들].sort((a, b) => b.새곳 - a.새곳)[0];
const 옛률맨위 = [...시도들].sort((a, b) => b.옛곳 / b.곳 - a.옛곳 / a.곳)[0];
const 유형 = ['일반고', '특성화고', '자율고', '특목고'].map((g) => {
  const 해당 = 학교들.filter((r) => r.유형 === g);
  return { 이름: g, 곳: 해당.length, 새: 해당.filter(새가).length, 옛: 해당.filter(옛가).length, 가운데: 중앙(해당.map((r) => r.설립연!)) };
});

const TITLE = `${새선}년 이후 문 연 고등학교 ${수(새수)}곳(${퍼글(새수, 학교들.length)}), ${옛선}년 전 ${수(옛수)}곳 — 시도별로 ${맨위.이름} ${퍼글(맨위.새곳, 맨위.곳)}, ${둘째.이름} ${퍼글(둘째.새곳, 둘째.곳)}`;
const desc =
  `NEIS 학교기본정보의 설립일로 지금 문을 연 고등학교 ${수(학교들.length)}곳을 셌습니다. ${새선}년 이후에 설립된 학교는 ${수(새수)}곳(${퍼글(새수, 학교들.length)}), ${옛선}년 이전은 ${수(옛수)}곳입니다. ` +
  `${새선}년 이후 설립 비중이 가장 높은 시도는 ${맨위.이름} ${퍼글(맨위.새곳, 맨위.곳)}, 가장 낮은 시도는 ${맨아래.이름} ${퍼글(맨아래.새곳, 맨아래.곳)}입니다. 설립연 가운데값은 ${수(가운데)}년입니다.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: '고등학교 설립 연대별 학교 수 — 시도·시군구별',
    description: desc,
    creator: { '@type': 'Organization', name: '백년지도' },
    sourceOrganization: { '@type': 'Organization', name: 'NEIS 교육정보 개방 포털' },
    spatialCoverage: '대한민국 시·도, 시·군·구',
    variableMeasured: ['고등학교 수', '설립 연대', `${새선}년 이후 설립 학교 수`],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: `${새선}년 이후에 문을 연 고등학교는 몇 곳인가요?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `NEIS 설립일을 센 고등학교 ${수(학교들.length)}곳 가운데 ${수(새수)}곳(${퍼글(새수, 학교들.length)})입니다. 개수가 가장 많은 시도는 ${새많은시도.이름}으로 ${수(새많은시도.새곳)}곳입니다.`,
        },
      },
      {
        '@type': 'Question',
        name: '지금 있는 고등학교는 어느 연대에 가장 많이 문을 열었나요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `${최다연대.이름}에 설립된 학교가 ${수(최다연대.n)}곳으로 가장 많습니다. 설립연 가운데값은 ${수(가운데)}년이고, 가장 오래된 곳은 ${가장옛.이름}(${가장옛.설립연}년)입니다.`,
        },
      },
    ],
  },
];
---

<HundredYear title={TITLE} description={desc} jsonLd={jsonLd}>
  <h1>지금 있는 고등학교는<br class="pcbr" /> 언제, 어느 시도에서 문을 열었나요</h1>
  <p class="sub">
    NEIS 학교기본정보의 설립일로 고등학교 {수(학교들.length)}곳을 10년 단위로 세고, 시도와 시군구로 더했습니다.
  </p>

  <div class="answer">
    <p class="answer-label">{새선}년 이후 문을 연 고등학교 — 설립일이 있는 {수(학교들.length)}곳 가운데</p>
    <p class="answer-num">{수(새수)}곳 · {퍼글(새수, 학교들.length)}</p>
    <p class="answer-sub">{옛선}년 이전 {수(옛수)}곳({퍼글(옛수, 학교들.length)}) · 설립연 가운데값 {수(가운데)}년 · 가장 많은 연대 {최다연대.이름} {수(최다연대.n)}곳</p>
  </div>

  <p>
    ⚠ <strong>{새선}년과 {옛선}년은 이 페이지에서 정한 기준입니다.</strong> 그리고 지금 문을 연 학교만 셉니다. 문을 닫았거나 다른 학교와 합쳐진 학교는 빠져 있어서, 그 시기에 실제로 문을 연 학교 수와는 다릅니다.
  </p>

  <h2>설립 연대별 고등학교</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>설립 연대</th><th>학교</th><th>몫</th></tr></thead>
      <tbody>
        {연대들.map((x) => (
          <tr>
            <th>{x.이름}</th>
            <td class="num">{수(x.n)}곳</td>
            <td class="num">{퍼글(x.n, 학교들.length)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>시도별 {새선}년 이후·{옛선}년 이전 설립 고등학교</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>시·도</th><th>고등학교</th><th>{새선}년 이후</th><th>비중</th><th>{옛선}년 이전</th><th>설립연 가운데값</th></tr></thead>
      <tbody>
        {시도들.map((x) => (
          <tr>
            <th>{x.이름}</th>
            <td class="num">{수(x.곳)}곳</td>
            <td class="num">{수(x.새곳)}곳</td>
            <td class="num"><strong>{퍼글(x.새곳, x.곳)}</strong></td>
            <td class="num">{수(x.옛곳)}곳 · {퍼글(x.옛곳, x.곳)}</td>
            <td class="num">{수(x.가운데)}년</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">표는 {새선}년 이후 설립 비중이 높은 순입니다. 전남과 광주는 NEIS의 지역 구분대로 따로 셌습니다.</p>

  <h2>{새선}년 이후 설립 비중이 높은 시군구 15곳</h2>
  <p class="note">고등학교가 5곳 이상인 시군구 {곳들.length}곳 가운데입니다. 그보다 적은 {구새.빠진곳}곳은 표에서 뺐습니다. {새선}년 이후 설립 학교가 한 곳도 없는 시군구는 {수(새없는곳)}곳입니다.</p>
  <div class="tablewrap">
    <table>
      <thead><tr><th>지역</th><th>고등학교</th><th>{새선}년 이후</th><th>비중</th></tr></thead>
      <tbody>
        {높은쪽.map((r) => (
          <tr>
            <th>{r.시도} {r.구}</th>
            <td class="num">{r.곳}곳</td>
            <td class="num">{r.센곳}곳</td>
            <td class="num"><strong>{퍼글(r.센곳, r.곳)}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>고등학교 종류별로 보면</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>종류</th><th>학교</th><th>{새선}년 이후</th><th>{옛선}년 이전</th><th>설립연 가운데값</th></tr></thead>
      <tbody>
        {유형.map((x) => (
          <tr>
            <th>{x.이름}</th>
            <td class="num">{수(x.곳)}곳</td>
            <td class="num">{수(x.새)}곳 · {퍼글(x.새, x.곳)}</td>
            <td class="num">{수(x.옛)}곳 · {퍼글(x.옛, x.곳)}</td>
            <td class="num">{x.가운데 == null ? '—' : `${수(x.가운데)}년`}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">종류는 NEIS 학교기본정보의 고교유형 칸입니다.</p>

  <h2>같은 표에서 읽히는 것</h2>
  <ul>
    <li>{새선}년 이후 설립 비중이 가장 높은 시도는 {맨위.이름} {퍼글(맨위.새곳, 맨위.곳)}({수(맨위.새곳)}곳), 두 번째는 {둘째.이름} {퍼글(둘째.새곳, 둘째.곳)}입니다. 가장 낮은 시도는 {맨아래.이름} {퍼글(맨아래.새곳, 맨아래.곳)}입니다.</li>
    <li>개수로는 {새많은시도.이름}이 {새선}년 이후 설립 학교 {수(새많은시도.새곳)}곳으로 가장 많습니다.</li>
    <li>{옛선}년 이전 설립 학교의 비중이 가장 높은 시도는 {옛률맨위.이름} {퍼글(옛률맨위.옛곳, 옛률맨위.곳)}입니다.</li>
    <li>NEIS 설립일이 가장 이른 학교는 {가장옛.이름}({가장옛.시도}, {가장옛.설립연}년), 가장 늦은 학교는 {가장새.이름}({가장새.시도}, {가장새.설립연}년)입니다. 학교가 이어져 온 연속성이나 이름을 바꾼 내력은 이 값에 반영되지 않았을 수 있습니다.</li>
  </ul>

  <h2>⚠ 이 자료로 말할 수 없는 것</h2>
  <ul>
    <li>NEIS에 올라 있는, 지금 문을 연 고등학교만 셉니다.{못센 > 0 ? ` 설립일이 비어 있거나 읽지 못한 ${수(못센)}곳은 뺐습니다.` : ''}</li>
    <li>학교가 옮겨 갔거나 이름이 바뀐 경우 설립일을 어느 시점으로 적었는지는 학교마다 다를 수 있고, 이 자료로는 가르지 못했습니다.</li>
    <li>연대별 수가 많고 적은 이유는 이 자료에 없습니다.</li>
    <li>학생 수나 학업 결과는 이 자료에 없습니다.</li>
  </ul>

  <p class="note">
    출처 — NEIS 교육정보 개방 포털 학교기본정보, 고등학교. 2026년 기준, 문을 연 학교만.
  </p>

  <p class="note">
    <a href="/high-school-age-by-area">← 고등학교 나이 지역별(시군구)</a>
    <br />
    <a href="/school-founding-decade-elementary-middle">→ 초등학교·중학교는 언제 문을 열었나</a>
  </p>

  <HundredAgeWalk 키="high-school-founding-decade-by-province" />
  <NextQuestionBrief 모은것="NEIS 고등학교 설립일을 연대·시도·시군구로 센 실측" />
</HundredYear>

<style>
  .num { text-align: right; font-variant-numeric: tabular-nums; }
</style>
