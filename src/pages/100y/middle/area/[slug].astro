---
/**
 * /middle/area/[slug] — **시·군·구 중학교 한 장** (258장)
 *
 * ## 🔴 왜 이 지면이 있나 — 실측으로 정해졌다
 *
 *   [2026-11-17] 백년지도의 묶음별 「한 장이 버는 사람」(28일 · GA4 순방문자)
 *   ```
 *   /report/area/  고등학교 지역 258장   12.16명   ← 지역 이름이 제목에 든 것
 *   그 밖           942장                2.26명
 *   ```
 *   한국어 손님은 거의 전부 네이버에서 온다(백년지도 2,829명 / 3,102명).
 *   우리가 자리를 잡은 질문은 **블로그가 안 다루는 공공데이터 질문**이었다.
 *
 * ## ⭐ 이 지면이 쥔 것 — **남중 · 여중**
 *
 *   초등에는 사실상 없는 축이다. 전국 남중 334곳 · 여중 310곳 · 남녀공학 2,674곳.
 *   「우리 구에 여중이 있나」는 부모가 실제로 묻는 질문이고,
 *   블로그 글보다 **공공데이터가 답하기 좋은** 질문이다.
 *
 *   ⛔ 어느 쪽이 낫다고 쓰지 않는다. **몇 곳인지, 어디인지만 적는다.**
 *      판단은 보는 분이 한다.
 *
 * ## ⛔ 이 지면이 지키는 것
 *
 *   ```
 *   ⛔ 줄 세우지 않는다 — 가나다순. 순서에 뜻이 없게 한다
 *   ⛔ 없는 칸을 0 으로 채우지 않는다 — 중학교는 진학·성취 공시가 처음부터 없다
 *   ⛔ 오래된 것을 「명문」·「전통」으로 읽히게 쓰지 않는다. 햇수는 햇수다
 *   ⛔ `is:global` 을 쓰지 않는다 — `/_astro/*.css` 로 빠져 접두사 아래서 404 가 난다
 *   ```
 *
 * ## 🔴 들어가는 링크를 반드시 둔다
 *
 *   [2026-11-17] 초등 261장이 28일 동안 **순방문자 0명**이었다. 지면이 나쁜 것이
 *   아니라 들어가는 링크가 한 곳뿐이었다. 사이트맵에는 261장이 다 있었는데도
 *   고아였다. **사이트맵에 올리는 것과 수집기가 찾아내는 것은 다른 일이다.**
 *   그래서 이 지면은 내는 날에 고등·초등·지역 목록에서 길을 함께 낸다.
 */
import HundredYear from '../../../../layouts/HundredYear.astro';
import 중등자료 from '../../../../data/100yearmap/middle.json';
import { 슬러그풀기, 열쇠만들기 } from '../../../../lib/school-area';
import { 중등지역목록, 중등지역주소 } from '../../../../lib/middle-area';
import { 같은시다른구, 같은시합계, 시부분 } from '../../../../lib/same-city';

export async function getStaticPaths() {
  /* ⛔ 목록을 이 함수 **안**에서 읽는다. 밖에 두면 Astro 가 이 함수를 모듈 밖으로
     떼어 내 따로 돌리기 때문에 「is not defined」로 빌드가 죽는다.
     🔴 목록을 만드는 자리는 `lib/middle-area.ts` **한 곳**이다 —
        사이트맵이 같은 함수를 부른다. 여기서 따로 만들면 둘이 어긋난다. */
  const 자료 = await import('../../../../data/100yearmap/middle.json');
  const { 중등지역목록 } = await import('../../../../lib/middle-area');
  return 중등지역목록(자료 as any).map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params as { slug: string };
/* ⚠ 「경기도-수원시-장안구」처럼 조각이 셋일 수 있다. split('-')[1] 로 자르면 「수원시」만 남는다 */
const 푼것 = 슬러그풀기(slug)!;
const 시도 = 푼것.시도;
const 구 = 푼것.이름;
const 이동네열쇠 = 열쇠만들기(시도, 구);

const 모든학교 = (중등자료 as any).자료 as any[];
const 모든지역 = (중등자료 as any).지역 as any[];
const 올해 = (중등자료 as any).올해 as number; // 자료가 만들어진 해. ⛔ 오늘 날짜로 다시 세지 않는다

/** ⛔ 가나다순. **무엇으로도 줄 세우지 않는다** */
const 곳들 = 모든학교
  .filter((x) => x.열쇠 === 이동네열쇠)
  .sort((a, b) => String(a.title).localeCompare(String(b.title), 'ko'));

const 이지역 = 모든지역.find((a) => a.열쇠 === 이동네열쇠) ?? null;

/* ── 이 동네를 숫자로 ── */
const 사립곳 = 곳들.filter((x) => x.설립 === '사립');
const 국립곳 = 곳들.filter((x) => x.설립 === '국립');
const 공립곳 = 곳들.filter((x) => x.설립 === '공립');

/* ⭐ 중학교의 주인공 축. ⛔ 「모름」을 공학으로 밀어 넣지 않는다 */
const 남중 = 곳들.filter((x) => x.공학 === '남중');
const 여중 = 곳들.filter((x) => x.공학 === '여중');
const 공학곳 = 곳들.filter((x) => x.공학 === '남녀공학');
const 공학모름 = 곳들.filter((x) => !x.공학);

const 설립연있는곳 = 곳들.filter((x) => Number.isFinite(x.설립연));
const 백년넘은곳 = 설립연있는곳
  .filter((x) => 올해 - x.설립연 >= 100)
  .sort((a, b) => a.설립연 - b.설립연);
const 가장오래된 = 설립연있는곳.length
  ? 설립연있는곳.reduce((p, c) => (c.설립연 < p.설립연 ? c : p))
  : null;
const 가장새로운 = 설립연있는곳.length
  ? 설립연있는곳.reduce((p, c) => (c.설립연 > p.설립연 ? c : p))
  : null;

/** 열 해 단위로 몇 곳이 문을 열었나. ⛔ 줄 세우기가 아니라 **퍼짐**을 보이는 표다 */
const 열해묶음 = (() => {
  const 통: Record<number, number> = {};
  for (const x of 설립연있는곳) {
    const 십 = Math.floor(x.설립연 / 10) * 10;
    통[십] = (통[십] ?? 0) + 1;
  }
  return Object.entries(통)
    .map(([십, 수]) => ({ 십: Number(십), 수 }))
    .sort((a, b) => a.십 - b.십);
})();
const 가장많은십년 = 열해묶음.length
  ? 열해묶음.reduce((p, c) => (c.수 > p.수 ? c : p))
  : null;

/* ── 전국과 견주기 ── */
const 전국곳수 = 모든학교.length;
const 전국백년 = (중등자료 as any).백년넘은곳수 as number;
const 전국남중 = (중등자료 as any).남중수 as number;
const 전국여중 = (중등자료 as any).여중수 as number;
const 전국사립 = 모든학교.filter((x) => x.설립 === '사립').length;
const 전국사립비 = Math.round((전국사립 / 전국곳수) * 1000) / 10;
const 이곳사립비 = 곳들.length ? Math.round((사립곳.length / 곳들.length) * 1000) / 10 : null;

/* ── 같은 시·도의 다른 동네 ── */
/* ⛔ 슬러그를 여기서 다시 만들지 않는다 — lib 가 만든 목록을 그대로 쓴다 */
/* 🔴 [2026-11-18 · 5번] 같은 시의 다른 구. 화성시가 네 장으로 갈려 있는데
   어느 장도 「나머지가 더 있다」를 말하지 않았다. 손님이 적게 읽고 나간다.
   ⚠ 이 목록은 이름 칸이 `구` 다 — lib 가 아는 꼴(`이름`)로 맞춰 넘긴다. */
const 꼴맞춘목록 = 중등지역목록(중등자료 as any)
  .map((a) => ({ slug: a.slug, 이름: a.구, 시도: a.시도, 곳: a.곳 }));
const 나꼴 = { slug, 이름: 구, 시도 };
const 같은시이웃 = 같은시다른구(나꼴, 꼴맞춘목록);
const 같은시곳수 = 같은시합계({ slug, 이름: 구, 시도, 곳: 곳들.length }, 같은시이웃);
const 시부분이름 = 시부분(구);

const 같은시도 = 중등지역목록(중등자료 as any)
  .filter((a) => a.시도 === 시도 && a.열쇠 !== 이동네열쇠)
  .sort((a, b) => String(a.구).localeCompare(String(b.구), 'ko'));

/** 이 동네가 시·도 안에서 **몇 번째로 많은가**가 아니라 **어디쯤인가**를 보인다 */
const 시도안곳수들 = 모든지역.filter((a) => a.시도 === 시도).map((a) => a.곳).sort((x, y) => x - y);
const 시도가운데값 = (() => {
  if (!시도안곳수들.length) return null;
  const m = 시도안곳수들.length >> 1;
  return 시도안곳수들.length % 2
    ? 시도안곳수들[m]
    : Math.round(((시도안곳수들[m - 1] + 시도안곳수들[m]) / 2) * 10) / 10;
})();

/* ⚠ 「— 백년지도」는 레이아웃이 붙인다. 여기서 또 붙이면 두 번 나온다 */
const 제목 = `${시도} ${구} 중학교 ${곳들.length}곳`;

/** 남중·여중을 한 마디로. ⛔ 없으면 「없습니다」라고 적는다 — 빼지 않는다 */
const 갈래말 =
  남중.length || 여중.length
    ? `남중 ${남중.length}곳 · 여중 ${여중.length}곳 · 남녀공학 ${공학곳.length}곳`
    : `${공학곳.length}곳 모두 남녀공학입니다`;

const desc =
  곳들.length > 0
    ? `${시도} ${구} 중학교 ${곳들.length}곳을 한 표에 놓았습니다. ${갈래말}. ` +
      `공립 ${공립곳.length}곳 · 사립 ${사립곳.length}곳` +
      (국립곳.length ? ` · 국립 ${국립곳.length}곳` : '') +
      (가장오래된 ? `, 가장 먼저 문을 연 곳은 ${가장오래된.title} ${가장오래된.설립연}년입니다. ` : '. ') +
      `줄 세우지 않고 가나다순으로 놓았습니다.`
    : `${시도} ${구} 중학교를 한 표에 놓았습니다.`;

/**
 * ⭐ FAQPage — 손님이 실제로 치는 **«동네 이름 + 중학교»**, 그리고
 *   **«동네 이름 + 여중/남중»** 그대로 묻는다.
 *   고등학교 지면에서 이 자리가 네이버 유입을 끌어온 것이 실측으로 확인됐다.
 */
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `${구} 중학교`,
      acceptedAnswer: { '@type': 'Answer', text: desc },
    },
    ...(여중.length
      ? [{
          '@type': 'Question',
          name: `${구} 여자중학교`,
          acceptedAnswer: {
            '@type': 'Answer',
            text: `${구}의 여자중학교는 ${여중.length}곳입니다 — ${여중.map((x) => x.title).join(' · ')}.`,
          },
        }]
      : []),
    ...(남중.length
      ? [{
          '@type': 'Question',
          name: `${구} 남자중학교`,
          acceptedAnswer: {
            '@type': 'Answer',
            text: `${구}의 남자중학교는 ${남중.length}곳입니다 — ${남중.map((x) => x.title).join(' · ')}.`,
          },
        }]
      : []),
    ...(가장오래된
      ? [{
          '@type': 'Question',
          name: `${구}에서 가장 먼저 문을 연 중학교`,
          acceptedAnswer: {
            '@type': 'Answer',
            text:
              `${가장오래된.title}입니다. ${가장오래된.설립연}년 설립으로 기록돼 있습니다. ` +
              `⚠ NEIS 가 준 설립일이라 학교가 스스로 세는 개교기념일과 다를 수 있습니다.`,
          },
        }]
      : []),
  ],
};
---

<HundredYear title={제목} description={desc} noindex={false} jsonLd={faqJsonLd}>
  <p class="note">
    🎁 <strong>무료로 보실 수 있습니다.</strong> {구}의 중학교 {곳들.length}곳을 한 표에
    놓았습니다 — <a href="/region">다른 지역도 보기 →</a>
  </p>

  <h1>{구} 중학교<br class="pcbr" /> {곳들.length}곳, 한 장에</h1>

  <p class="lead">
    {
      곳들.length === 1 ? (
        <>
          이 지역에는 중학교가 <strong>한 곳</strong> 있습니다. 공시에 적힌 것을{' '}
          <strong>그대로</strong> 놓았습니다.
        </>
      ) : (
        <>
          학교 한 곳의 주소는 어디서나 찾을 수 있습니다. 없는 것은{' '}
          <strong>{구}의 {곳들.length}곳을 한 번에 놓고 보는 화면</strong>입니다. 지금은 학교를
          하나씩 검색해 따로따로 읽어야 합니다.
        </>
      )
    }
  </p>

  {/* ⭐ 중학교의 주인공 축. ⛔ 어느 쪽이 낫다고 쓰지 않는다 — 몇 곳인지만 적는다 */}
  {
    (남중.length > 0 || 여중.length > 0) && (
      <p class="note">
        {구}에는 <strong>남자중학교가 {남중.length}곳, 여자중학교가 {여중.length}곳</strong>{' '}
        있습니다. 나머지 {공학곳.length}곳은 남녀공학입니다.
        {여중.length > 0 && <> 여자중학교는 {여중.map((x) => x.title).join(' · ')}입니다.</>}
        {남중.length > 0 && <> 남자중학교는 {남중.map((x) => x.title).join(' · ')}입니다.</>}
        <br />
        전국 중학교 {전국곳수.toLocaleString()}곳 가운데 남중은 {전국남중}곳, 여중은{' '}
        {전국여중}곳입니다. <strong>어느 쪽이 낫다고 말할 수 있는 자료가 아닙니다.</strong>
      </p>
    )
  }
  {
    남중.length === 0 && 여중.length === 0 && 곳들.length > 0 && (
      <p class="note">
        {구}의 중학교 {곳들.length}곳은 <strong>모두 남녀공학</strong>입니다. 전국 중학교{' '}
        {전국곳수.toLocaleString()}곳 가운데 남중은 {전국남중}곳, 여중은 {전국여중}곳으로
        대부분이 남녀공학입니다.
      </p>
    )
  }

  {/* ⭐ 문 연 지 100년이 넘은 학교 — 있는 곳에만 적는다. 없으면 이 줄이 통째로 없다 */}
  {
    백년넘은곳.length > 0 && (
      <p class="note">
        이 가운데 <strong>문 연 지 100년이 넘은 곳이 {백년넘은곳.length}곳</strong>입니다. 제일
        먼저 문을 연 곳은 <strong>{백년넘은곳[0].title} {백년넘은곳[0].설립연}년</strong>입니다.
        전국 중학교 {전국곳수.toLocaleString()}곳 가운데 100년이 넘은 곳은{' '}
        {전국백년.toLocaleString()}곳입니다. ⚠ 설립일은 NEIS 가 준 값이라 학교가 세는
        개교기념일과 다를 수 있습니다.
      </p>
    )
  }

  <h2>{구}를 숫자로</h2>
  <div class="nums">
    <div><strong>{곳들.length}</strong><span>중학교</span></div>
    {남중.length > 0 && <div><strong>{남중.length}</strong><span>남중</span></div>}
    {여중.length > 0 && <div><strong>{여중.length}</strong><span>여중</span></div>}
    <div><strong>{공학곳.length}</strong><span>남녀공학</span></div>
    <div><strong>{공립곳.length}</strong><span>공립</span></div>
    <div><strong>{사립곳.length}</strong><span>사립</span></div>
    {국립곳.length > 0 && <div><strong>{국립곳.length}</strong><span>국립</span></div>}
    {백년넘은곳.length > 0 && <div><strong>{백년넘은곳.length}</strong><span>100년 넘음</span></div>}
  </div>

  {
    이곳사립비 != null && (
      <p class="note">
        {구}는 {곳들.length}곳 가운데 사립이 {사립곳.length}곳({이곳사립비}%)입니다. 전국은{' '}
        {전국곳수.toLocaleString()}곳 가운데 {전국사립.toLocaleString()}곳({전국사립비}%)입니다.
        <strong> 많고 적음에 좋고 나쁨은 없습니다.</strong> 사립이 많은 곳은 대개 도시가 오래
        자리 잡은 곳입니다.
      </p>
    )
  }

  <h2>{곳들.length}곳을 한 번에</h2>
  <p class="note">
    ⛔ <strong>가나다순입니다.</strong> 무엇으로도 줄 세우지 않습니다. 순서에 뜻이 없습니다.
  </p>
  <div class="tablewrap">
    <table>
      <thead>
        <tr>
          <th>학교</th>
          <th>남녀</th>
          <th>갈래</th>
          <th>문 연 해</th>
          <th>자리</th>
        </tr>
      </thead>
      <tbody>
        {
          곳들.map((x) => (
            <tr>
              <td>
                {x.홈페이지 ? (
                  <a href={x.홈페이지} rel="nofollow noopener" target="_blank">{x.title}</a>
                ) : (
                  x.title
                )}
              </td>
              {/* ⛔ 모르는 것을 「남녀공학」으로 적지 않는다 — 「—」로 둔다 */}
              <td>{x.공학 ?? '—'}</td>
              <td>{x.설립}</td>
              <td>{Number.isFinite(x.설립연) ? `${x.설립연}년` : '—'}</td>
              <td class="addr">{String(x.주소 ?? '').replace(`${시도} `, '')}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  {
    공학모름.length > 0 && (
      <p class="note">
        ⚠ {공학모름.length}곳은 공시에 남녀 구분 값이 없어 「—」로 두었습니다.{' '}
        <strong>남녀공학으로 바꿔 적지 않았습니다.</strong>
      </p>
    )
  }

  {
    열해묶음.length > 1 && (
      <>
        <h2>{구}의 중학교는 언제 문을 열었나</h2>
        <p class="note">
          학교가 언제 생겼는지는 그 동네가 언제 커졌는지를 따라갑니다.
          {가장많은십년 && (
            <>
              {' '}
              {구}에서는 <strong>{가장많은십년.십}년대에 {가장많은십년.수}곳</strong>이 가장 많이
              문을 열었습니다.
            </>
          )}
          {가장오래된 && 가장새로운 && 가장오래된.설립연 !== 가장새로운.설립연 && (
            <>
              {' '}
              가장 이른 곳이 {가장오래된.설립연}년, 가장 늦은 곳이 {가장새로운.설립연}년입니다.
            </>
          )}
        </p>
        <div class="tablewrap">
          <table>
            <thead>
              <tr><th>문 연 해</th><th>곳</th><th /></tr>
            </thead>
            <tbody>
              {
                열해묶음.map((b) => (
                  <tr>
                    <td>{b.십}년대</td>
                    <td>{b.수}곳</td>
                    <td class="bar">
                      <span
                        style={`display:inline-block;height:10px;background:currentColor;opacity:.45;width:${Math.round((b.수 / (가장많은십년?.수 || 1)) * 100)}%`}
                      />
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </>
    )
  }

  {
    이지역 && 시도가운데값 != null && 시도안곳수들.length > 1 && (
      <>
        <h2>{시도} 안에서 {구}는</h2>
        <p class="note">
          {시도}의 시·군·구는 중학교를 <strong>가운데값 {시도가운데값}곳</strong>씩 가지고
          있습니다. {구}는 <strong>{곳들.length}곳</strong>입니다.{' '}
          <strong>많은 쪽이 좋은 것도, 적은 쪽이 나쁜 것도 아닙니다.</strong> 곳수는 그 동네에
          사는 아이 수와 땅 넓이를 함께 따라갑니다.
        </p>
      </>
    )
  }

  <h2>이 한 장에 없는 것</h2>
  <p class="note">
    중학교는 <strong>고교 진학 결과·학업성취 공시가 없습니다.</strong> 고등학교에는 있는 칸이
    중학교에는 처음부터 없습니다. 그래서 이 지면에는 그 숫자가 없습니다 —{' '}
    <strong>빈칸을 0 으로 채우거나 짐작으로 메우지 않았습니다.</strong>
  </p>

  {같은시이웃.length > 0 && (
    <>
      <h2>{시부분이름} 전체로는 {같은시곳수}곳입니다</h2>
      <p class="note">
        이 표의 {곳들.length}곳은 <strong>{구}</strong>의 것입니다. 같은 시 안의 다른 구에
        <strong>{같은시곳수 - 곳들.length}곳</strong>이 더 있습니다 — 학교 주소에 적힌
        구로 갈라 놓았기 때문입니다.
      </p>
      <ul>
        {같은시이웃.map((a: any) => (
          <li><a href={`/middle/area/${a.slug}`}>{a.이름} 중학교</a> {a.곳}곳</li>
        ))}
      </ul>
    </>
  )}

  {
    같은시도.length > 0 && (
      <>
        <h2>{시도}의 다른 지역 중학교</h2>
        <p class="links">
          {
            같은시도.map((a) => (
              <>
                <a href={중등지역주소(a.slug)}>{a.구} {a.곳}곳</a>{' '}
              </>
            ))
          }
        </p>
      </>
    )
  }

  <h2>이 숫자는 어디서 왔나요?</h2>
  <p class="note">
    NEIS 교육정보 개방 포털의 중학교 자료입니다({올해}년). 전국{' '}
    {전국곳수.toLocaleString()}곳을 주소로 갈라 시·군·구마다 한 장씩 놓았습니다.
    <br />
    ⚠ 재외한국학교와 아직 문을 열지 않은 곳은 뺐습니다. 각종학교와 방송통신중학교도 뺐습니다.
    설립일은 NEIS 값이라 학교가 스스로 세는 개교기념일과 다를 수 있습니다.
  </p>

  {/* 🔴 초·중·고가 서로를 가리킨다. 한 구에 세 장이 있고, 부모는 셋을 다 본다 */}
  <p class="note">
    <a href="/middle">전국 중학교 한눈에 보기 →</a> · <a href="/region">지역으로 보기 →</a>
    <br />
    <a href={`/elementary/area/${slug}`}>{구}의 초등학교 보기 →</a> ·{' '}
    <a href={`/report/area/${slug}`}>{구}의 고등학교 보기 →</a>
  </p>
</HundredYear>

