---
/**
 * /100y/school/[code] — P2 학교 페이지
 *
 * 학과 페이지(P1)가 「이 길로 가면 어떻게 되나」라면,
 * 학교 페이지는 「그럼 어디로 가야 하나」다. 두 축이 서로를 가리킨다.
 *
 * ⛔ 학교끼리 등수를 매기지 않는다. 「명문」·「상위」 같은 말을 쓰지 않는다.
 *    같은 지역에 몇 곳이 있는지는 규모의 사실이라 쓴다.
 *
 * ⚠ 취업 수치는 **학교유형 전체**의 값이다. 이 학교 하나의 성적표가 아니다.
 *    학교 이름 옆에 붙는 숫자는 오해를 사기 제일 쉬운 자리라, 경고를 숫자 바로 밑에 둔다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import { 공학말 } from '../../../lib/school-label';
/* 🔴 [2026-10-04 08:3x] 이 학교의 「한 곳 리포트」로 가는 길을 낸다 — 그 페이지가
   첫 화면에서 한 번도 안 닿고 있었다. 「연 부분이 그대로 광고가 된다」고 열어 둔
   페이지인데 가는 길이 없었다. ⛔ 리포트가 «있는» 학교에서만 건다 — 없으면 404 다 */
import { 리포트가있나 } from '../../../lib/100y-report-samples.mjs';
import { href, lastSegment } from '../../../lib/hundredyear';
import { 고교지역_대학지역, 짧은지역명 } from '../../../lib/region';
import { 권할만한 } from '../../../lib/university';
import { 조사 } from '../../../lib/josa';
import { 퍼센트, 명 } from '../../../lib/number-format';
import schools from '../../../data/100yearmap/pages-school.json';
import 옛이름대장 from '../../../data/100yearmap/school-former-names.json';
import 중단자료 from '../../../data/100yearmap/school-dropout.json';
import 학급자료 from '../../../data/100yearmap/school-class-size.json';
import 진로자료 from '../../../data/100yearmap/school-career.json';
import 계열자료 from '../../../data/100yearmap/voc-series-outcomes.json';
import NextQuestion from '../../../components/NextQuestion.astro';
/* 🔴 숫자가 없는 페이지가 **왜 없는지**를 사실에서 계산한다 — 짐작으로 쓰지 않는다 */
import { 빈까닭찾기, 칸빈까닭 } from '../../../lib/school-gap';
/* 🔴 이 학교가 어느 지역 한 벌에 드는가 — 가르는 자와 목록은 **한 곳**에서 온다 */
import { 지역가르기 } from '../../../lib/school-area';
/* 🔴 [2026-09-23] 「검색에 올릴 만한가」도 **한 곳**에서 온다.
   애드센스가 이 사이트를 「가치가 별로 없는 콘텐츠」로 막았고, 재 보니 진로 자료가 없는
   페이지 686장이 「못 찾았습니다」로 차 있었다. 페이지·사이트맵·이미지사이트맵이 같은 자를 쓴다. */
import { 검색에올릴만한가 } from '../../../lib/school-worth-indexing.mjs';
import 지역단위 from '../../../data/100yearmap/areas.json';
import majors from '../../../data/100yearmap/pages-major.json';
import universities from '../../../data/100yearmap/pages-university.json';

/** 페이지가 있는 학과만 링크한다. 개설 학교가 1곳뿐인 학과는 페이지가 없다(얇아서 뺐다) */
const HAS_PAGE = new Set((majors as any[]).map((m) => m.url));

/** 지역 → 그 지역 대학. 한 번만 만들고 2,525장이 나눠 쓴다
 *  ⚠ 페이지마다 filter 를 돌리면 2,525 × 377 번이 된다 */
/** ⚠ 2026-08-05 — **수치가 하나도 없는 48곳을 여기서 뺐다.**
 *  이 목록은 2,525장에 그대로 실린다. 학부모가 누르면 텅 빈 페이지가 나왔다.
 *  강원 지역 대학교 13곳 중 5곳이 그랬다(캠퍼스 4 + 한중대학교).
 *  ⛔ 페이지를 지운 것이 아니다 — 「대학 찾기」에는 그대로 있고 「수치 없음」이라 적혀 있다.
 *     검색해서 온 사람에게는 그 사실 자체가 답이다. 다만 **우리가 먼저 권하지는 않는다.** */
const 지역별대학 = new Map<string, any[]>();
for (const u of 권할만한(universities as any[])) {
  if (!지역별대학.has(u.지역)) 지역별대학.set(u.지역, []);
  지역별대학.get(u.지역)!.push(u);
}
for (const list of 지역별대학.values()) list.sort((a, b) => a.표시명.localeCompare(b.표시명, 'ko'));

/** 🔴 **이름이 겹치는 학교가 102가지 · 216장이다** (2026-08-05 실측).
 *  서울 강동고 · 대구 강동고 · 울산 강동고가 **전부 다른 학교**인데 제목이 같았다.
 *  검색 결과에 셋이 나란히 뜨면 어느 학교인지 고를 수가 없다.
 *  ⚠ 겹치는 것에만 지역을 붙인다 — 안 겹치는 2,309장까지 길어질 이유가 없다. */
const 이름수 = new Map<string, number>();
for (const s of schools as any[]) 이름수.set(s.title, (이름수.get(s.title) ?? 0) + 1);

export async function getStaticPaths() {
  return (schools as any[]).map((s) => ({
    params: { code: lastSegment(s.url) },
    props: { school: s },
  }));
}

const { school } = Astro.props as { school: any };
/* 이 페이지의 학교 코드 — 주소 마지막 조각이다. 아래 「한 곳 리포트」 길을 낼 때 쓴다 */
const 이학교코드 = lastSegment(school.url);
const 겹침 = (이름수.get(school.title) ?? 0) > 1;
/**
 * 🔴 **간판에 「진학률」이 없었다** (2026-08-09 10:1x · 2번 라이브 실측).
 *
 *   지금 제목      「경신고등학교(서울)」  ⛔ 「진학률」 0번
 *   부모가 치는 말  「경신고 진학률」
 *
 *   ⭐ 학교 페이지가 **2,525장으로 제일 많다.** 지역(258)의 열 배다.
 *     그리고 부모는 지역보다 **학교 이름으로** 먼저 찾는다.
 *
 * ⛔ 진학률이 **없는 학교에는 안 붙인다.** 지역 페이지에서 4장을 뺀 그 판단 그대로다.
 *   본문에 진학률이 있는 페이지는 1,115장뿐이다 — 나머지에 붙이면 거짓 간판이 된다.
 * ⚠ 이 상수는 `진로` 아래로 내려와 있다. `진로` 보다 위에 두면 「is not defined」다.
 */
const 이름표 = 겹침 ? `${school.title}(${짧은지역명(school.지역)})` : school.title;
/**
 * 🔴 2026-08-24 — **개명 전 이름.** 5번이 실측으로 찾았다 — 손님이 옛 이름
 *   (「경기여자상업고등학교」)으로 검색하면 구글이 이름이 닮은 **다른 학교**
 *   (`/school/7010272` «경기상업고등학교»)를 대신 보여주고 있었다. 진짜 이 학교
 *   페이지(여기)에는 옛 이름이 한 글자도 없어 구글이 이을 방법이 없었다.
 * ⚠ NEIS 학교기본정보는 지금 이름만 준다 — 옛 이름은 자동으로 못 채운다.
 *   `school-former-names.json` 에 하나씩 확인해서만 채운다(짐작 금지).
 */
const 옛이름 = ((옛이름대장 as any).대장 as any[]).find((r) => r.code === school.code) ?? null;
/**
 * ⭐ **이 학교 하나의 숫자다** (2026-08-06) — 이 페이지에서 처음이다.
 *
 * 위의 취업 수치는 「특성화고 전체」·「마이스터고 전체」 값이라 학교마다 똑같다.
 * 학업중단은 **학교별로 공시된다.** 그래서 얇은 일반고 1,353장이 처음으로
 * **제 숫자**를 갖는다.
 *
 * ⛔ 이것을 「학교의 성적표」로 읽으면 안 된다 — 전학·유학·건강·검정고시가 다 섞여 있다.
 *   그 말을 숫자 바로 밑에 둔다.
 */
const 중단표 = new Map<string, any>(((중단자료 as any).자료 as any[]).map((r) => [r.code, r]));
const 중단출처 = (중단자료 as any).출처;

/**
 * ⭐ **이 학교 하나의 숫자 둘째** (2026-08-07) — 학급당 학생 수 · 수업교원 1인당 학생 수.
 *
 * ⚠ 여기 「졸업생 진로는 못 받는다」고 적어 뒀었다. **틀렸다.** 항목 52 가 열려 있고
 *   지금은 이 페이지 맨 위에 실린다(위 `진로표` 주석 참조). 이 블록은 그것과 **다른 축**이다 —
 *   「어디로 갔나」가 아니라 **「어떤 데서 배우나」**다. 둘 다 남긴다.
 *
 * ⚠ 【수업교원】은 정규 교과목을 **단독 전담해 수업하는** 교원이다. 휴직·파견까지 넣은
 *   「교원수」와 다르다. **그 말을 페이지에 그대로 적는다** — 안 적으면 다른 표와 안 맞는다고 읽힌다.
 * ⛔ 등수를 쓰지 않는다. **전국 중간값과의 견줌**만 쓴다.
 */
const 학급표 = new Map<string, any>(((학급자료 as any).자료 as any[]).map((r) => [r.code, r]));
const 학급출처 = (학급자료 as any).출처;
const 학급통계 = (학급자료 as any).통계;

/**
 * 🔴 **졸업생의 진로** — 이 페이지에서 사람들이 제일 먼저 묻는 것이다(2026-08-07).
 *
 * ⛔ **제가 「이건 못 받는다」고 두 번 결론 내고 페이지에 그렇게 적었다. 틀렸다.**
 *   학교알리미 항목 52 가 계정도 신청도 없이 열려 있다. 두 번 다 원인은 같다 —
 *   **항목 목록을 뽑는 내 자가 불완전했다.** 「없다」는 결론은 「있다」보다 검증이 더 필요하다.
 *
 * ⚠ 직업계고(특성화·마이스터)는 이 표에 거의 없다. 그쪽 진로는 **별도 조사**로 가고
 *   우리는 그것을 `/work` 페이지에 쓴다. **두 숫자를 빼서 견주지 않는다.**
 * ⛔ 「기타」를 「논다」로 읽으면 안 된다 — **재수생이 여기 들어간다.**
 */
const 진로표 = new Map<string, any>(((진로자료 as any).자료 as any[]).map((r) => [r.code, r]));
const 진로출처 = (진로자료 as any).출처;
const 진로통계 = (진로자료 as any).통계;

const 취업 = school.취업;
const 평균 = 취업?.전체평균;
const 수치 = 취업?.수치;
const pct = (v: number | null | undefined) => (v == null ? '—' : `${v.toFixed(1)}%`);

/** ⚠ 학과는 문자열이 아니라 객체다 — { name, url, 전국개설교수, 전국순위 }.
 *  `url` 이 null 이면 그 학과는 독립 페이지가 없다(개설 학교가 1곳뿐이라 뺐다).
 *  그래도 **이름은 보여준다** — 그 학교에 실제로 있는 학과를 숨기면 안 된다.
 *  ⛔ `전국순위` 는 읽지 않는다. 정렬용이고 화면에 나가지 않는다. */
const 학과 = (school.학과 ?? []) as { name: string; url: string | null }[];

/** 설립일 19980113 → 1998년 */
const 설립연도 = /^\d{8}$/.test(school.설립일 ?? '') ? school.설립일.slice(0, 4) : null;

/** ⭐ 두 축을 잇는 자리 — 「대학 다음까지 보는 진로 지도」인데 여태 고교와 대학이 서로 안 닿았다.
 *  ⚠ 학과끼리 잇는 자료(고교 학과 ↔ 대학 학과)는 **아직 없다.** 있는 것은 지역뿐이다.
 *    그래서 **지역으로만** 잇는다. 짐작으로 학과를 잇지 않는다.
 *  ⚠ 이 페이지 2,525장 중 1,353장이 학과가 없는 일반고다. 그쪽에는 이게 유일한 다음 걸음이 된다. */
const 중단 = 중단표.get(school.code) ?? null;
const 학급 = 학급표.get(school.code) ?? null;
const 진로 = 진로표.get(school.code) ?? null;

/** 제목에 「진학률」을 달아도 되는가 — **이 학교의 진학률 숫자가 있을 때만** */
const 진학률있나 = 진로?.진학률 != null;
/** ⚠ 레이아웃이 뒤에 「 — 백년지도」를 붙인다. 지금 가장 긴 것도 60자 안이다 */
const 제목 = 진학률있나 ? `${이름표} 진학률` : 이름표;

/**
 * 🔴 **숫자가 하나도 없는 페이지가 103곳 있다** (2026-08-07 · 2번 지시).
 *
 *   *「손님이 학교를 검색해 들어왔는데 숫자가 하나도 없으면 그 페이지는 없는 것과 같다」*
 *
 *   채울 수 있는 것은 먼저 채웠다 — 학교알리미를 학교급 `04` 만 받고 있어서
 *   `06`·`07` 에 있는 곳을 놓쳤다. 그걸 고쳐 **105 → 103**.
 *   ⛔ 나머지는 **자료가 있을 수 없다.** 그러면 **왜 없는지를 페이지가 말한다.**
 *     「자료가 없습니다」로 끝내면 우리가 게을렀다는 말과 구분이 안 된다.
 */
const 숫자없음 = !중단 && !학급 && !진로 && !취업;
const 학생0명단 = new Set<string>(((학급자료 as any).통계?.학생0이라뺀곳 ?? []) as string[]);
const 빈까닭 = 숫자없음
  ? 빈까닭찾기(school.title, school.설립일, school.종류, 학생0명단, 학급출처.공시연도)
  : null;

/**
 * 🔴 **칸 하나가 말없이 비는 자리** (2026-08-08 19:5x · 2번 지시로 세어 보고 나왔다).
 *
 *   2번이 *「일반고 1,703곳에 보여 줄 숫자가 없다」*고 하셔서 **채우기 전에 셌다.**
 *   1,703 중 1,619 곳에는 숫자가 **있었다.** 대신 다른 것이 나왔다 —
 *
 *   ```
 *   셋 다 있음                     1,821곳
 *   하나도 없음 → 페이지가 까닭을 말함  131곳
 *   🔴 일부만 없는데 말이 없음        94곳   ← 칸이 그냥 사라진다
 *   ```
 *
 *   ⛔ 이쪽이 더 나쁘다. **숫자가 있는 페이지에서 한 칸만 사라지면**
 *     「이 학교만 뭔가 이상한가」로 읽힌다.
 *   ⚠ 특성화고는 진로 대신 **취업 숫자**가 있으니 여기서 세지 않는다 — 비어 있는 것이 아니다.
 */
const 칸이비었나 = (있나: unknown) => !숫자없음 && !있나;
const 칸까닭 = (칸: '진로' | '중단' | '학급') =>
  칸빈까닭(칸, school.설립일, school.종류, school.title, 학생0명단, 학급출처.공시연도);

/**
 * ⭐ **계열별 취업·진학** (2026-08-07) — 직업계고 480곳의 빈 자리를 메운다.
 *
 * 여태 이 페이지의 취업 숫자는 **두 벌뿐**이었다(특성화고 전체 / 마이스터고 전체).
 * 516곳이 전부 같은 숫자를 보니 학교를 고르는 데 쓸 수가 없었다.
 *
 * 🔴 **학교별 숫자는 어디에도 없다.** 오늘 네 방향으로 확인했다 —
 *   ① 학교알리미 공개용 28항목에 특성화고 취업 칸이 없다
 *   ② 항목 52(졸업생의 진로)에 특성화고가 4곳뿐이다(항목 09 에는 487곳)
 *   ③ 유력 항목 8개를 2023~2026 네 해로 두드렸다 — 전부 미공시
 *   ④ KOSIS 직업계고 관련 58표의 축을 다 봤다 — 학교 단위 축이 없다
 *
 * 🟢 대신 **계열**을 붙인다. 그 학교의 학과가 속한 계열을 **모두** 보인다.
 *   ⚠ 계열이 하나로 정해지는 학교는 88곳뿐이고 **398곳은 여러 계열**이다(실측).
 *     하나를 골라 붙이면 나머지를 숨기는 것이라, 있는 대로 다 보인다.
 *   ⚠ 학과의 계열은 **학과 이름으로 저희가 추정한 것**이다. 그 말을 페이지에 적는다.
 *   ⛔ 여전히 학교 하나의 값이 아니다. 「이 학교 취업률」로 읽히게 두지 않는다.
 */
const 계열표 = new Map<string, any>(((계열자료 as any).자료 as any[]).map((r) => [r.계열, r]));
const 계열통계 = (계열자료 as any).통계;
const 계열출처 = (계열자료 as any).출처;
const 학과계열 = new Map<string, string>(
  (majors as any[]).filter((m) => m.계열).map((m) => [m.title, m.계열]),
);
const 이학교계열 = [
  ...new Set(
    (school.학과 ?? [])
      .map((a: any) => 학과계열.get(a.name))
      .filter((c: string | undefined) => c && c !== '미분류'),
  ),
]
  .map((c) => 계열표.get(c as string))
  .filter(Boolean)
  .sort((a: any, b: any) => b.졸업자 - a.졸업자);

/** 전국 중간값과 견준다. ⛔ 「좋다/나쁘다」를 말하지 않는다 — 차이만 적는다.
 *  ⚠ 소수 한 자리끼리 뺀다. 반올림한 값과 안 반올림한 값을 견주면 **말이 뒤집힌다**
 *    (2026-08-06 대학 페이지에서 실제로 났다 — `check:100y:launch` 가 그 규칙을 지킨다) */
const 견줌 = (값: number | null, 중간: number | null) => {
  if (값 == null || 중간 == null) return null;
  const 차 = Math.round((값 - 중간) * 10) / 10;
  if (차 === 0) return `전국 중간값(${중간}명)과 같습니다`;
  return `전국 중간값 ${중간}명보다 ${Math.abs(차)}명 ${차 > 0 ? '많습니다' : '적습니다'}`;
};

const 대학지역 = 고교지역_대학지역(school.지역);
const 지역대학 = 대학지역 ? (지역별대학.get(대학지역) ?? []) : [];
const 보여줄대학 = 지역대학.slice(0, 12);
const 지역짧게 = 짧은지역명(school.지역);

/**
 * ⚠ 설명도 **가진 것만** 적는다.
 *   진학률이 있으면 그 수를 그대로 적고(부모가 찾는 말이 그 수다),
 *   없으면 앞서 쓰던 말을 그대로 둔다. ⛔ 없는 수를 지어 넣지 않는다.
 */
const 앞머리 = `${school.title}(${school.지역} · ${school.고교유형})`;
/**
 * 🔴 **검색 결과에서 손님이 읽는 두 줄에 숫자가 없었다** (2026-08-10 06:2x · 2번이 라이브에서 잼).
 *
 *   ```
 *   /age/32           월급여 368만 9천원 · 근속 4년 · 초혼 52.5%   ⭐ 숫자 셋
 *   /major/정보처리과   전국 391개 고교 · 1년 뒤 82.0%             ⭐ 숫자 셋
 *   /school/가곡고등학교 「기본 정보를 교육부 공공데이터로 정리했습니다」  🔴 **숫자 0**
 *   ```
 *   ⛔ `/school/` 이 **2,525장 — 사이트에서 제일 큰 갈래**다. 거기만 숫자가 없었다.
 *     검색 결과에서 두 줄에 숫자가 없으면 **옆의 학교 알림판과 구별이 안 된다.**
 *
 *   ⚠ 진학률이 없는 학교에도 **학급당 학생 수·학업중단률은 있다**(628곳).
 *     그 둘은 이미 페이지에 뜨고 있었는데 **설명 글에만 안 들어갔다.**
 *   ⛔ 없는 학교는 **비워 둔다.** 지어내지 않는다 — 「기본 정보를…」 그대로가 낫다.
 *   ⚠ 검색 결과는 앞쪽 여든 자쯤만 보인다. **숫자를 앞에 놓는다.**
 */
const 수조각: string[] = [];
if (진학률있나) 수조각.push(`진학률 ${퍼센트(진로.진학률)}`);
if (진로?.졸업자 != null) 수조각.push(`졸업자 ${진로.졸업자.toLocaleString()}명`);
if (학급?.학급당학생 != null) 수조각.push(`학급당 ${명(학급.학급당학생)}`);
if (중단?.학업중단률 != null) 수조각.push(`학업중단 ${퍼센트(중단.학업중단률)}`);

/**
 * 🔴 [2026-10-03 · 5번] **제목에 수를 올린다.**
 *   28일 실측 — 백년지도 노출 807 · 평균 6위 · 클릭 **0**.
 *   제목에 수가 없는 페이지가 5,137장 가운데 4,642장(90%)이었고 학교 페이지가 그 대부분이다.
 *   「고금고등학교 — 백년지도」로는 검색 결과에서 옆의 백과사전과 구별되지 않는다.
 * ⛔ 수를 지어내지 않는다 — 설명글이 이미 쓰고 있는 수조각 첫 토막을 그대로 올린다.
 * ⛔ 수가 하나도 없는 학교는 제목을 그대로 둔다.
 * ⚠ h1 은 안 건드린다. 바뀌는 것은 <title> 뿐이다.
 */
/* ⚠ 제목에는 «비율»을 먼저 올린다. 「졸업자 14명」은 수이긴 해도 누를 까닭이 못 된다 —
   진학률·학업중단률·학급당 학생 수는 다른 학교와 견줄 수 있는 수라서 손님이 궁금해한다. */
const 제목수조각 = 수조각.find((t) => /%|명$/.test(t) && !t.startsWith('졸업자')) ?? 수조각[0];
const 제목에수 = 제목수조각 ? `${이름표} ${제목수조각}` : 제목;

const desc = 수조각.length
  ? `${앞머리} — ${수조각.slice(0, 3).join(' · ')}입니다. ` +
    (진학률있나
      ? '전국 같은 갈래와 견줄 수 있게 놓았습니다. 줄 세우지 않습니다.'
      : '진학 숫자가 없는 까닭도 페이지에 적어 두었습니다. 줄 세우지 않습니다.')
  : 학과.length
    ? `${앞머리}에 개설된 학과 ${학과.length}개와, 이 학교유형 졸업자가 취업 뒤에 얼마나 그 자리에 남는지를 공공데이터로 정리했습니다.`
    : `${앞머리}의 기본 정보를 교육부 공공데이터로 정리했습니다.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HighSchool',
  name: school.title,
  ...((school.titleEn || 옛이름) ? { alternateName: [school.titleEn, 옛이름?.이전이름].filter(Boolean) } : {}),
  address: { '@type': 'PostalAddress', addressRegion: school.지역, streetAddress: school.주소 },
  ...(school.홈페이지 ? { url: school.홈페이지 } : {}),
};
/**
 * 이 학교가 드는 지역 한 벌. ⚠ **`areas.json` 에 있는 것만** 잇는다 —
 *   페이지가 없는 열쇠로 링크를 걸면 404 가 된다.
 *   주소를 못 가른 학교 4곳은 여기서 null 이고, 그 페이지에는 줄이 안 붙는다.
 */
/**
 * 🔴 2번 지시(2026-08-08 12:1x) — 학교 페이지 8장이 **전부 같은 그림**으로 공유되고 있었다.
 *   카드는 `scripts/make-og-100y-pages.mjs` 가 굽는다. 여기서는 **주소만** 가리킨다.
 * ⚠ 굽는 쪽과 이름 규칙이 같아야 한다 — `school-${code}.png`. 다르면 404 다.
 */
const 카드주소 = `https://100yearmap.com/og/school-${school.code}.png`;

const 이지역 = (() => {
  const g = 지역가르기(school.주소);
  if (!g) return null;
  return ((지역단위 as any).단위 as any[]).find((a) => a.열쇠 === g.열쇠) ?? null;
})();

import 요약 from '../../../data/100yearmap/summary.json';
const 받은날 = String((요약 as any).원천수집시각 ?? '').slice(0, 10);
---

{/* ⚠ 제목에만 지역을 붙인다. h1 은 그대로 둔다 —
    지면에 들어온 사람은 바로 아래 `.sub` 에서 지역을 이미 본다 */}
{/*
  🔴 **얇은 지면은 검색에 안 올린다** (사장님 결정 2026-08-05 「알찬 것만 먼저 열어라」).
     이름·주소뿐인 지면은 **검색에서 들어온 사람에게 줄 게 없다.**
     얇은 지면이 많으면 사이트 전체 품질 평가가 깎인다.

  ⭐ **2026-08-06 — 조건이 하나 늘었다.** 학교별 학업중단 수치가 붙었다.
     그건 「특성화고 전체」 같은 **유형 평균이 아니라 이 학교 하나의 숫자**다.
     그래서 학과가 없어도 **제 숫자가 있으면 연다.**

     열림   학과가 있거나 · 학업중단 수치가 있는 지면   2,441장
     닫힘   둘 다 없는 지면                          84장

  🔴 **[2026-09-23] 그 문턱이 너무 낮았다.** 애드센스가 이 사이트를
     「가치가 별로 없는 콘텐츠」로 막았다(2026-09-21). 광고는 이 사이트의 유일한 매출이다.
     재 보니 «진로(졸업 후 어디로 갔나)»가 없는 지면이 686장이었고, 그 지면들은 본문의
     큰 자리를 「졸업생이 어디로 갔는지 찾지 못했습니다」가 차지하고 있었다
     (실측 — 가곡고등학교 본문 1,974자 · 「—」 11개).

     ⇒ 문턱을 올렸다. **진로가 있거나, (직업계고처럼) 학과가 있고 수치가 붙은 지면**만 연다.
     ⛔ 지면을 «지우지 않는다» — 검색에만 안 올린다. 링크로 온 손님에게는
       「우리도 못 찾았다」는 사실 자체가 답이다. 그것이 우리 강령이다.
     ⭐ 「한 자료로 지면 수천 장」이 틀린 것이 아니다. 그 노하우의 둘째 규칙
       —「낼 내용이 없으면 지면을 안 만든다」— 를 우리가 안 지킨 것이다.

  ⚠ **사이트맵도 조건이 같아야 한다**(`sitemap.xml.ts`). 한쪽만 고치면 구글에 모순된
    신호를 준다. ⇒ 이제 셋이 `lib/school-worth-indexing.mjs` 한 자를 나눠 쓴다.
*/}
<HundredYear
  title={제목에수}
  description={desc}
  jsonLd={jsonLd}
  noindex={!검색에올릴만한가(school, {
    진로: new Set(진로 ? [school.code] : []),
    중단: new Set(중단 ? [school.code] : []),
    학급: new Set(학급 ? [school.code] : []),
  })}
  ogImage={카드주소}
>
  <h1>{school.title}</h1>
  <p class="sub">
    {school.지역} · {school.고교유형} · {school.설립}
    {공학말(school.공학, school.종류) && <> · {공학말(school.공학, school.종류)}</>}
    {설립연도 && <> · {설립연도}년 설립</>}
  </p>
  {옛이름 && (
    <p class="note">옛 이름 «{옛이름.이전이름}»({옛이름.언제}). 같은 학교입니다.</p>
  )}

  {/* 🔴 숫자가 하나도 없는 지면 — **왜 없는지를 맨 위에서 말한다.**
        아래로 내려가며 아무것도 못 찾고 나가게 두면 그 지면은 없는 것과 같다.
        ⛔ 「자료가 없습니다」로 끝내지 않는다. **무엇이 막는지**까지 적는다. */}
  {
    빈까닭 && (
      <div class="card warn">
        <h2 style="margin-top:0">이 학교는 숫자를 못 보여드립니다</h2>
        <p><strong>{빈까닭.한줄}.</strong></p>
        <p
          class="note"
          set:html={빈까닭.풀이.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')}
        />
        <p class="note">
          ⚠ 아래에는 <strong>학교 이름·주소 같은 기본 정보만</strong> 있습니다. 진학·취업·학업중단
          숫자는 <strong>이 페이지에 없습니다.</strong>
        </p>
      </div>
    )
  }

  {/**
    * 학과 — 이 학교의 얼굴이다. 취업 수치보다 먼저 놓는다.
    *
    * 🔴 **「개설 학과」라고 쓰면 안 된다** (2026-08-08 07:2x · 2번 지시로 원자료를 뒤졌다)
    *
    *   나이스 `schoolMajorinfo` 18,169행을 열어 보니 **개설일·폐과일 칸이 없다.**
    *   날짜라고는 `LOAD_DTM` 하나인데 값이 **20260801·20260701 둘뿐**이다 —
    *   학과가 언제 생겼나가 아니라 **나이스가 언제 실었나**다.
    *
    *   그리고 실제로 이런 줄이 들어 있다.
    *   ```
    *   서울고등학교      일반계  항공과
    *   경복고등학교      일반계  항공과
    *   건국대사대부고     일반계  항공과
    *   ```
    *   서울의 일반고에 지금 항공과가 있을 리 없다. **옛것이 섞여 있다.**
    *
    *   ⛔ 그래서 「개설 학과」(=지금 열려 있다)로 쓰지 않는다.
    *     **「나이스에 등록된 학과」**로 쓰고, 못 가린다는 것을 지면이 스스로 말한다.
    *   ⚠ 빼지도 않는다. 어느 줄이 옛것인지 **가릴 자가 없기 때문**이다.
    *     지우면 지금 있는 학과까지 지운다.
    */}
  {
    학과.length > 0 ? (
      <>
        <h2>나이스에 등록된 학과 {학과.length}개</h2>
        <ul class="majors">
          {학과.map((m) => (
            <li>
              {m.url && HAS_PAGE.has(m.url) ? (
                <a href={href(m.url)}>{m.name}</a>
              ) : (
                <span>{m.name}</span>
              )}
            </li>
          ))}
        </ul>
        <p class="note">학과를 누르면 그 길로 간 사람들이 졸업 뒤에 어떻게 됐는지 볼 수 있습니다.</p>
        {/* 🔴 못 가리는 것을 지면이 스스로 말한다. 안 적으면 「지금 있는 학과」로 읽힌다 */}
        <p class="note">
          ⚠ <strong>지금 열려 있는 학과인지는 저희가 못 가립니다.</strong> 나이스 학과정보에{' '}
          <strong>개설일도 폐과일도 없어서</strong>입니다. 실제로 서울의 일반고 몇 곳에
          「항공과」가 들어 있는데, <strong>옛 기록이 남은 것으로 보입니다.</strong>
        </p>
        <p class="note">
          ⛔ 그렇다고 <strong>저희가 골라 지우지 않았습니다.</strong> 어느 줄이 옛것인지 가릴
          자가 없어서, 지우면 <strong>지금 있는 학과까지 지웁니다.</strong> 학교에 확인하시는 편이
          확실합니다.
        </p>
      </>
    ) : (
      <p class="note">
        이 학교는 NEIS 학과정보에 등록된 학과가 없습니다. 학과를 나누지 않는 일반계 과정이거나,
        아직 등록되지 않았을 수 있습니다.
      </p>
    )
  }

  {/* 취업 — ⚠ 경고를 숫자 바로 밑에 둔다 */}
  {
    수치 && (
      <>
        {/* 🔴 **왜 이 학교는 「졸업생 진로」 칸이 없나** (2026-08-07 · 2번 지시).
              일반고 지면에는 「졸업생은 어디로 갔나」가 있는데 여기엔 없다.
              부모가 그걸 보면 **「자료가 부실하다」로 읽는다.** 실제로는 숫자가 다 있고,
              **가진 것을 못 보여 주고 있는 것**이다. 그러니 없는 칸을 설명한다.
              ⛔ 「자료 없음」이 아니라 **「이 학교는 이 자로 본다」**로 적는다. */}
        {!진로 && (
          <p class="note">
            ⚠ {school.title}에는 다른 고등학교 페이지에 있는{' '}
            <strong>「졸업생은 어디로 갔나」 칸이 없습니다.</strong> 빠뜨린 것이 아닙니다 —
            직업계고 졸업생은 나라가 <strong>진학이 아니라 취업을 기준으로</strong> 따로 조사하고,
            그 조사에는 진학 칸이 없습니다. 그래서 이 학교는{' '}
            <strong>아래 취업 숫자로 봅니다.</strong>
          </p>
        )}

        <h2>졸업하고 나서</h2>
