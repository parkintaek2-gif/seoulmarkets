---
/**
 * /100y/pension-recipients-by-age — 국민연금 수급자는 몇 살에 몰려 있나, 나이별 인원수
 *
 * 출처  국민연금공단 수급현황(지역×연령), 공공데이터포털 15010381 — src/data/100yearmap/pension-recipients.json
 *       의 지역별 totPrsnCnt(총 인원수) 칸. 이 쪽에서 한 일은 16개 지역 줄을 나이별로 더하고 비중을 계산한 것뿐이다.
 * 같은 자료로 /pension 은 «평균 월 수급액»을 나이·지역 표로 옮긴 지면이다. 이 지면은 «인원수»다.
 * ⚠ 자료의 「전국」 줄에는 인원수 칸이 없다. 합계는 지역 16줄을 더한 값이고, 전국 줄의 평균 수급액을
 *   지역 줄의 인원수로 가중해 봐도 전국 줄 값과 맞지 않는다(65세 744,256원 대 715,036원). 이유는 자료에 없다.
 * ⛔ 63세에서 수가 뛰는 이유(수급 개시 나이 등)는 이 자료에 없으므로 쓰지 않는다. 수만 적는다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import HundredAgeWalk from '../../../components/HundredAgeWalk.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import 원본 from '../../../data/100yearmap/pension-recipients.json';

const 자료 = 원본 as any;
const 지역들 = Object.keys(자료.지역별) as string[];
const 수 = (n: number) => Number(n).toLocaleString('ko-KR');
const 퍼글 = (a: number, b: number) => `${(b ? (a / b) * 100 : 0).toFixed(1)}%`;
const [나이시작, 나이끝] = 자료.나이범위 as [number, number];

const 나이별: Record<number, number> = {};
const 빈칸: Record<number, number> = {};
for (let a = 나이시작; a <= 나이끝; a++) {
  let s = 0;
  let m = 0;
  for (const r of 지역들) {
    const c = 자료.지역별[r][String(a)]?.totPrsnCnt;
    if (c == null) m++;
    else s += c;
  }
  나이별[a] = s;
  if (m) 빈칸[a] = m;
}
const 합계 = Object.values(나이별).reduce((a, b) => a + b, 0);
const 구간합 = (x: number, y: number) => {
  let s = 0;
  for (let a = x; a <= y; a++) s += 나이별[a] ?? 0;
  return s;
};
const 구간들 = [
  [40, 49], [50, 59], [60, 62], [63, 64], [65, 69], [70, 79], [80, 89], [90, 100],
].map(([x, y]) => ({ 이름: `${x}~${y}세`, 사람: 구간합(x, y) }));

const 가장많은나이 = Object.keys(나이별).map(Number).reduce((a, b) => (나이별[b] > 나이별[a] ? b : a));
const 육십이 = 나이별[62];
const 육십삼 = 나이별[63];
const 배수 = (육십삼 / 육십이).toFixed(1);
const 육십오이상 = 구간합(65, 100);
const 칠십이상 = 구간합(70, 100);
const 사십대 = 구간합(40, 49);

const 지역표 = [...지역들]
  .sort((a, b) => a.localeCompare(b, 'ko'))
  .map((r) => {
    let t = 0;
    let 칠십 = 0;
    for (let a = 나이시작; a <= 나이끝; a++) {
      const c = 자료.지역별[r][String(a)]?.totPrsnCnt ?? 0;
      t += c;
      if (a >= 70) 칠십 += c;
    }
    return { 이름: r, 사람: t, 칠십, 비중: t ? (칠십 / t) * 100 : 0 };
  });
const 칠십최고 = [...지역표].sort((a, b) => b.비중 - a.비중)[0];
const 칠십최저 = [...지역표].sort((a, b) => a.비중 - b.비중)[0];

const TITLE = `국민연금 수급자 ${수(합계)}명 가운데 ${수(나이별[가장많은나이])}명이 ${가장많은나이}세 — 62세 ${수(육십이)}명에서 63세 ${수(육십삼)}명으로`;
const desc = `국민연금공단 수급현황(2026-08 수집, 40~100세, 노령·장애·유족 합계)의 16개 지역 줄을 나이별로 더했습니다. 합계 ${수(합계)}명 중 70세 이상이 ${수(칠십이상)}명(${퍼글(칠십이상, 합계)})이고, 가장 많은 나이는 ${가장많은나이}세입니다.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: '국민연금 수급자 수, 나이별',
    description: desc,
    creator: { '@type': 'Organization', name: '백년지도' },
    sourceOrganization: { '@type': 'Organization', name: '국민연금공단' },
    spatialCoverage: '대한민국',
    variableMeasured: ['나이', '지역', '수급자 수'],
    isBasedOn: 'https://www.data.go.kr/data/15010381/openapi.do',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '국민연금을 받는 사람은 몇 살이 가장 많은가요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `국민연금공단 수급현황(2026-08 수집)의 지역별 인원수를 40~100세 나이별로 더하면 ${가장많은나이}세가 ${수(나이별[가장많은나이])}명으로 가장 많습니다. 62세는 ${수(육십이)}명, 63세는 ${수(육십삼)}명입니다. 노령·장애·유족연금을 합친 값입니다.`,
        },
      },
      {
        '@type': 'Question',
        name: '국민연금 수급자 가운데 70세 이상은 몇 %인가요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `40~100세 합계 ${수(합계)}명 가운데 70세 이상이 ${수(칠십이상)}명, ${퍼글(칠십이상, 합계)}입니다. 지역별로는 ${칠십최저.이름} ${칠십최저.비중.toFixed(1)}%에서 ${칠십최고.이름} ${칠십최고.비중.toFixed(1)}%까지입니다.`,
        },
      },
    ],
  },
];
---

<HundredYear title={TITLE} description={desc} jsonLd={jsonLd}>
  <h1>국민연금을 받는 사람은<br class="pcbr" /> 몇 살에 가장 많을까요</h1>
  <p class="sub">
    국민연금공단 수급현황의 지역별 인원수를 나이별로 더했습니다. 40~100세, 노령·장애·유족연금을 합친 값입니다.
  </p>

  <div class="answer">
    <p class="answer-label">수급자가 가장 많은 나이 — {가장많은나이}세</p>
    <p class="answer-num">{수(나이별[가장많은나이])}명</p>
    <p class="answer-sub">40~100세 합계 {수(합계)}명 · 70세 이상 {수(칠십이상)}명({퍼글(칠십이상, 합계)}) · 40대 {수(사십대)}명({퍼글(사십대, 합계)})</p>
  </div>

  <h2>나이 구간별 수급자</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>나이</th><th>수급자</th><th>비중</th></tr></thead>
      <tbody>
        {구간들.map((x) => (
          <tr>
            <th>{x.이름}</th>
            <td class="num">{수(x.사람)}명</td>
            <td class="num"><strong>{퍼글(x.사람, 합계)}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>60세부터 67세까지 한 살씩</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>나이</th><th>수급자</th></tr></thead>
      <tbody>
        {[60, 61, 62, 63, 64, 65, 66, 67].map((a) => (
          <tr>
            <th>{a}세</th>
            <td class="num">{수(나이별[a])}명</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>지역별로 70세 이상 비중</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>지역</th><th>수급자(40~100세)</th><th>70세 이상</th><th>비중</th></tr></thead>
      <tbody>
        {지역표.map((x) => (
          <tr>
            <th>{x.이름}</th>
            <td class="num">{수(x.사람)}명</td>
            <td class="num">{수(x.칠십)}명</td>
            <td class="num"><strong>{x.비중.toFixed(1)}%</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>같은 표에서 읽히는 것</h2>
  <ul>
    <li>62세는 {수(육십이)}명, 63세는 {수(육십삼)}명으로 한 살 차이에 약 {배수}배입니다. 가장 많은 나이는 {가장많은나이}세 {수(나이별[가장많은나이])}명입니다.</li>
    <li>65세 이상은 {수(육십오이상)}명으로 합계의 {퍼글(육십오이상, 합계)}, 70세 이상은 {퍼글(칠십이상, 합계)}입니다.</li>
    <li>70세 이상 비중은 {칠십최저.이름} {칠십최저.비중.toFixed(1)}%에서 {칠십최고.이름} {칠십최고.비중.toFixed(1)}%까지 지역마다 다릅니다.</li>
  </ul>

  <h2>⚠ 이 자료로 말할 수 없는 것</h2>
  <ul>
    <li>40세 미만은 자료에 없습니다. 노령·장애·유족연금을 나누지 않고 합친 값이라 노령연금만 받는 사람의 수가 아닙니다.</li>
    <li>자료의 「전국」 줄에는 인원수 칸이 없어 합계는 16개 지역 줄을 더한 값입니다. 전국 줄의 평균 수급액을 지역 인원수로 가중해 보면 전국 줄 값과 맞지 않아(65세 744,256원 대 715,036원), 이 합계를 국민연금공단이 공표하는 전체 수급자 수와 같다고 말하지 않습니다.</li>
    <li>광주와 전남은 자료가 한 줄로 줘서 합쳐 있습니다. 강원·전북은 특별자치도 개편 이후의 새 코드 줄만 썼습니다.</li>
    <li>97~100세는 일부 지역에서 값이 비어 있어 있는 지역만 더했습니다. 비어 있는 칸은 0명으로 바꾸지 않았습니다.</li>
    <li>63세에서 수급자가 크게 늘어나는 이유는 이 자료에 없습니다. 수만 적었습니다.</li>
  </ul>

  <p class="note">
    출처 — 국민연금공단 수급현황(지역×연령), 공공데이터포털 데이터셋 15010381. 이용허락범위 제한 없음. 받은 날 {자료.받은날}.
  </p>

  <p class="note">
    <a href="/pension">← 국민연금 수급액, 나이·지역별 평균 월 수급액</a>
    <br />
    <a href="/pension-amount-by-age-region">→ 나이가 들수록 연금 수급액은 어떻게 달라지나</a>
    <br />
    <a href="/keep-working">→ 55~79세, 계속 일하고 싶은 사람은 몇 %일까요?</a>
  </p>

  <HundredAgeWalk 키="pension-recipients-by-age" />
  <NextQuestionBrief 모은것="국민연금공단 수급현황의 지역별 인원수를 나이별로 더한 실측" />
</HundredYear>

<style>
  .num { text-align: right; font-variant-numeric: tabular-nums; }
</style>
