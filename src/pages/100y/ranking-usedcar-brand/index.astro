---
/**
 * /100y/ranking-usedcar-brand — 순위는 공개한다, 그러나 전부는 아니다 (시리즈 · 중고차 편)
 *
 * 한국기업평판연구소 2026년 9월 중고차 브랜드평판 1위(케이카)를 그대로 인용한다.
 * 100yearmap이 새로 순위를 매기지 않는다.
 *
 * 실측(국민연금 「중고 자동차 판매업」)은 화장품·독립보험대리점 편과 같은 방식으로
 * scripts/build-100y-nps-survival-by-ksic.mjs 로 계산했다(화장품 편 재현 검증 통과).
 * 결과는 이 시리즈 중앙값 — 안경원(5.9년)보다 짧고 화장품(2.49년)보다 길다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import HundredAgeWalk from '../../../components/HundredAgeWalk.astro';
import HundredCardnews from '../../../components/HundredCardnews.astro';
import 원본 from '../../../data/100yearmap/ranking-usedcar-brand-2026.json';

const 자료 = 원본 as any;
const 순위출처 = 자료.순위출처;
const top5 = 자료.top5 as any[];
const 실측 = 자료.실측대조;
const 일위 = top5[0];

const desc =
  `${순위출처.이름}에서 ${일위.브랜드}가 1위입니다. ` +
  `100yearmap이 실측한 중고 자동차 판매업 업종 전체의 사업장 수명 중앙값은 ${실측.수명중앙값_년}년입니다.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '이 중고차 브랜드 순위는 100yearmap이 매긴 건가요?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `아닙니다. ${순위출처.이름}를 그대로 인용했습니다. ${순위출처['⚠원자료']}`,
      },
    },
    {
      '@type': 'Question',
      name: '중고차 매매상사는 이 시리즈에서 얼마나 오래 가나요?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: (자료.이자료가못가르는것 as string[])[3] + ' ' + (자료.이자료가못가르는것 as string[])[0],
      },
    },
  ],
};
---

<HundredYear
  title={`중고차 브랜드평판 1위는 ${일위.브랜드} — 중고 자동차 판매업 수명 중앙값은 ${실측.수명중앙값_년}년입니다`}
  description={desc}
  jsonLd={jsonLd}
>
  <h1>
    중고차 브랜드평판 1위는 {일위.브랜드}<br class="pcbr" />
    중고 자동차 판매업 수명 중앙값은 {실측.수명중앙값_년}년입니다
  </h1>

  <div class="warn">
    <p><strong>⚠ 이 순위는 저희가 매긴 게 아닙니다.</strong></p>
    <p class="note">
      {순위출처.이름}({순위출처.발표일} 보도)를 그대로 인용했습니다. {순위출처['⚠원자료']}
    </p>
  </div>

  <p class="sub">
    한국기업평판연구소 빅데이터 분석에서 <strong>{일위.브랜드}</strong>가
    중고차 부문 <strong>2026년 9월 1위</strong>(브랜드평판지수 {일위.브랜드평판지수?.toLocaleString()})로
    나왔습니다. 2위는 {top5[1]?.브랜드}, 3위는 {top5[2]?.브랜드}입니다.
  </p>
  <p class="note">⚠ {자료.top5주}</p>

  <h2>업종 전체는 이 시리즈의 «중앙값»입니다</h2>
  <p>{실측.무엇}입니다.</p>
  <div class="warn">
    <p>
      중고 자동차 판매업 사업장 <strong>{실측.닫은곳.toLocaleString()}곳</strong>이 국민연금
      가입 자격을 잃었고(2026년 6월 기준), {실측.쓰는말}의 중앙값은{' '}
      <strong>{실측.수명중앙값_년}년</strong>입니다.{' '}
      <strong>{실측.일년내_퍼센트}%</strong>가 1년 안에, <strong>{실측.삼년내_퍼센트}%</strong>가
      3년 안에 이 명단에 들었습니다 — 이 시리즈의 안경원(5.9년)보다는 짧고, 화장품
      전문점(2.49년)보다는 길습니다.
    </p>
  </div>
  <p class="note">⚠ {실측.쓰면안되는말}</p>
  <p class="note">⚠ {실측.주의}</p>

  <h2>이 페이지가 말하지 않는 것</h2>
  <ul>
    {(자료.이자료가못가르는것 as string[]).map((s: string) => <li>{s}</li>)}
  </ul>
  <p class="note">
    ⚠ <strong></strong> 이 페이지는 두 공개 자료를 나란히
    {' '}놓아 보여줄 뿐, 어느 브랜드가 더 좋은지 판정하지 않습니다.
  </p>

  <h2>자주 묻는 말</h2>
  {jsonLd.mainEntity.map((q: any) => (
    <div class="note">
      <p><strong>{q.name}</strong></p>
      <p>{q.acceptedAnswer.text}</p>
    </div>
  ))}

  <p class="note">
    출처 — 브랜드평판: 한국기업평판연구소({순위출처.url}) · 실측: 국민연금공단 국민연금
    {' '}가입 사업장 내역(공공데이터포털 15083277)
  </p>

  <p class="note">
    <a href="/ranking-insurance-agency-brand">← 독립보험대리점(GA) 브랜드평판 1위, 보험 대리업 수명 중앙값은 이 시리즈에서 가장 긴 8.3년입니다</a>
    <br />
    <a href="/ranking-cosmetics-brand">← 화장품 전문점 브랜드평판 1위, 화장품 소매업 수명 중앙값은 2.49년입니다</a>
  </p>

  <HundredCardnews 벌="중고차판매업수명" 장수={5} 머리="이 페이지를 카드 다섯 장으로" />

  <HundredAgeWalk 키="ranking-usedcar-brand" />

  <NextQuestionBrief 모은것="한국기업평판연구소 중고차 브랜드평판 + 국민연금공단 가입 사업장 내역" />

  <h2>어떻게 생각하십니까</h2>
  <script src="/comments-widget.js" defer></script>
  <div data-comments-page="/ranking-usedcar-brand"></div>
</HundredYear>
