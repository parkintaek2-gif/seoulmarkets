---
/**
 * /100y/high-vocational-student-share-by-province — 특성화고에 다니는 학생 비중, 시도별 (2024 공시)
 *
 * 출처  NEIS 학교기본정보(고교유형) + 학교알리미 2024 공시 「학년별·학급별 학생수」 — src/lib/high-school-province.ts 가 학교 코드로 잇는다.
 *       이 쪽에서 한 일은 학생 수를 유형별·시도별로 더하고 나눈 것뿐이다.
 * 같은 소재의 /high-school-type-mix-by-province 는 «학교 수»로 센다. 이 페이지는 «학생 수»로 센다.
 * ⛔ 진학·취업 결과나 좋고 나쁨을 쓰지 않는다. 수만 적는다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import HundredAgeWalk from '../../../components/HundredAgeWalk.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import { 값있는, 못이은, 합, 묶기, 수, 퍼글 } from '../../../lib/high-school-students';

const 종류 = ['일반고', '특성화고', '자율고', '특목고'];
const 시도들 = [...묶기(값있는, (r) => r.시도).entries()]
  .filter(([k]) => k)
  .map(([이름, a]) => {
    const 학생 = 합(a, (r) => r.학생);
    const 유형별: Record<string, number> = {};
    for (const g of 종류) 유형별[g] = 합(a.filter((r) => r.유형 === g), (r) => r.학생);
    return { 이름, 곳: a.length, 학생, 유형별, 특성곳: a.filter((r) => r.유형 === '특성화고').length };
  })
  .sort((a, b) => b.유형별['특성화고'] / b.학생 - a.유형별['특성화고'] / a.학생);
const 전체학생 = 합(값있는, (r) => r.학생);
const 전체유형: Record<string, number> = {};
const 전체곳: Record<string, number> = {};
for (const g of 종류) {
  const a = 값있는.filter((r) => r.유형 === g);
  전체유형[g] = 합(a, (r) => r.학생);
  전체곳[g] = a.length;
}
const 특 = 전체유형['특성화고'];
const 맨위 = 시도들[0];
const 둘째 = 시도들[1];
const 맨아래 = 시도들[시도들.length - 1];
const 학생많은 = [...시도들].sort((a, b) => b.유형별['특성화고'] - a.유형별['특성화고'])[0];
const 특성화비 = (x: any) => 퍼글(x.유형별['특성화고'], x.학생);

const TITLE = `특성화고 학생 ${수(특)}명, 고등학교 학생 ${수(전체학생)}명의 ${퍼글(특, 전체학생)} — 시도별로 ${맨위.이름} ${특성화비(맨위)}, ${둘째.이름} ${특성화비(둘째)}`;
const desc = `학교알리미 2024 공시와 NEIS 고교유형으로 고등학교 학생 ${수(전체학생)}명을 일반고·특성화고·자율고·특목고로 나눠 시도별로 셌습니다. 특성화고 학생 비중이 가장 높은 시도는 ${맨위.이름} ${특성화비(맨위)}, 가장 낮은 시도는 ${맨아래.이름} ${특성화비(맨아래)}입니다.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: '특성화고 학생 비중 — 시도별',
    description: desc,
    creator: { '@type': 'Organization', name: '백년지도' },
    sourceOrganization: { '@type': 'Organization', name: '학교알리미(한국교육학술정보원)' },
    spatialCoverage: '대한민국 시·도',
    variableMeasured: ['고등학교 학생 수', '고교유형별 학생 수', '특성화고 학생 비중'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '특성화고에 다니는 학생은 고등학생의 몇 퍼센트인가요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `학교알리미 2024 공시로 셀 수 있는 고등학교 학생 ${수(전체학생)}명 가운데 특성화고 학생은 ${수(특)}명, ${퍼글(특, 전체학생)}입니다. 일반고는 ${수(전체유형['일반고'])}명(${퍼글(전체유형['일반고'], 전체학생)})입니다.`,
        },
      },
      {
        '@type': 'Question',
        name: '특성화고 학생 비중이 가장 높은 시도는 어디인가요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `${시도들.slice(0, 3).map((x) => `${x.이름} ${특성화비(x)}`).join(', ')} 순입니다. 학생 수로는 ${학생많은.이름}이 ${수(학생많은.유형별['특성화고'])}명으로 가장 많습니다.`,
        },
      },
    ],
  },
];
---

<HundredYear title={TITLE} description={desc} jsonLd={jsonLd}>
  <h1>특성화고에는 학생이<br class="pcbr" /> 얼마나 다닐까요</h1>
  <p class="sub">
    학교 수가 아니라 학생 수로 센 고교유형별 비중입니다. 학교알리미 2024 공시의 학생 수를 NEIS 고교유형(일반고·특성화고·자율고·특목고)으로 나눠 시도별로 더했습니다.
  </p>

  <div class="answer">
    <p class="answer-label">특성화고 학생 — 고등학교 학생 {수(전체학생)}명 가운데</p>
    <p class="answer-num">{수(특)}명 · {퍼글(특, 전체학생)}</p>
    <p class="answer-sub">일반고 {퍼글(전체유형['일반고'], 전체학생)} · 자율고 {퍼글(전체유형['자율고'], 전체학생)} · 특목고 {퍼글(전체유형['특목고'], 전체학생)}</p>
  </div>

  <h2>시도별 고교유형 학생 비중</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>시·도</th><th>학생</th><th>특성화고 학생</th><th>특성화고 비중</th><th>일반고</th><th>자율고</th><th>특목고</th></tr></thead>
      <tbody>
        {시도들.map((x) => (
          <tr>
            <th>{x.이름}</th>
            <td class="num">{수(x.학생)}명</td>
            <td class="num">{수(x.유형별['특성화고'])}명</td>
            <td class="num"><strong>{특성화비(x)}</strong></td>
            <td class="num">{퍼글(x.유형별['일반고'], x.학생)}</td>
            <td class="num">{퍼글(x.유형별['자율고'], x.학생)}</td>
            <td class="num">{퍼글(x.유형별['특목고'], x.학생)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">표는 특성화고 학생 비중이 높은 순입니다. 전남과 광주는 NEIS의 지역 구분대로 따로 셌습니다.</p>

  <h2>전국 고교유형별 학교와 학생</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>종류</th><th>학교</th><th>학생</th><th>학생 비중</th><th>학교당 학생</th></tr></thead>
      <tbody>
        {종류.map((g) => (
          <tr>
            <th>{g}</th>
            <td class="num">{수(전체곳[g])}곳</td>
            <td class="num">{수(전체유형[g])}명</td>
            <td class="num"><strong>{퍼글(전체유형[g], 전체학생)}</strong></td>
            <td class="num">{수(Math.round(전체유형[g] / 전체곳[g]))}명</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>같은 표에서 읽히는 것</h2>
  <ul>
    <li>특성화고 학생 비중이 가장 높은 시도는 {맨위.이름} {특성화비(맨위)}, 두 번째는 {둘째.이름} {특성화비(둘째)}입니다. 가장 낮은 시도는 {맨아래.이름} {특성화비(맨아래)}입니다.</li>
    <li>학생 수로는 {학생많은.이름}이 특성화고 {수(학생많은.유형별['특성화고'])}명으로 가장 많습니다.</li>
    <li>학교 수로 특성화고는 {수(전체곳['특성화고'])}곳이고 학교당 학생은 {수(Math.round(특 / 전체곳['특성화고']))}명, 일반고는 학교당 {수(Math.round(전체유형['일반고'] / 전체곳['일반고']))}명입니다.</li>
  </ul>

  <h2>⚠ 이 자료로 말할 수 없는 것</h2>
  <ul>
    <li>학교알리미 2024 공시의 학생 수입니다. NEIS의 현재 학교 목록과 학교 코드로 이었고, 잇지 못했거나 학생 수가 0으로 온 {수(못이은)}곳은 뺐습니다.</li>
    <li>유형은 NEIS 고교유형 칸 그대로입니다. 한 학교 안의 학과 구성은 이 자료에 없습니다.</li>
    <li>진학·취업 결과는 이 자료에 없습니다.</li>
    <li>학생 수는 재적 기준 공시값이며, 졸업·전학으로 지금과 다를 수 있습니다.</li>
  </ul>

  <p class="note">
    출처 — 학교알리미(한국교육학술정보원) 공개용데이터 「학년별·학급별 학생수」 2024 공시(공공누리 제1유형), NEIS 교육정보 개방 포털 학교기본정보 고등학교.
  </p>

  <p class="note">
    <a href="/high-school-type-mix-by-province">← 일반고·특성화고·자율고·특목고, 시도별(학교 수 기준)</a>
    <br />
    <a href="/vocational-high-school-by-area">→ 특성화고, 시군구별</a>
  </p>

  <HundredAgeWalk 키="high-vocational-student-share-by-province" />
  <NextQuestionBrief 모은것="학교알리미 고등학교 학생 수를 NEIS 고교유형으로 시도별 합산한 실측" />
</HundredYear>

<style>
  .num { text-align: right; font-variant-numeric: tabular-nums; }
</style>
