---
/**
 * /100y/elementary/area/ — 폴더 입구. 지역 지면 목록은 /elementary/ 한 곳이 하고 있어 거기로 보낸다.
 * ⛔ 새 목록 지면을 만들지 않는다(같은 말을 하는 지면이 둘이 되면 겹친 지면으로 읽힌다).
 * ⚠ 정적 빌드라 301 이 아니다. noindex 로 「여기 담지 마라」고 말하고 사이트맵에도 넣지 않는다.
 */
const 갈곳 = '/elementary/';
---
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0; url=${갈곳}`} />
    <link rel="canonical" href={`https://100yearmap.com${갈곳}`} />
    <title>초등학교 지역 지면 목록으로 넘어갑니다 — 백년지도</title>
  </head>
  <body>
    <a href={갈곳}>초등학교 지역 지면 목록으로 넘어갑니다 →</a>
    <script is:inline set:html={`location.replace(${JSON.stringify(갈곳)});`} />
  </body>
</html>
