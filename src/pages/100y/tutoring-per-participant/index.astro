---
/**
 * /100y/tutoring-per-participant — 사교육을 받는 학생만 놓으면 월 얼마인가 (2007~2025, 학교급별)
 *
 * 출처  KOSIS 101/DT_1PE301(참여율)·DT_1PE201(학생 1인당 월평균 사교육비) — private-tutoring.json.
 * 사교육비 표는 «받지 않는 학생도 포함한 전체 학생 평균»이다(/tutoring 의 설명 그대로).
 * 이 쪽에서 «사교육비 ÷ 참여율» 로 참여 학생 1인당 값을 환산했다. 통계청이 따로 발표한 참여학생 값과 맞춰 본 적은 없다.
 * ⛔ 조언·원인 추측은 싣지 않는다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import HundredAgeWalk from '../../../components/HundredAgeWalk.astro';
import 원본 from '../../../data/100yearmap/private-tutoring.json';

const 자료 = 원본 as any;
const 해들 = (Object.keys(자료.연도별) as string[]).sort((a, b) => Number(a) - Number(b));
const 처음 = 해들[0];
const 최신 = 해들[해들.length - 1];
const 급들 = [
  { 키: '전체', 이름: '전체' },
  { 키: '초등학교', 이름: '초등학교' },
  { 키: '중학교', 이름: '중학교' },
  { 키: '고등학교', 이름: '고등학교' },
];
const 참 = (y: string, k: string): number => 자료.연도별[y].참여율[k];
const 비 = (y: string, k: string): number => 자료.연도별[y].사교육비[k];
const 환산 = (y: string, k: string) => 비(y, k) / (참(y, k) / 100);
const 만원 = (n: number) => `${n.toFixed(1)}만원`;
const 퍼 = (n: number) => `${n.toFixed(1)}%`;
const 배 = (n: number) => `${n.toFixed(2)}배`;

const 고환산 = 환산(최신, '고등학교');
const 고평균 = 비(최신, '고등학교');
const 전환산 = 환산(최신, '전체');
const 초환산 = 환산(최신, '초등학교');
const 처음고환산 = 환산(처음, '고등학교');
const 최대해 = [...해들].sort((a, b) => 환산(b, '전체') - 환산(a, '전체'))[0];

const desc =
  `초중고사교육비조사(KOSIS) ${최신}년 고등학생 1인당 월평균 사교육비는 ${만원(고평균)}(받지 않는 학생 포함)이고, 참여율 ${퍼(참(최신, '고등학교'))}로 나눠 참여 학생만 놓으면 약 ${만원(고환산)}입니다. ` +
  `${처음}년에는 약 ${만원(처음고환산)}이었습니다. 학교급별 환산값을 ${처음}~${최신}년까지 계산했습니다.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: '사교육 참여 학생 1인당 월 환산액 — 초중고사교육비조사 학교급별',
  description: desc,
  dateModified: 자료.받은때,
  creator: { '@type': 'Organization', name: '백년지도' },
  sourceOrganization: { '@type': 'Organization', name: 자료.출처.이름 },
  isBasedOn: 'https://kosis.kr/statHtml/statHtml.do?orgId=101&tblId=DT_1PE201',
  variableMeasured: ['사교육 참여율', '학생 1인당 월평균 사교육비', '참여 학생 1인당 환산액'],
};
---

<HundredYear
  title={`사교육 받는 고등학생만 놓으면 월 약 ${만원(고환산)} — 전체 평균 ${만원(고평균)}의 ${배(고환산 / 고평균)} (${최신}년)`}
  description={desc}
  jsonLd={jsonLd}
>
  <h1>사교육을 받는 학생만 놓으면<br />월 얼마일까요</h1>
  <p class="sub">
    통계청 초중고사교육비조사의 월평균 사교육비는 받지 않는 학생까지 모두 넣어 나눈 값입니다. 같은 조사의 참여율로 이 값을 나누면 받는 학생만 놓은 금액이 됩니다. 이 쪽에서 계산한 환산값이고, 통계청이 따로 발표한 참여 학생 기준 값과 대조해 보지는 못했습니다.
  </p>

  <div class="answer">
    <p class="answer-label">{최신}년, 사교육 받는 고등학생 1인당 월 환산액</p>
    <p class="answer-num">약 {만원(고환산)}</p>
    <p class="answer-sub">전체 학생 평균 {만원(고평균)} ÷ 참여율 {퍼(참(최신, '고등학교'))} · {처음}년 약 {만원(처음고환산)}</p>
  </div>

  <h2>{최신}년, 학교급별</h2>
  <div class="tablewrap">
    <table>
      <thead>
        <tr><th>학교급</th><th>참여율</th><th>전체 학생 1인당 월평균</th><th>참여 학생만 환산</th></tr>
      </thead>
      <tbody>
        {급들.map((g) => (
          <tr>
            <td>{g.이름}</td>
            <td>{퍼(참(최신, g.키))}</td>
            <td>{만원(비(최신, g.키))}</td>
            <td><strong>약 {만원(환산(최신, g.키))}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">환산값 = 월평균 사교육비 ÷ (참여율 ÷ 100). 사교육비가 «받는 학생이 쓴 돈의 합 ÷ 전체 학생 수»라는 조건에서만 맞는 계산입니다.</p>

  <h2>{처음}년부터 {최신}년까지, 참여 학생 환산액</h2>
  <div class="tablewrap">
    <table>
      <thead>
        <tr><th>연도</th><th>전체</th><th>초등학교</th><th>중학교</th><th>고등학교</th></tr>
      </thead>
      <tbody>
        {[...해들].reverse().map((y) => (
          <tr>
            <td>{y}</td>
            {급들.map((g) => <td>{y === 최신 ? <strong>{만원(환산(y, g.키))}</strong> : 만원(환산(y, g.키))}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>같은 표에서 읽히는 것</h2>
  <ul>
    <li>{최신}년 환산액은 초등학교 약 {만원(초환산)}, 중학교 약 {만원(환산(최신, '중학교'))}, 고등학교 약 {만원(고환산)}으로, 학교급이 올라갈수록 큽니다. 반면 참여율은 초등학교 {퍼(참(최신, '초등학교'))}, 고등학교 {퍼(참(최신, '고등학교'))}로 학교급이 올라갈수록 낮습니다.</li>
    <li>{처음}년에는 환산액이 초등학교 약 {만원(환산(처음, '초등학교'))}, 중학교 약 {만원(환산(처음, '중학교'))}, 고등학교 약 {만원(처음고환산)}이었습니다. 고등학교와 초등학교의 차이는 {배(처음고환산 / 환산(처음, '초등학교'))}에서 {배(고환산 / 초환산)}로 바뀌었습니다.</li>
    <li>전체 학생 기준 평균과 참여 학생 환산액의 차이는 참여율이 낮을수록 벌어집니다. {최신}년 고등학교는 {배(고환산 / 고평균)}, 초등학교는 {배(초환산 / 비(최신, '초등학교'))}입니다.</li>
    <li>전체 환산액이 가장 컸던 해는 {최대해}년으로 약 {만원(환산(최대해, '전체'))}입니다. {최신}년은 약 {만원(전환산)}입니다.</li>
  </ul>

  <h2>⚠ 이 자료로 말할 수 없는 것</h2>
  <ul>
    <li>금액은 명목값입니다. 물가 변화를 빼지 않았습니다.</li>
    <li>이 쪽 환산값은 두 표의 값을 나눈 계산이며, 통계청이 발표한 «사교육 참여 학생 1인당 월평균» 값과 소수점이나 정의에서 다를 수 있습니다.</li>
    <li>참여 학생 안에서 금액이 얼마나 다른지(적게 쓰는 학생과 많이 쓰는 학생의 폭)는 평균 하나로는 알 수 없습니다.</li>
    <li>무엇에 쓴 돈인지(학원, 개인과외, 인터넷 강의 등)는 이 두 표에 없습니다.</li>
    <li>지역·소득별 값은 <a href="/tutoring-region">지역별</a>·<a href="/tutoring-income">소득별</a> 페이지에 따로 있습니다.</li>
  </ul>

  <p class="note">
    출처 — {자료.출처.이름} ({자료.출처.표.참여율} · {자료.출처.표.사교육비}). {처음}~{최신}년. 이용허락범위: {자료.출처.이용허락범위}. 받은 날 {자료.받은때}.
  </p>

  <p class="note">
    <a href="/tutoring">← 사교육 참여율·비용</a>
    <br />
    <a href="/tutoring-yearly-change">→ 사교육 참여율·비용 매년 증감</a>
  </p>

  <HundredAgeWalk 키="tutoring-per-participant" />
  <NextQuestionBrief 모은것="초중고사교육비조사 참여 학생 1인당 환산액" />
</HundredYear>
