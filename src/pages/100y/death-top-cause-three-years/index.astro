---
/**
 * /100y/death-top-cause-three-years — 사망원인 1위 3년 비교 (롱테일, 축 「나이대별 사망원인」 death-causes 에 딸림)
 *
 * ── 왜 만들었나 (2026-11-14 · 1번) ──────────────
 * death-causes 지면은 남녀 합계 1~5위만 낸다. 같은 원표(KOSIS DT_1B34E20)에 있는
 * 남자·여자 칸과 2023~2025 세 해를 나이대로 갈라 낸다. 숫자는 death-causes-by-age.json 에서 그대로 옮긴다.
 *
 * ⛔ 까닭을 지어내지 않는다. ⛔ 「10위 밖」은 0 이 아니라 «원표가 그 칸을 내지 않음»이다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import 원본 from '../../../data/100yearmap/death-causes-by-age.json';

const 자료 = 원본 as any;
const 칸들 = 자료.칸들 as any[];
const 열살 = ['0세', '1-9세', '10-19세', '20-29세', '30-39세', '40-49세', '50-59세', '60-69세', '70-79세', '80세 이상'];
const 수 = (n: number | null | undefined) => (n == null ? '—' : n.toLocaleString('ko-KR', { maximumFractionDigits: 1 }));
const 쉬운말 = (s: string) => String(s ?? '').replace(/고의적 자해\(자살\)/g, '스스로 목숨을 끊음').replace('알쯔하이머병', '알츠하이머병');
const 찾 = (해: number, 성: string, 나이: string, 원인: string) => 칸들.find((x) => x.해 === 해 && x.성 === 성 && x.나이 === 나이 && x.사망원인 === 원인);
const 출처 = '국가데이터처 사망원인통계(KOSIS DT_1B34E20 「연령대별 사망원인」), 잰날 ' + 자료._메모.잰날;

const 해들 = [2023, 2024, 2025];
const 성들 = ['계', '남자', '여자'];
const 줄들 = 열살.flatMap((나이) => 성들.map((성) => {
  const 원인 = 해들.map((해) => 칸들.find((x) => x.해 === 해 && x.성 === 성 && x.나이 === 나이 && x.순위 === 1));
  const 같음 = 원인.every((c) => c && c.사망원인 === 원인[0]!.사망원인);
  return { 나이, 성, 원인, 같음 };
}));
const 같은수 = 줄들.filter((r) => r.같음).length;
const 다른줄 = 줄들.filter((r) => !r.같음);
const TITLE = '사망원인 1위 3년 비교 2023~2025 — 나이대·성별';
const desc = `2023~2025년 사망원인통계에서 열 살 단위 ${열살.length}개 나이대를 남녀 합계·남자·여자로 나눈 ${줄들.length}칸 가운데 1위가 3년 내내 같은 칸은 ${같은수}칸, 바뀐 칸은 ${다른줄.length}칸입니다.`;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Dataset', name: TITLE, description: desc, creator: { '@type': 'GovernmentOrganization', name: '국가데이터처' }, isBasedOn: 'https://kosis.kr/statHtml/statHtml.do?orgId=101&tblId=DT_1B34E20', temporalCoverage: '2023/2025' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [{ '@type': 'Question', name: '나이대별 사망원인 1위는 해마다 바뀌나요?', acceptedAnswer: { '@type': 'Answer', text: `2023~2025년 ${줄들.length}칸(열 살 단위 나이대 × 남녀 합계·남자·여자) 가운데 ${같은수}칸은 3년 내내 같고 ${다른줄.length}칸은 바뀌었습니다.` } }] },
];
---

<HundredYear title={TITLE} description={desc} jsonLd={jsonLd}>
  <h1>사망원인 1위, 3년 새 바뀌었나 —<br class="pcbr" /> 나이대·성별 2023~2025</h1>
  <p class="sub">「해마다 같은 이유가 1위인가?」 열 살 단위 나이대를 남녀 합계·남자·여자로 나눈 {줄들.length}칸의 1위를 세 해 나란히 놓았습니다.</p>

  <div class="answer">
    <p class="answer-label">2023~2025 · 1위가 3년 내내 같은 칸</p>
    <p class="answer-num">{같은수}칸 / {줄들.length}칸</p>
    <p class="answer-sub">바뀐 칸 {다른줄.length}칸은 아래 표에 따로 모았습니다</p>
  </div>

  {다른줄.length > 0 && (
    <>
      <h2>1위가 바뀐 칸</h2>
      <div class="tablewrap scroll">
        <table>
          <thead><tr><th>나이대</th><th>구분</th><th>2023</th><th>2024</th><th>2025</th></tr></thead>
          <tbody>
            {다른줄.map((r) => (
              <tr><th>{r.나이}</th><td>{r.성 === '계' ? '남녀 합계' : r.성}</td>{r.원인.map((c) => <td>{c ? 쉬운말(c.사망원인) : '—'}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  <h2>{줄들.length}칸 전체</h2>
  <div class="tablewrap scroll">
    <table>
      <thead><tr><th>나이대</th><th>구분</th><th>2023</th><th>2024</th><th>2025</th></tr></thead>
      <tbody>
        {줄들.map((r) => (
          <tr><th>{r.나이}</th><td>{r.성 === '계' ? '남녀 합계' : r.성}</td>{r.원인.map((c) => <td>{c ? `${쉬운말(c.사망원인)} ${수(c.사망률)}` : '—'}</td>)}</tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">칸 안 숫자는 인구 10만 명당 사망률입니다. 1위와 2위 차이가 작은 칸은 한 해 사이에 차례가 쉽게 바뀝니다.</p>

  <h2>같은 자료로 본 다른 표</h2>
  <ul>
    <li><a href="/death-causes">나이대별 사망원인 1~5위</a></li>
    <li><a href="/death-causes-by-sex">나이대별 남자·여자 사망원인 1~3위</a></li>
    <li><a href="/pneumonia-alzheimer-death-by-age">폐렴·알츠하이머병 사망 나이대별</a></li>
  </ul>

  <aside class="help">
    <h2>혼자 견디지 마십시오</h2>
    <p>이 표에는 스스로 목숨을 끊은 사람 수가 들어 있습니다. 마음이 힘들 때 기댈 곳이 있습니다.</p>
    <ul>
      <li><b>자살예방 상담전화 <a href="tel:109">109</a></b> — 24시간, 무료</li>
      <li><b>정신건강 상담전화 <a href="tel:1577-0199">1577-0199</a></b> — 24시간</li>
    </ul>
  </aside>

  <h2>이 숫자를 어떻게 읽어야 하나요?</h2>
  <ul>
    <li><strong>이것은 통계이지 당신이 아닙니다.</strong> 한 해 동안 그 나이대에서 있었던 일을 센 값이며, 어느 개인에게 일어날 일을 말하지 않습니다.</li>
    <li>사망률은 그 나이대 인구 10만 명당 사망자 수입니다. 나이대마다 사람 수가 달라 나이대끼리는 사망률로 견줍니다.</li>
    <li>차례가 바뀐 것은 그 원인이 늘거나 줄었다는 뜻이 아닙니다. 옆자리와 차이가 작으면 작은 변화로도 자리가 바뀝니다.</li>
  </ul>
  <h2>이 숫자는 어디서 왔나요?</h2>
  <p class="note">{출처} · 2025년 확정 통계 기준 · 「—」는 원표가 그 칸을 내지 않았다는 뜻이며 0명이 아닙니다.</p>

  <NextQuestionBrief 모은것="국가데이터처 사망원인통계 원표로 나이대·성별 칸마다 2023~2025년 사망원인 1위를 나란히 놓은 표" />
</HundredYear>

<style>
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .scroll { overflow-x: auto; }
  .help { background: #f4f8f4; border: 1px solid #d9e6d9; border-radius: .6rem; padding: 1rem 1.2rem; margin: 2rem 0; }
</style>
