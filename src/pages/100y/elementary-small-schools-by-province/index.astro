---
/**
 * /100y/elementary-small-schools-by-province — 학생 60명 이하 초등학교, 시도별·시군구별 (2024 공시)
 *
 * 출처  학교알리미 공개용데이터 「학년별·학급별 학생수」 2024 공시 초등학교 — src/data/100yearmap/class-size-elementary.json
 *       (학교별 학생 수가 들어 있다). 이 쪽에서 한 일은 학생 60명 이하인 학교를 시도·시군구로 센 것뿐이다.
 * ⛔ 「폐교 위기」「소멸」 같은 말을 쓰지 않는다. 학생 수가 적다는 사실만 적는다.
 * ⛔ 원인 추측·조언은 싣지 않는다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import HundredAgeWalk from '../../../components/HundredAgeWalk.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import 원본 from '../../../data/100yearmap/class-size-elementary.json';

const 자료 = 원본 as any;
const 기준 = 60;
const 수 = (n: number) => Number(n).toLocaleString('ko-KR');
const 퍼 = (a: number, b: number) => (b ? (a / b) * 100 : 0);
const 퍼글 = (a: number, b: number) => `${퍼(a, b).toFixed(1)}%`;
const 최소학교수 = 5;

const 학교들 = (자료.자료 as any[]).filter((r) => Number.isFinite(r.학생)).map((r) => ({ ...r, 시도: r.시도 === '전라남도' ? '전남광주통합특별시' : r.시도 }));
const 작은가 = (r: any) => r.학생 <= 기준;
const 시도맵 = new Map<string, { 이름: string; 학교수: number; 작은곳: number; 학생: number }>();
const 구맵 = new Map<string, { 시도: string; 구: string; 학교수: number; 작은곳: number }>();
for (const r of 학교들) {
  const a = 시도맵.get(r.시도) ?? { 이름: r.시도, 학교수: 0, 작은곳: 0, 학생: 0 };
  a.학교수 += 1; a.학생 += r.학생; if (작은가(r)) a.작은곳 += 1;
  시도맵.set(r.시도, a);
  const k = `${r.시도} ${r.구}`;
  const b = 구맵.get(k) ?? { 시도: r.시도, 구: r.구, 학교수: 0, 작은곳: 0 };
  b.학교수 += 1; if (작은가(r)) b.작은곳 += 1;
  구맵.set(k, b);
}
const 시도들 = [...시도맵.values()].sort((a, b) => 퍼(b.작은곳, b.학교수) - 퍼(a.작은곳, a.학교수));
const 전체학교 = 학교들.length;
const 전체작은곳 = 학교들.filter(작은가).length;
const 곳들 = [...구맵.values()].filter((r) => r.학교수 >= 최소학교수).sort((a, b) => 퍼(b.작은곳, b.학교수) - 퍼(a.작은곳, a.학교수) || b.작은곳 - a.작은곳);
const 높은쪽 = 곳들.slice(0, 15);
const 없는곳 = 곳들.filter((r) => r.작은곳 === 0).length;
const 빠진곳 = 구맵.size - 곳들.length;
const 맨위 = 시도들[0];
const 둘째 = 시도들[1];
const 맨아래 = 시도들[시도들.length - 1];
const 많은시도 = [...시도들].sort((a, b) => b.작은곳 - a.작은곳)[0];
const 구간 = [['학생 30명 이하', 0, 30], ['31~60명', 31, 60], ['61~100명', 61, 100], ['101~300명', 101, 300], ['301~600명', 301, 600], ['601명 이상', 601, 99999]];
const 구간수 = 구간.map(([이름, 낮, 높]: any) => ({ 이름, n: 학교들.filter((r) => r.학생 >= 낮 && r.학생 <= 높).length }));
const 학교별중간 = (() => { const s = 학교들.map((r) => r.학생).sort((a, b) => a - b); return s[Math.floor(s.length / 2)]; })();

const TITLE = `학생 ${기준}명 이하 초등학교 ${수(전체작은곳)}곳, 전체의 ${퍼글(전체작은곳, 전체학교)} — 시도별로 ${맨위.이름} ${퍼글(맨위.작은곳, 맨위.학교수)}, ${둘째.이름} ${퍼글(둘째.작은곳, 둘째.학교수)}`;
const desc =
  `학교알리미 ${자료.출처.공시연도}년 공시의 초등학교 ${수(전체학교)}곳 가운데 학생이 ${기준}명 이하인 학교는 ${수(전체작은곳)}곳(${퍼글(전체작은곳, 전체학교)})입니다. 비중이 가장 높은 시도는 ${맨위.이름} ${퍼글(맨위.작은곳, 맨위.학교수)}, 가장 낮은 시도는 ${맨아래.이름}으로 ${수(맨아래.작은곳)}곳입니다. 학교별 학생 수의 가운데값은 ${수(학교별중간)}명입니다.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: '학생 60명 이하 초등학교 — 시도·시군구별 학교 수와 비중',
    description: desc,
    dateModified: 자료.통계.받은때,
    creator: { '@type': 'Organization', name: '백년지도' },
    sourceOrganization: { '@type': 'Organization', name: 자료.출처.이름 },
    spatialCoverage: '대한민국 시·도, 시·군·구',
    variableMeasured: ['초등학교 수', '학생 수', '학생 60명 이하 학교 수'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '학생이 60명 이하인 초등학교는 몇 곳인가요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `학교알리미 ${자료.출처.공시연도}년 공시를 이은 초등학교 ${수(전체학교)}곳 가운데 ${수(전체작은곳)}곳(${퍼글(전체작은곳, 전체학교)})입니다. 개수가 가장 많은 시도는 ${많은시도.이름} ${수(많은시도.작은곳)}곳입니다.`,
        },
      },
      {
        '@type': 'Question',
        name: '학생 60명 이하 초등학교 비중이 가장 높은 시도는 어디인가요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `${시도들.slice(0, 3).map((x) => `${x.이름} ${퍼글(x.작은곳, x.학교수)}`).join(', ')} 순으로 높고, 가장 낮은 시도는 ${맨아래.이름}(${수(맨아래.작은곳)}곳)입니다.`,
        },
      },
    ],
  },
];
---

<HundredYear title={TITLE} description={desc} jsonLd={jsonLd}>
  <h1>학생이 60명 이하인 초등학교는<br class="pcbr" /> 어느 시도에 얼마나 있나요</h1>
  <p class="sub">
    학교알리미가 공개한 {자료.출처.공시연도}년 공시에서 초등학교 {수(전체학교)}곳의 학생 수를 학교별로 보고, 60명 이하인 학교를 시도와 시군구로 셌습니다.
  </p>

  <div class="answer">
    <p class="answer-label">학생 60명 이하 초등학교 — 공시를 이은 {수(전체학교)}곳 가운데</p>
    <p class="answer-num">{수(전체작은곳)}곳 · {퍼글(전체작은곳, 전체학교)}</p>
    <p class="answer-sub">학교별 학생 수 가운데값 {수(학교별중간)}명 · 시도 {시도들.length}곳 · 가장 많은 시도 {많은시도.이름} {수(많은시도.작은곳)}곳</p>
  </div>

  <p>
    ⚠ <strong>60명은 이 페이지에서 정한 기준입니다.</strong> 법이나 공표 통계의 구분이 아니라, 학교별 학생 수를 한눈에 가르려고 잡은 선입니다. 다른 선을 쓰면 수가 달라집니다.
  </p>

  <h2>시도별 학생 60명 이하 초등학교</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>시·도</th><th>초등학교</th><th>60명 이하</th><th>비중</th></tr></thead>
      <tbody>
        {시도들.map((x) => (
          <tr>
            <th>{x.이름}</th>
            <td class="num">{수(x.학교수)}곳</td>
            <td class="num">{수(x.작은곳)}곳</td>
            <td class="num"><strong>{퍼글(x.작은곳, x.학교수)}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>비중이 높은 시군구 15곳</h2>
  <p class="note">초등학교가 {최소학교수}곳 이상인 시군구 {곳들.length}곳 가운데입니다. 그보다 적은 {빠진곳}곳은 표에서 뺐습니다. 60명 이하 학교가 한 곳도 없는 시군구는 {수(없는곳)}곳입니다.</p>
  <div class="tablewrap">
    <table>
      <thead><tr><th>지역</th><th>초등학교</th><th>60명 이하</th><th>비중</th></tr></thead>
      <tbody>
        {높은쪽.map((r) => (
          <tr>
            <th>{r.시도} {r.구}</th>
            <td class="num">{r.학교수}곳</td>
            <td class="num">{r.작은곳}곳</td>
            <td class="num"><strong>{퍼글(r.작은곳, r.학교수)}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>학교 규모별 초등학교 수</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>학생 수</th><th>학교</th><th>몫</th></tr></thead>
      <tbody>
        {구간수.map((x) => (
          <tr>
            <th>{x.이름}</th>
            <td class="num">{수(x.n)}곳</td>
            <td class="num">{퍼글(x.n, 전체학교)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>같은 표에서 읽히는 것</h2>
  <ul>
    <li>비중이 가장 높은 시도는 {맨위.이름} {퍼글(맨위.작은곳, 맨위.학교수)}({수(맨위.작은곳)}곳), 두 번째는 {둘째.이름} {퍼글(둘째.작은곳, 둘째.학교수)}입니다. 가장 낮은 시도는 {맨아래.이름}으로 {수(맨아래.작은곳)}곳입니다.</li>
    <li>개수로는 {많은시도.이름}이 {수(많은시도.작은곳)}곳으로 가장 많습니다.</li>
    <li>시군구 {곳들.length}곳 가운데 비중이 가장 높은 곳은 {높은쪽[0].시도} {높은쪽[0].구} {퍼글(높은쪽[0].작은곳, 높은쪽[0].학교수)}입니다.</li>
  </ul>

  <h2>⚠ 이 자료로 말할 수 없는 것</h2>
  <ul>
    <li>학교알리미 공시를 이은 초등학교는 {수(자료.통계.학교수)}곳이고, NEIS 학교 목록 {수(자료.통계.우리학교수)}곳 가운데 {수(자료.통계.못이은것)}곳은 이어지지 않아 빠졌습니다. 이 {수(자료.통계.못이은것)}곳은 「자료 없음」입니다.</li>
    <li>분교와 본교를 따로 센 공시인지는 확인하지 못했습니다.</li>
    <li>공시에 시도가 「전라남도」로 적힌 학교 1곳은 전남광주통합특별시에 더했습니다.</li>
    <li>학생 수가 적은 이유(학령인구, 지역 인구 변화 등)와 앞으로 어떻게 되는지는 이 자료에 없습니다.</li>
    <li>학교 안에서 학년마다 다른 학생 수는 이 표에 없습니다.</li>
  </ul>

  <p class="note">
    출처 — {자료.출처.이름} 「{자료.출처.공시항목}」 {자료.출처.공시연도}년 공시, 초등학교. 이용허락범위: {자료.출처.이용허락범위}. 받은 날 {자료.통계.받은때}.
  </p>

  <p class="note">
    <a href="/elementary-class-size-by-province">← 초등학교 학급당 학생 수 시도별</a>
    <br />
    <a href="/elementary">→ 우리 동네 초등학교</a>
  </p>

  <HundredAgeWalk 키="elementary-small-schools-by-province" />
  <NextQuestionBrief 모은것="학교알리미 초등학교 학생 수 공시를 시도·시군구로 센 실측" />
</HundredYear>

<style>
  .num { text-align: right; font-variant-numeric: tabular-nums; }
</style>
