---
/**
 * /100y/middle-single-sex-by-province — 남중·여중·남녀공학 중학교, 시도별·시군구별
 *
 * 출처  NEIS 교육정보 개방 포털 학교기본정보 — src/data/100yearmap/middle.json (시군구별 남중·여중·공학 수가 이미 들어 있다).
 *       이 쪽에서 한 일은 시도로 더하고 비중을 계산한 것뿐이다. 지금 문을 연 중학교만 있다.
 * ⛔ 「남녀공학이 낫다」「남중이 낫다」 같은 판단을 쓰지 않는다. 수만 적는다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import HundredAgeWalk from '../../../components/HundredAgeWalk.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import 원본 from '../../../data/100yearmap/middle.json';

const 자료 = 원본 as any;
const 수 = (n: number) => Number(n).toLocaleString('ko-KR');
const 퍼 = (a: number, b: number) => (b ? (a / b) * 100 : 0);
const 퍼글 = (a: number, b: number) => `${퍼(a, b).toFixed(1)}%`;
const 최소학교수 = 5;

const 시도맵 = new Map<string, { 이름: string; 곳: number; 남중: number; 여중: number; 공학: number }>();
for (const r of 자료.지역 as any[]) {
  const a = 시도맵.get(r.시도) ?? { 이름: r.시도, 곳: 0, 남중: 0, 여중: 0, 공학: 0 };
  a.곳 += r.곳; a.남중 += r.남중; a.여중 += r.여중; a.공학 += r.공학;
  시도맵.set(r.시도, a);
}
const 나뉜 = (x: any) => x.남중 + x.여중;
const 시도들 = [...시도맵.values()].sort((a, b) => 퍼(나뉜(b), b.곳) - 퍼(나뉜(a), a.곳));
const 전체 = 시도들.reduce((s, x) => ({ 곳: s.곳 + x.곳, 남중: s.남중 + x.남중, 여중: s.여중 + x.여중, 공학: s.공학 + x.공학 }), { 곳: 0, 남중: 0, 여중: 0, 공학: 0 });
const 곳들 = (자료.지역 as any[]).filter((r) => r.곳 >= 최소학교수).sort((a, b) => 퍼(나뉜(b), b.곳) - 퍼(나뉜(a), a.곳) || 나뉜(b) - 나뉜(a));
const 높은쪽 = 곳들.slice(0, 15);
const 빠진곳 = (자료.지역 as any[]).length - 곳들.length;
const 공학만인곳 = 곳들.filter((r) => 나뉜(r) === 0).length;
const 맨위 = 시도들[0];
const 둘째 = 시도들[1];
const 맨아래 = 시도들[시도들.length - 1];
const 많은시도 = [...시도들].sort((a, b) => 나뉜(b) - 나뉜(a))[0];

const TITLE = `남중·여중 ${수(나뉜(전체))}곳, 중학교 ${수(전체.곳)}곳의 ${퍼글(나뉜(전체), 전체.곳)} — 시도별로 ${맨위.이름} ${퍼글(나뉜(맨위), 맨위.곳)}, ${둘째.이름} ${퍼글(나뉜(둘째), 둘째.곳)}`;
const desc =
  `NEIS 학교기본정보로 중학교 ${수(전체.곳)}곳을 남중 ${수(전체.남중)}곳, 여중 ${수(전체.여중)}곳, 남녀공학 ${수(전체.공학)}곳으로 셌습니다. 남중·여중을 합친 비중이 가장 높은 시도는 ${맨위.이름} ${퍼글(나뉜(맨위), 맨위.곳)}입니다. 가장 낮은 시도는 ${맨아래.이름}(${수(나뉜(맨아래))}곳)입니다.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: '남중·여중·남녀공학 중학교 수 — 시도·시군구별',
    description: desc,
    creator: { '@type': 'Organization', name: '백년지도' },
    sourceOrganization: { '@type': 'Organization', name: 'NEIS 교육정보 개방 포털' },
    spatialCoverage: '대한민국 시·도, 시·군·구',
    variableMeasured: ['중학교 수', '남중 수', '여중 수', '남녀공학 수'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '남중·여중은 전국에 몇 곳인가요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `NEIS 기준 중학교 ${수(전체.곳)}곳 가운데 남중 ${수(전체.남중)}곳, 여중 ${수(전체.여중)}곳이고 나머지 ${수(전체.공학)}곳은 남녀공학입니다. 남중·여중을 합치면 ${퍼글(나뉜(전체), 전체.곳)}입니다.`,
        },
      },
      {
        '@type': 'Question',
        name: '남중·여중 비중이 가장 높은 시도는 어디인가요?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `${시도들.slice(0, 3).map((x) => `${x.이름} ${퍼글(나뉜(x), x.곳)}`).join(', ')} 순입니다. 개수로는 ${많은시도.이름}이 ${수(나뉜(많은시도))}곳으로 가장 많습니다.`,
        },
      },
    ],
  },
];
---

<HundredYear title={TITLE} description={desc} jsonLd={jsonLd}>
  <h1>남중·여중은 어느 시도에<br class="pcbr" /> 얼마나 있나요</h1>
  <p class="sub">
    NEIS 학교기본정보에서 중학교 {수(전체.곳)}곳의 남녀공학 구분을 시도와 시군구로 더했습니다.
  </p>

  <div class="answer">
    <p class="answer-label">남중·여중 — 중학교 {수(전체.곳)}곳 가운데</p>
    <p class="answer-num">{수(나뉜(전체))}곳 · {퍼글(나뉜(전체), 전체.곳)}</p>
    <p class="answer-sub">남중 {수(전체.남중)}곳 · 여중 {수(전체.여중)}곳 · 남녀공학 {수(전체.공학)}곳</p>
  </div>

  <h2>시도별 남중·여중·남녀공학 중학교</h2>
  <div class="tablewrap">
    <table>
      <thead><tr><th>시·도</th><th>중학교</th><th>남중</th><th>여중</th><th>남녀공학</th><th>남중·여중 비중</th></tr></thead>
      <tbody>
        {시도들.map((x) => (
          <tr>
            <th>{x.이름}</th>
            <td class="num">{수(x.곳)}곳</td>
            <td class="num">{수(x.남중)}</td>
            <td class="num">{수(x.여중)}</td>
            <td class="num">{수(x.공학)}</td>
            <td class="num"><strong>{퍼글(나뉜(x), x.곳)}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>남중·여중 비중이 높은 시군구 15곳</h2>
  <p class="note">중학교가 {최소학교수}곳 이상인 시군구 {곳들.length}곳 가운데입니다. 그보다 적은 {빠진곳}곳은 표에서 뺐습니다. 남중·여중이 한 곳도 없는 시군구는 {수(공학만인곳)}곳입니다.</p>
  <div class="tablewrap">
    <table>
      <thead><tr><th>지역</th><th>중학교</th><th>남중</th><th>여중</th><th>비중</th></tr></thead>
      <tbody>
        {높은쪽.map((r) => (
          <tr>
            <th>{r.시도} {r.구}</th>
            <td class="num">{r.곳}곳</td>
            <td class="num">{r.남중}</td>
            <td class="num">{r.여중}</td>
            <td class="num"><strong>{퍼글(나뉜(r), r.곳)}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>같은 표에서 읽히는 것</h2>
  <ul>
    <li>비중이 가장 높은 시도는 {맨위.이름} {퍼글(나뉜(맨위), 맨위.곳)}({수(나뉜(맨위))}곳), 두 번째는 {둘째.이름} {퍼글(나뉜(둘째), 둘째.곳)}입니다.</li>
    <li>가장 낮은 시도는 {맨아래.이름}입니다. 남중·여중은 {수(나뉜(맨아래))}곳, 중학교는 {수(맨아래.곳)}곳입니다.</li>
    <li>개수로는 {많은시도.이름}이 {수(나뉜(많은시도))}곳으로 가장 많습니다.</li>
  </ul>

  <h2>⚠ 이 자료로 말할 수 없는 것</h2>
  <ul>
    <li>NEIS에 올라 있는 중학교만 셉니다. 각종학교 {수(38)}곳과 방송통신중학교 {수(24)}곳은 섞지 않았습니다.</li>
    <li>학교 이름에 남중·여중이 있어도 NEIS의 구분과 다를 수 있는지는 확인하지 못했습니다.</li>
    <li>남녀공학 비중이 높고 낮은 이유는 이 자료에 없습니다.</li>
    <li>학생 수나 학업 결과는 이 자료에 없습니다.</li>
  </ul>

  <p class="note">
    출처 — NEIS 교육정보 개방 포털 학교기본정보, 중학교. 2026년 기준, 문을 연 학교만. 지역 수 {수(자료.지역수)}곳.
  </p>

  <p class="note">
    <a href="/private-middle-school-by-province">← 사립 중학교 몫 시도별</a>
    <br />
    <a href="/middle">→ 우리 동네 중학교</a>
  </p>

  <HundredAgeWalk 키="middle-single-sex-by-province" />
  <NextQuestionBrief 모은것="NEIS 중학교 학교기본정보를 시도·시군구로 센 실측" />
</HundredYear>

<style>
  .num { text-align: right; font-variant-numeric: tabular-nums; }
</style>
