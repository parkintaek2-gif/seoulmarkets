---
/**
 * /100y/career-aspiration-gap — 성적이 비슷해도 희망 직업이 갈리나 (축 「진로와 직업」)
 *
 * ── 왜 만들었나 (2026-11-15 · 5번) ──────────────
 * 사장님이 이 주제를 백년지도 콘텐트로 하라고 짚어 주셨다.
 * 한국교육개발원 기본연구 RR2026-02 (연구책임자 김슬기, 2026-10-31)를
 * 연구보고서 목록에서 직접 확인했다 — 기사 이름만 보고 적지 않았다.
 *
 * ⛔ 까닭을 지어내지 않는다. 보고서가 적은 값과 «우리가 뺀 값»을 갈라 적는다.
 * ⛔ 「이렇게 하세요」로 쓰지 않는다. 숫자를 놓고 읽는 사람이 정한다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import 원본 from '../../../data/100yearmap/career-aspiration-gap.json';

const 자료 = 원본 as any;
const 메모 = 자료._메모;
const 지수 = 자료.기대직업지위지수격차 as any[];
const 경험 = 자료.진로교육경험;
/**
 * 🔴🔴 [2026-11-15 12:4x · 5번] **내가 뺀 값이 보고서가 적은 값을 덮었다.**
 *   63.1 - 40.8 은 22.3 이지만 보고서는 그 칸을 **22.2** 로 적었다.
 *   원자료에 소수 둘째 자리가 있어 갈린 것이다. 지면에는 22.3 이 찍혔고,
 *   바로 아랫줄에는 「보고서가 직접 적은 값은 22.2」라고 적혀 있었다 — 저희끼리 어긋났다.
 * ⇒ **보고서가 적은 값이 있으면 그것을 쓴다.** 뺄셈은 보고서에 값이 없을 때만 쓴다.
 *   ⭐ 틀린 숫자 하나가 옳은 나머지를 같이 의심받게 한다.
 */
const 칸들 = (경험.칸들 as any[]).map((c) => ({
  ...c,
  차이: c.보고서가적은차이 ?? Math.round((c.상위 - c.하위) * 10) / 10,
}));
const 가장큰 = [...칸들].sort((a, b) => b.차이 - a.차이)[0];
const 가장작은 = [...칸들].sort((a, b) => a.차이 - b.차이)[0];
const 수 = (n: number | null | undefined) => (n == null ? '—' : n.toLocaleString('ko-KR', { maximumFractionDigits: 2 }));
const 사람수 = 경험.사람수.toLocaleString('ko-KR');

const TITLE = '성적이 비슷해도 희망 직업이 갈리나';
const desc = `한국교육개발원 ${메모.원자료.match(/RR\d{4}-\d{2}/)?.[0] ?? '연구보고서'}가 PISA 2018·2022 한국 학생 자료로 잰 값입니다. 부모의 사회경제적 지위 상위 25%와 하위 25% 학생의 기대 직업지위 지수 격차는 2018년 ${수(지수[0].격차)}점, 2022년 ${수(지수[1].격차)}점이었습니다. 진로 탐색 경험에서는 「${가장큰.무엇}」이 ${수(가장큰.상위)}%와 ${수(가장큰.하위)}%로 ${수(가장큰.차이)}%포인트 벌어졌습니다.`;

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Dataset', name: TITLE, description: desc,
    creator: { '@type': 'Organization', name: '한국교육개발원' },
    isBasedOn: 메모.목록주소, temporalCoverage: '2018/2022',
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question', name: '성적이 비슷하면 희망 직업도 비슷한가요?',
        acceptedAnswer: { '@type': 'Answer', text: `한국교육개발원 RR2026-02 는 읽기·수학·과학 학업성취도가 비슷한 학생끼리 견주었을 때에도 부모의 사회경제적 지위에 따라 기대 직업지위 지수가 갈렸다고 적었습니다. 상위 25%와 하위 25%의 격차는 2018년 ${수(지수[0].격차)}점, 2022년 ${수(지수[1].격차)}점입니다.` },
      },
      {
        '@type': 'Question', name: '진로 탐색 경험은 얼마나 다른가요?',
        acceptedAnswer: { '@type': 'Answer', text: `PISA 2018 한국 학생 ${사람수}명을 본 결과, 대학 교육과정 정보를 인터넷에서 검색한 적이 있는 학생은 부모 사회경제적 지위 상위 25%에서 ${수(칸들[0].상위)}%, 하위 25%에서 ${수(칸들[0].하위)}%였습니다. 차이는 ${수(칸들[0].차이)}%포인트입니다.` },
      },
      {
        '@type': 'Question', name: '학교에 진로상담사가 있으면 격차가 줄어드나요?',
        acceptedAnswer: { '@type': 'Answer', text: '보고서는 학교에 누가 진로지도를 맡는지, 진로상담사가 배치되어 있는지는 부모의 사회경제적 지위에 따라 큰 차이가 없었다고 적었습니다. 차이가 난 것은 배치 여부가 아니라 학생이 실제로 상담을 받거나 정보를 찾아본 경험이었습니다.' },
      },
    ],
  },
];
---

<HundredYear title={TITLE} description={desc} jsonLd={jsonLd}>
  <h1>성적이 비슷해도 —<br class="pcbr" /> 희망 직업이 갈리나</h1>
  <p class="sub">「나만 이런가?」 같은 점수를 받은 학생끼리 견주었을 때 집에 따라 꿈꾸는 직업이 달라지는지, 원표 그대로 놓았습니다.</p>

  <div class="answer">
    <p class="answer-label">부모 사회경제적 지위 상위 25%와 하위 25% · 기대 직업지위 지수 차이</p>
    <p class="answer-num">{수(지수[1].격차)}점</p>
    <p class="answer-sub">2022년 값입니다 · 2018년에는 {수(지수[0].격차)}점이었습니다 · 읽기·수학·과학 성적이 비슷한 학생끼리 견주었을 때도 차이가 남았습니다</p>
  </div>

  <h2>해마다 얼마나 벌어져 있었나</h2>
  <div class="tablewrap scroll">
    <table>
      <thead><tr><th>조사 해</th><th>상위 25%와 하위 25%의 기대 직업지위 지수 차이</th></tr></thead>
      <tbody>
        {지수.map((r) => (<tr><th>{r.해}년</th><td class="num">{수(r.격차)}점</td></tr>))}
      </tbody>
    </table>
  </div>
  <p class="note">기대 직업지위 지수는 학생이 희망한 직업의 사회경제적 수준을 수치로 바꾼 값입니다. 값이 클수록 사회경제적 지위가 높은 직업을 가리킵니다. 네 해 사이에 격차는 {수(지수[0].격차)}점에서 {수(지수[1].격차)}점으로, {수(Math.round((지수[0].격차 - 지수[1].격차) * 100) / 100)}점 움직였습니다.</p>

  <h2>진로를 찾아본 경험은 얼마나 달랐나</h2>
  <p class="note">PISA 2018 한국 학생 {사람수}명을 부모의 사회경제적 지위 상위 25%와 하위 25%로 갈라 센 값입니다.</p>
  <div class="tablewrap scroll">
    <table>
      <thead><tr><th>해 본 적이 있다</th><th>상위 25%</th><th>하위 25%</th><th>차이</th></tr></thead>
      <tbody>
        {칸들.map((c) => (
          <tr>
            <th>{c.무엇}</th>
            <td class="num">{수(c.상위)}%</td>
            <td class="num">{수(c.하위)}%</td>
            <td class="num">{수(c.차이)}%p{c.보고서가적은차이 == null ? '*' : ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">
    네 가지 가운데 가장 크게 벌어진 것은 「{가장큰.무엇}」으로 {수(가장큰.차이)}%포인트였고, 가장 적게 벌어진 것은 「{가장작은.무엇}」으로 {수(가장작은.차이)}%포인트였습니다.
    별표(*)가 붙은 두 줄의 차이는 보고서가 직접 적은 값이 아니라 두 수치를 <b>우리가 뺀 값</b>입니다.
    위 두 줄은 보고서가 적은 값을 그대로 썼습니다. 앞 줄은 두 수치를 그냥 빼면 {수(Math.round((칸들[0].상위 - 칸들[0].하위) * 10) / 10)}%포인트가 나오지만 보고서는 {수(칸들[0].차이)}%포인트로 적었습니다. 원자료에 소수 둘째 자리가 있어 갈린 것으로 보이며, <b>보고서가 적은 값을 정본으로 두었습니다.</b>
  </p>

  <h2>같은 자료에 함께 적힌 것</h2>
  <ul>
    {(자료.덧붙인것 as string[]).map((s) => (<li>{s}</li>))}
  </ul>

  <h2>연구진이 제안한 것</h2>
  <ul>
    {(자료.연구진제안 as string[]).map((s) => (<li>{s}</li>))}
  </ul>
  <p class="note">위 두 줄은 <b>보고서를 쓴 연구진의 제안</b>을 옮긴 것입니다. 백년지도의 권고가 아닙니다.</p>

  <h2>이 숫자를 어떻게 읽어야 하나요?</h2>
  <ul>
    <li><strong></strong> 집단을 갈라 센 평균값이며, 어느 한 사람이 무엇을 꿈꾸게 될지를 말하지 않습니다.</li>
    <li>상위 25%와 하위 25%는 <b>양 끝</b>입니다. 가운데 절반은 이 표에 들어 있지 않으므로 두 수치 사이에 모든 사람이 놓여 있다고 읽으면 안 됩니다.</li>
    <li>이 표는 <b>희망한 직업</b>을 센 것이지 <b>가지게 된 직업</b>을 센 것이 아닙니다. 둘은 다른 값입니다.</li>
    <li>기대 직업지위 지수의 「점」은 직업의 사회경제적 수준을 매긴 눈금입니다. 점수가 높은 직업이 좋은 직업이라는 뜻이 아닙니다.</li>
    <li>경험 비율은 「해 본 적이 있다」를 센 값이며 몇 번 했는지는 세지 않았습니다.</li>
  </ul>

  <h2>같은 축에 있는 다른 표</h2>
  <ul>
    <li><a href="/college-major">대학 전공</a></li>
    <li><a href="/first-job">첫 직장</a></li>
    <li><a href="/trendy-major-outcomes">인기 전공의 그 뒤</a></li>
  </ul>

  <h2>이 숫자는 어디서 왔나요?</h2>
  <p class="note">
    {메모.원자료} · 연구책임자 {메모.연구책임자} · 출판일자 {메모.출판일자} · 분석에 쓴 자료는 {메모.분석자료}입니다.
    보고서 이름과 번호, 연구책임자, 출판일자는 한국교육개발원 연구보고서 목록(<a href={메모.목록주소} rel="nofollow noopener" target="_blank">kedi.re.kr</a>)에서 확인했습니다. 잰 날 {메모.잰날}.
  </p>

  <NextQuestionBrief 모은것="한국교육개발원 RR2026-02 로 부모의 사회경제적 지위에 따른 기대 직업지위 지수 격차와 진로 탐색 경험 격차를 정리한 표" />
</HundredYear>

<style>
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .scroll { overflow-x: auto; }
</style>
