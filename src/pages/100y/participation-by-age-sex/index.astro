---
/**
 * /100y/participation-by-age-sex — 연령대·성별 경제활동참가율 (2015·2020·2025, 연간)
 *
 * 출처  KOSIS 101/DT_1DA7012S 경제활동인구조사 성/연령별 경제활동인구(연간).
 * ⛔ 원인 추측·조언은 싣지 않는다. 65세 이상의 성별 값은 이 표에 없다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import HundredAgeWalk from '../../../components/HundredAgeWalk.astro';
import 원본 from '../../../data/100yearmap/participation-by-age-sex.json';

const 자료 = 원본 as any;
const 연도: string[] = 자료.연도;
const 연령: string[] = 자료.연령;
const 이름 = (a: string) => a.replace('-', '~').replace('세이상', '세 이상');
const 값 = (성: string, a: string, y: string): number | undefined => 자료.값?.[성]?.[a]?.[y];
const 칸 = (v: number | undefined) => (v == null ? '표에 없음' : `${v.toFixed(1)}%`);
const 부호 = (n: number) => `${n > 0 ? '+' : ''}${n.toFixed(1)}%p`;
const 최신 = 연도[연도.length - 1];
const 처음 = 연도[0];
const 성별연령 = 연령.filter((a) => 값('남자', a, 최신) != null);
const 차 = (a: string, y: string) => Math.round((값('남자', a, y)! - 값('여자', a, y)!) * 10) / 10;

const 여삼 = 값('여자', '30-34세', 최신)!;
const 여삼처음 = 값('여자', '30-34세', 처음)!;
const 남삼 = 값('남자', '30-34세', 최신)!;
const 변화 = Math.round((여삼 - 여삼처음) * 10) / 10;

const desc =
  `경제활동인구조사(국가데이터처 KOSIS)에서 30~34세 여자의 경제활동참가율은 ${처음}년 ${여삼처음}%, ${최신}년 ${여삼}%로 ${변화}%p 올랐습니다. ` +
  `같은 나이 남자는 ${최신}년 ${남삼}%입니다. 남녀 차이는 ${차('30-34세', 처음)}%p에서 ${차('30-34세', 최신)}%p로 줄었습니다.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: '연령대·성별 경제활동참가율 — 경제활동인구조사 연간',
  description: desc,
  dateModified: 자료.만든날,
  creator: { '@type': 'Organization', name: '백년지도' },
  sourceOrganization: { '@type': 'Organization', name: 자료.출처.이름 },
  isBasedOn: 자료.출처.주소,
  variableMeasured: ['경제활동참가율', '연령대', '성별'],
};
---

<HundredYear
  title={`30~34세 여자 경제활동참가율, ${처음}년 ${여삼처음}%에서 ${최신}년 ${여삼}%로 (남녀·나이별)`}
  description={desc}
  jsonLd={jsonLd}
>
  <h1>나이와 성별로 본<br />경제활동참가율</h1>
  <p class="sub">
    통계청 경제활동인구조사 연간 값입니다. 경제활동참가율은 15세 이상 인구 가운데 일하고 있거나 일자리를 구하는 사람(경제활동인구)의 비율입니다.
  </p>

  <div class="answer">
    <p class="answer-label">30~34세 여자 경제활동참가율</p>
    <p class="answer-num">{여삼}%</p>
    <p class="answer-sub">{처음}년 {여삼처음}% · {부호(변화)} · 같은 나이 남자 {최신}년 {남삼}%</p>
  </div>

  <h2>남자와 여자, {처음}년과 {최신}년</h2>
  <div class="tablewrap">
    <table>
      <thead>
        <tr>
          <th>나이</th>
          <th>남자 {처음}</th><th>남자 {최신}</th>
          <th>여자 {처음}</th><th>여자 {최신}</th>
          <th>남자 − 여자 {처음}</th><th>남자 − 여자 {최신}</th>
        </tr>
      </thead>
      <tbody>
        {성별연령.map((a) => (
          <tr>
            <td>{이름(a)}</td>
            <td>{칸(값('남자', a, 처음))}</td><td><strong>{칸(값('남자', a, 최신))}</strong></td>
            <td>{칸(값('여자', a, 처음))}</td><td><strong>{칸(값('여자', a, 최신))}</strong></td>
            <td>{차(a, 처음)}%p</td><td>{차(a, 최신)}%p</td>
          </tr>
        ))}
        <tr>
          <td>전체</td>
          <td>{칸(값('남자', '계', 처음))}</td><td><strong>{칸(값('남자', '계', 최신))}</strong></td>
          <td>{칸(값('여자', '계', 처음))}</td><td><strong>{칸(값('여자', '계', 최신))}</strong></td>
          <td>{차('계', 처음)}%p</td><td>{차('계', 최신)}%p</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>남녀를 합친 나이대별 값, 세 해 비교</h2>
  <div class="tablewrap">
    <table>
      <thead>
        <tr><th>나이</th>{연도.map((y) => <th>{y}년</th>)}<th>{처음}→{최신}</th></tr>
      </thead>
      <tbody>
        {연령.map((a) => (
          <tr>
            <td>{이름(a)}</td>
            {연도.map((y) => <td>{y === 최신 ? <strong>{칸(값('계', a, y))}</strong> : 칸(값('계', a, y))}</td>)}
            <td>{부호(값('계', a, 최신)! - 값('계', a, 처음)!)}</td>
          </tr>
        ))}
        <tr>
          <td>전체</td>
          {연도.map((y) => <td>{y === 최신 ? <strong>{칸(값('계', '계', y))}</strong> : 칸(값('계', '계', y))}</td>)}
          <td>{부호(값('계', '계', 최신)! - 값('계', '계', 처음)!)}</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>⚠ 이 자료로 말할 수 없는 것</h2>
  <ul>
    <li>같은 해 나이대를 나란히 놓은 값입니다. 한 사람이 나이가 들면서 겪은 변화를 뜻하지 않습니다.</li>
    <li>참가율이 오르내린 이유는 이 표에 없습니다. 인구 구성이 달라진 영향도 이 표만으로는 가를 수 없습니다.</li>
    <li>이 표의 성별 값은 60~64세까지만 나뉘어 있어 65세 이상의 남녀 값은 싣지 못했습니다.</li>
    <li>일하고 있는지만 잴 뿐 일의 형태나 시간은 이 표에 없습니다.</li>
  </ul>

  <p class="note">
    출처 — {자료.출처.이름}, 표 {자료.출처.표}. 기준 {연도.join('·')}년 연간. 주소 <a href={자료.출처.주소} rel="noopener">{자료.출처.주소}</a>. 만든날 {자료.만든날}. 이용허락범위: {자료.출처.이용허락범위}.
  </p>

  <p class="note">
    <a href="/work-family-priority-by-age">← 일과 가정, 무엇이 먼저인가</a>
    <br />
    <a href="/parental-leave">← 육아휴직</a>
  </p>

  <HundredAgeWalk 키="participation-by-age-sex" />
  <NextQuestionBrief 모은것="경제활동인구조사 연령대·성별 경제활동참가율" />
</HundredYear>
