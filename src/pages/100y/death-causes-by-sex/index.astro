---
/**
 * /100y/death-causes-by-sex — 나이대별 남자·여자 사망원인 1~3위 (롱테일, 축 「나이대별 사망원인」 death-causes 에 딸림)
 *
 * ── 왜 만들었나 (2026-11-14 · 1번) ──────────────
 * death-causes 지면은 남녀 합계 1~5위만 낸다. 같은 원표(KOSIS DT_1B34E20)에 있는
 * 남자·여자 칸과 2023~2025 세 해를 나이대로 갈라 낸다. 숫자는 death-causes-by-age.json 에서 그대로 옮긴다.
 *
 * ⛔ 까닭을 지어내지 않는다. ⛔ 「10위 밖」은 0 이 아니라 «원표가 그 칸을 내지 않음»이다.
 */
import HundredYear from '../../../layouts/HundredYear.astro';
import NextQuestionBrief from '../../../components/NextQuestionBrief.astro';
import 원본 from '../../../data/100yearmap/death-causes-by-age.json';

const 자료 = 원본 as any;
const 칸들 = 자료.칸들 as any[];
const 열살 = ['0세', '1-9세', '10-19세', '20-29세', '30-39세', '40-49세', '50-59세', '60-69세', '70-79세', '80세 이상'];
const 수 = (n: number | null | undefined) => (n == null ? '—' : n.toLocaleString('ko-KR', { maximumFractionDigits: 1 }));
const 쉬운말 = (s: string) => String(s ?? '').replace(/고의적 자해\(자살\)/g, '스스로 목숨을 끊음').replace('알쯔하이머병', '알츠하이머병');
const 찾 = (해: number, 성: string, 나이: string, 원인: string) => 칸들.find((x) => x.해 === 해 && x.성 === 성 && x.나이 === 나이 && x.사망원인 === 원인);
const 출처 = '국가데이터처 사망원인통계(KOSIS DT_1B34E20 「연령대별 사망원인」), 잰날 ' + 자료._메모.잰날;

const 나이들 = 열살.map((나이) => {
  const 줄 = (성: string) => 칸들.filter((x) => x.해 === 2025 && x.성 === 성 && x.나이 === 나이 && x.순위 <= 3).sort((a, b) => a.순위 - b.순위);
  return { 나이, 남: 줄('남자'), 여: 줄('여자') };
});
const 일위같음 = 나이들.filter((x) => x.남[0] && x.여[0] && x.남[0].사망원인 === x.여[0].사망원인);
const 일위다름 = 나이들.filter((x) => x.남[0] && x.여[0] && x.남[0].사망원인 !== x.여[0].사망원인);
const TITLE = '나이대별 남자·여자 사망원인 1~3위 2025';
const desc = `2025년 사망원인통계로 열 살 단위 ${나이들.length}개 나이대의 남자·여자 사망원인 1~3위를 실었습니다. 1위가 남녀 같은 나이대는 ${일위같음.length}곳, 다른 나이대는 ${일위다름.length}곳(${일위다름.map((x) => x.나이).join('·')})입니다.`;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Dataset', name: TITLE, description: desc, creator: { '@type': 'GovernmentOrganization', name: '국가데이터처' }, isBasedOn: 'https://kosis.kr/statHtml/statHtml.do?orgId=101&tblId=DT_1B34E20', temporalCoverage: '2025' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [{ '@type': 'Question', name: '나이대별 사망원인 1위가 남자와 여자에서 다른 나이대는 어디인가요?', acceptedAnswer: { '@type': 'Answer', text: `2025년 열 살 단위 ${나이들.length}개 나이대 가운데 ${일위다름.length}곳이 다릅니다: ${일위다름.map((x) => `${x.나이}(남자 ${쉬운말(x.남[0].사망원인)}, 여자 ${쉬운말(x.여[0].사망원인)})`).join(', ')}.` } }] },
];
---

<HundredYear title={TITLE} description={desc} jsonLd={jsonLd}>
  <h1>나이대별 남자·여자 사망원인 —<br class="pcbr" /> 1~3위 2025</h1>
  <p class="sub">「남자와 여자는 같은 이유로 숨지나?」 열 살 단위 나이대마다 남자·여자 사망원인 1~3위를 원표 그대로 놓았습니다.</p>

  <div class="answer">
    <p class="answer-label">2025년 · 1위가 남녀 다른 나이대</p>
    <p class="answer-num">{일위다름.length}곳 / {나이들.length}곳</p>
    <p class="answer-sub">{일위다름.map((x) => x.나이).join(' · ') || '해당 없음'}</p>
  </div>

  <h2>나이대별 1~3위</h2>
  <div class="tablewrap scroll">
    <table>
      <thead><tr><th>나이대</th><th>차례</th><th>남자 사망원인</th><th>남자 10만 명당</th><th>여자 사망원인</th><th>여자 10만 명당</th></tr></thead>
      <tbody>
        {나이들.map((x) => [0, 1, 2].map((i) => (
          <tr>
            <th>{i === 0 ? x.나이 : ''}</th><td class="num">{i + 1}위</td>
            <td>{x.남[i] ? 쉬운말(x.남[i].사망원인) : '—'}</td><td class="num">{수(x.남[i]?.사망률)}</td>
            <td>{x.여[i] ? 쉬운말(x.여[i].사망원인) : '—'}</td><td class="num">{수(x.여[i]?.사망률)}</td>
          </tr>
        )))}
      </tbody>
    </table>
  </div>
  <p class="note">열 살 단위만 실었습니다. 「15~64세」 같은 묶음 칸은 겹치므로 뺐습니다. 사망률은 그 나이대·그 성별 인구 10만 명당 값입니다.</p>

  <h2>같은 자료로 본 다른 표</h2>
  <ul>
    <li><a href="/death-causes">나이대별 사망원인 1~5위(남녀 합계)</a></li>
    <li><a href="/cancer-death-by-age">암 사망 나이대별</a></li>
    <li><a href="/accident-death-by-age">사고 사망 나이대별</a></li>
  </ul>

  <aside class="help">
    <h2>혼자 견디지 마십시오</h2>
    <p>이 표에는 스스로 목숨을 끊은 사람 수가 들어 있습니다. 마음이 힘들 때 기댈 곳이 있습니다.</p>
    <ul>
      <li><b>자살예방 상담전화 <a href="tel:109">109</a></b> — 24시간, 무료</li>
      <li><b>정신건강 상담전화 <a href="tel:1577-0199">1577-0199</a></b> — 24시간</li>
    </ul>
  </aside>

  <h2>이 숫자를 어떻게 읽어야 하나요?</h2>
  <ul>
    <li><strong>이것은 통계이지 당신이 아닙니다.</strong> 한 해 동안 그 나이대에서 있었던 일을 센 값이며, 어느 개인에게 일어날 일을 말하지 않습니다.</li>
    <li>사망률은 그 나이대 인구 10만 명당 사망자 수입니다. 나이대마다 사람 수가 달라 나이대끼리는 사망률로 견줍니다.</li>
    <li>차례는 원인끼리의 차례일 뿐 사망 자체가 많다는 뜻이 아닙니다. 젊은 나이대는 사망자가 적어 적은 수 안의 차례입니다.</li>
  </ul>
  <h2>이 숫자는 어디서 왔나요?</h2>
  <p class="note">{출처} · 2025년 확정 통계 기준 · 「—」는 원표가 그 칸을 내지 않았다는 뜻이며 0명이 아닙니다.</p>

  <NextQuestionBrief 모은것="국가데이터처 사망원인통계 원표로 열 살 단위 나이대마다 남자·여자 사망원인 1~3위와 사망률을 정리한 표" />
</HundredYear>

<style>
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .scroll { overflow-x: auto; }
  .help { background: #f4f8f4; border: 1px solid #d9e6d9; border-radius: .6rem; padding: 1rem 1.2rem; margin: 2rem 0; }
</style>
