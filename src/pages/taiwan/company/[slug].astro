---
/*
 * `/taiwan/company/[slug]` — **대만 상장사 한 곳의 재무 지면.** 한 자료로 1,000장 남짓이 선다.
 *
 * ── 🔴 왜 (2026-09-23 · 5번) ──────────────────────────────────────────
 * 사장님: 「사우디, 상하이 외 할 곳은?」 → 재서 대만을 1순위로 올렸고 「응」을 받았다.
 * TWSE 가 OpenAPI 를 열쇠 없이 열었는데 **항목·회사명이 중국어**다 —
 * 한국 DART 와 똑같은 「언어 장벽형 기회」다.
 *
 * ── ⛔ 이 지면이 지키는 것 ─────────────────────────────────────────────
 * ⛔ **회사 상호를 중국어로 화면에 내지 않는다.** 영문 매체다.
 *   ⇒ 중국어 상호는 JSON-LD 의 alternateName 에만 둔다.
 * ⛔ **환율을 만들어 곱하지 않는다.** 대만달러는 대만달러로 적는다.
 * ⛔ **못 잰 칸을 0 으로 채우지 않는다.**
 * ⛔ **투자 판단을 적지 않는다.**
 * 🔴 **이 자료는 «분기» 재무제표다.** 한국·일본(연간)과 기간이 다르다 —
 *   지면이 그것을 먼저 말한다. 남의 나라 수와 나란히 놓을 때 읽는 사람이 속지 않게.
 * 🔴 출처표시는 라이선스의 «의무»다(OGDL 三(二)) — 빠뜨리면 허락 자체가 없던 것이 된다.
 */
import Base from '../../../layouts/Base.astro';
import { SITE_URL } from '../../../consts';
import tape from '../../../data/taiwan-financials-tape.json';
import { 주소표만들기 } from '../../../lib/company-slug.mjs';
import {
  재무줄, 회사줄, 시장줄, 낼만한가, 분기말, 누계기간, 업종주소, 많이어긋났나,
} from '../../../lib/taiwan-company-page.mjs';
/* 🔴 [2026-10-04] 이웃고르기 — 일본 쪽에서 찾은 같은 흠이 여기도 있었다 */
import { 이웃고르기 } from '../../../lib/japan-company-page.mjs';

export async function getStaticPaths() {
  const 행들 = ((tape as any).rows as any[]).filter((r) => 낼만한가(r));
  const 주소표 = 주소표만들기(행들);

  /* 업종으로 묶는다.
     🔴 첫 판에서는 코드(「24」)뿐이라 「거래소가 이름을 안 준다」고 적고 업종 지면을 안 만들었다.
       틀렸다 — 같은 API 의 t187ap14_L 이 「水泥工業」처럼 이름을 준다. 우리가 안 찾은 것이었다.
     ⚠ 이제 묶는 기준이 «코드»가 아니라 «이름»이다. 이름을 못 옮긴 회사는 묶이지 않는다. */
  const 갈래별 = new Map<string, Array<{ code: string; slug: string; name: string }>>();
  for (const r of 행들) {
    const s = String(r.industry_en || '').trim();
    if (!s) continue;
    if (!갈래별.has(s)) 갈래별.set(s, []);
    갈래별.get(s)!.push({ code: String(r.code), slug: 주소표.get(String(r.code))!, name: String(r.name_en) });
  }
  for (const v of 갈래별.values()) v.sort((a, b) => a.name.localeCompare(b.name, 'en'));

  return 행들.map((r) => {
    const 갈래 = String(r.industry_en || '').trim();
    const 한벌 = 갈래 ? (갈래별.get(갈래) ?? []) : [];
    return {
      params: { slug: 주소표.get(String(r.code))! },
      props: {
        code: String(r.code),
        nameEn: String(r.name_en).trim(),
        nameZh: String(r.name || '').trim(),
        chairman: r.chairman || null,
        president: r.president || null,   /* 總經理 — 대만에서 CEO 자리에 가장 가깝다(2026-10-11) */
        줄: 재무줄(r),
        회사: 회사줄(r),
        기간: 분기말(r),
        /* 🔴 손익은 «그 분기»가 아니라 연초부터의 누계다 — 지면이 그렇게 말한다 */
        덮는기간: 누계기간(r),
        시장: 시장줄(r),
        어긋났나: 많이어긋났나(시장줄(r)),
        업종: 갈래 || null,
        업종한자: String(r.industry_zh || '') || null,
        업종주소값: 갈래 ? 업종주소(갈래) : null,
        /* 🔴 [2026-10-04] `.slice(0, 12)` 는 «모두 같은 12개»를 가리킨다 — 이웃을 가리킨다 */
        같은갈래: 이웃고르기(한벌, 한벌.findIndex((x) => x.code === String(r.code)), 12),
        갈래회사수: 한벌.length,
      },
    };
  });
}

const {
  code, nameEn, nameZh, chairman, president, 줄, 회사, 기간, 덮는기간, 시장, 어긋났나,
  업종, 업종한자, 업종주소값, 같은갈래, 갈래회사수,
} = Astro.props as any;

const bn = (n: number | null) =>
  /* ⛔ -0.04 가 「-0」 으로 찍혀 «0인데 음수»처럼 보였다. 소수 한 자리를 늘 남긴다 */
  n == null ? '—' : n.toLocaleString('en-GB', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const pct = (n: number | null) =>
  n == null ? '—' : `${(n * 100).toLocaleString('en-GB', { maximumFractionDigits: 1 })}%`;
const num = (n: number | null) =>
  n == null ? '—' : n.toLocaleString('en-GB', { maximumFractionDigits: 0 });
const x2 = (n: number | null) =>
  n == null ? '—' : n.toLocaleString('en-GB', { maximumFractionDigits: 2 });

/* 🔴🔴 [2026-10-09 · 5번] **제목에만 종목코드가 빠져 있었다.**
   ─────────────────────────────────────────────────────────────────────────
   재 보니 29일(09-08~10-06) 동안 —
       /japan/   3,736장 중  607장이 떴다 (16%)
       /company/ 2,582장 중  324장이 떴다 (13%)
       /taiwan/  1,090장 중    3장이 떴다 (**0.3%**)
   같은 사이트 같은 틀인데 50배 차이다. 색인은 돼 있다(`site:` 로 확인 — 첫 쪽 열 줄).
   눈에 띄는 차이는 **제목**이었다.
       일본   「KOMATSU MATERE Co., Ltd. (3580) earnings results — FY2026」
       대만   「YONYU — reported financials (Taiwan)」        ← 코드가 없다
   ⭐ 코드는 **이미 쥐고 있다** — 바로 아래 설명줄이 `(${code})` 를 쓴다.
     쥐고 있는 것을 제목에만 안 쓴 것이다.
   ⛔ 「earnings results」는 **안 넣는다.** 그 말로 들어온 노출이 대만에는 한 줄도 없다.
     일본에 넣은 것은 평균 8.2위라는 근거가 있어서였다. 근거 없는 데로 옮기지 않는다.
   ⚠ 이것은 **일관성을 맞춘 것**이지 대만 쪽 검색어 근거가 있어서가 아니다.
     그러니 이것으로 수가 오를 것이라 말하지 않는다. 기준선만 남긴다 —
     고치기 «전»: 1,090장 중 29일간 뜬 것 3장 · 노출 12 · 클릭 0 */
const title = `${nameEn} (${code}) — reported financials (Taiwan)`;
const 설명줄 = 줄 && 줄.revenue != null
  ? `${nameEn} (${code}) reported TWD ${bn(줄.revenue)}bn of revenue over ${덮는기간?.길게 ?? 'the period covered by its latest filing'}.`
  : `${nameEn} (${code}) — financials as filed with the Taiwan Stock Exchange.`;
/* 🔴 [2026-10-11 01:5x · 5번] **「who is the ceo of …」가 우리 지면으로 10.3위에 뜬다.**
 *   대만 지면에는 「Chair」 한 줄이 이미 있었는데 **CEO 라는 말이 없어** 그 질의에 안 걸렸다.
 *   그리고 總經理(대만에서 CEO 자리에 가장 가까운 것)는 받아 두고 담지도 않고 있었다.
 * ⛔ 제목은 건드리지 않는다.
 * ⛔ **둘 중 누가 CEO 인지 우리가 정하지 않는다** — 회사마다 다르고 공시가 말해 주지 않는다.
 *   「董事長이 CEO다」라고 적으면 틀린 회사가 많다. 둘을 나란히 놓고 그 사실을 적는다. */
const 대표설명 = chairman || president
  ? ` ${[chairman && `Chairman ${chairman}`, president && `president ${president}`].filter(Boolean).join(', ')}.`
  : '';
const description = `${설명줄}${대표설명} Revenue, operating profit, net profit, assets, liabilities and equity as filed through the TWSE open data service, with the ratios computed from those figures.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Corporation',
  '@id': `${SITE_URL}/taiwan/company/${Astro.params.slug}#corporation`,
  name: nameEn,
  alternateName: nameZh || undefined,
  tickerSymbol: code,
  url: `${SITE_URL}/taiwan/company/${Astro.params.slug}`,
  /* 사람이 읽는 칸과 **같은 사실**을 기계도 읽게 둔다. ⛔ 직위는 공시가 적은 그대로 —
     둘 중 누구를 CEO 로 올릴지 우리가 고르지 않는다 */
  ...(chairman || president
    ? {
      employee: [
        chairman && { '@type': 'Person', name: chairman, jobTitle: 'Chairman of the Board' },
        president && { '@type': 'Person', name: president, jobTitle: 'President (General Manager)' },
      ].filter(Boolean),
    }
    : {}),
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <article class="wrap">
    <nav class="crumbs">
      <a href="/">SeoulMarkets</a> <span>›</span> <a href="/taiwan/companies">Taiwan companies</a>
    </nav>

    <header>
      <h1>{nameEn}</h1>
      <p class="sub">
        <span class="chip">{code}</span>
        <span class="chip">Taiwan</span>
        {업종주소값 && <a class="chip link" href={`/taiwan/sector/${업종주소값}`}>{업종}</a>}
        {덮는기간 ? <span class="chip">{덮는기간.짧게}</span> : 기간 && <span class="chip">{기간}</span>}
      </p>
      <p class="lede">{설명줄}</p>
    </header>

    <p class="warn top">
      <b>These figures run from the start of the financial year.</b> The Taiwan Stock Exchange
      files income-statement lines cumulatively, so a Q2 filing covers
      {덮는기간 ? ` ${덮는기간.길게}` : ' the year to date'} — not three months on their own. Balance-sheet
      lines are the position on the closing date instead. That makes this page not directly
      comparable with the annual figures on our Korean and Japanese company pages; compare it with
      another Taiwanese filing covering the same months.
    </p>

    <section>
      <h2>Reported financials</h2>
      <p class="note">
        Figures are as filed, in billions of New Taiwan dollars (TWD bn). We do not convert to
        dollars — an exchange rate would be a number we made up, not one the company reported.
        Income-statement lines cover the whole period named below; balance-sheet lines are the
        position on its closing date.
      </p>
      <div class="scroll">
        <table>
          <tbody>
            <tr><th>Period covered <span class="aside">(income statement)</span></th><td>{덮는기간?.짧게 ?? 기간 ?? '—'}</td></tr>
            <tr><th>Revenue</th><td>{bn(줄?.revenue ?? null)}</td></tr>
            <tr>
              <th>Operating profit</th>
              <td class={줄?.operating != null && 줄.operating < 0 ? 'neg' : ''}>{bn(줄?.operating ?? null)}</td>
            </tr>
            <tr>
              <th>Pre-tax profit</th>
              <td class={줄?.pretax != null && 줄.pretax < 0 ? 'neg' : ''}>{bn(줄?.pretax ?? null)}</td>
            </tr>
            <tr>
              <th>Net profit</th>
              <td class={줄?.net != null && 줄.net < 0 ? 'neg' : ''}>{bn(줄?.net ?? null)}</td>
            </tr>
            <tr><th>Total assets <span class="aside">(at the closing date)</span></th><td>{bn(줄?.assets ?? null)}</td></tr>
            <tr><th>Total liabilities</th><td>{bn(줄?.liabilities ?? null)}</td></tr>
            <tr><th>Equity</th><td>{bn(줄?.equity ?? null)}</td></tr>
            <tr><th>Net asset value per share</th><td>{줄?.bps == null ? '—' : `TWD ${x2(줄.bps)}`}</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2>Ratios from those figures</h2>
      <p class="note">
        Each ratio is computed from the two lines above it. A dash means an input was missing or the
        denominator was zero — <b>not</b> that the value is zero. Return on equity divides a
        year-to-date profit by equity at one date, so it is not an annual rate.
      </p>
      <div class="scroll">
        <table>
          <tbody>
            <tr>
              <th>Operating margin</th>
              <td class={줄?.영업이익률 != null && 줄.영업이익률 < 0 ? 'neg' : ''}>{pct(줄?.영업이익률 ?? null)}</td>
            </tr>
            <tr>
              <th>Net margin</th>
              <td class={줄?.순이익률 != null && 줄.순이익률 < 0 ? 'neg' : ''}>{pct(줄?.순이익률 ?? null)}</td>
            </tr>
            <tr><th>Equity / assets</th><td>{pct(줄?.자기자본비율 ?? null)}</td></tr>
            <tr><th>Liabilities / equity</th><td>{x2(줄?.부채비율 ?? null)}</td></tr>
            <tr>
              <th>Return on equity <span class="aside">(year to date, not annualised)</span></th>
              <td class={줄?.ROE != null && 줄.ROE < 0 ? 'neg' : ''}>{pct(줄?.ROE ?? null)}</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="warn">
        These are arithmetic, not judgements. We do not say whether a margin is good or bad, and we
        do not rank companies against each other.
      </p>
    </section>

    {시장 && (
      <section>
        <h2>
          What the market paid
          {시장.priceDate && <span class="aside"> — close on {시장.priceDate}</span>}
        </h2>
        <p class="note">
          A closing price is one moment; the figures above cover a whole period. We put them on the
          same page because both are filed by the exchange, not because they are measured the same
          way.
        </p>
        <div class="scroll">
          <table>
            <tbody>
              <tr><th>Closing price</th><td>{시장.close == null ? '—' : `TWD ${x2(시장.close)}`}</td></tr>
              <tr>
                <th>Market value <span class="aside">(close × shares outstanding)</span></th>
                <td>{시장.marketCap == null ? '—' : `TWD ${bn(시장.marketCap)}bn`}</td>
              </tr>
              <tr>
                <th>Price / earnings</th>
                <td>{x2(시장.per)}</td>
              </tr>
              <tr><th>Price / book</th><td>{x2(시장.pbr)}</td></tr>
              <tr>
                <th>Dividend yield</th>
                <td>{시장.dividendYield == null ? '—' : `${x2(시장.dividendYield)}%`}</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="note">
          The exchange leaves price / earnings blank for a company with no trailing profit, so a
          dash there is not a zero.
        </p>
        {어긋났나 && (
          <p class="warn">
            <b>These two figures disagree, and we have not resolved it.</b> The closing price is
            TWD {x2(시장.close)}, but price / book ({x2(시장.pbr)}) multiplied by net asset value
            per share ({x2(줄?.bps ?? null)}) implies about
            TWD {x2(시장.pbr != null && 줄?.bps != null ? 시장.pbr * 줄.bps : null)}. Both come from
            the exchange. We report both rather than pick one, and the market value above uses the
            closing price. Treat it with care until the filing is corrected.
          </p>
        )}
      </section>
    )}

    {(chairman || president) && (
      <section>
        <h2>Who runs it</h2>
        <p class="note">
          The Taiwan Stock Exchange names two officers in a listed company's filing: the chairman
          of the board (董事長) and the president, also called the general manager (總經理).
          Which of the two acts as chief executive — the CEO — differs from company to company,
          and the filing does not say. We print both rather than choosing one.
        </p>
        <div class="scroll">
          <table>
            <tbody>
              {chairman && (
                <tr><th>Chairman of the board (董事長)</th><td lang="zh-Hant">{chairman}</td></tr>
              )}
              {president && (
                <tr><th>President / general manager (總經理)</th><td lang="zh-Hant">{president}</td></tr>
              )}
            </tbody>
          </table>
        </div>
        {/* 🔴 로마자를 «지어내지 않는다». 중국어 이름은 병음·웨이드자일스·본인 표기가 다 다르다 —
            일본 지면과 같은 까닭이다. ⛔ 이 줄을 지우고 로마자를 채워 넣지 마십시오. */}
        <p class="warn">
          Names are printed as they were filed, in Chinese. We do not romanise them — a Chinese
          name can be spelled several ways in the Latin alphabet and only the person knows which
          one is theirs. Writing a guess here would put the wrong name on this page.
        </p>
      </section>
    )}

    {회사 && (
      <section>
        <h2>The company itself</h2>
        <div class="scroll">
          <table>
            <tbody>
              {/* 🔴 [2026-10-11 03:1x · 5번] 이 둘이 묶음 1,095줄에서 «전부 null» 이었다 —
                  수집기가 서기 8자리를 민국 7자리 자로 읽고 있었다. 값이 들어오자 그릴 것이 생겼다.
                  ⭐ 「when was X founded」·「when did X list」는 흔한 물음이다. 공시가 적은 날이다 */}
              {회사.foundedOn && (
                <tr><th>Founded</th><td><time datetime={회사.foundedOn}>{회사.foundedOn}</time></td></tr>
              )}
              {회사.listedOn && (
                <tr><th>Listed on the exchange</th><td><time datetime={회사.listedOn}>{회사.listedOn}</time></td></tr>
              )}
              <tr><th>Shares outstanding</th><td>{num(회사.shares)}</td></tr>
              <tr><th>Paid-in capital</th><td>{회사.paidIn == null ? '—' : `TWD ${bn(회사.paidIn)}bn`}</td></tr>
              {/* ⛔ Chair 줄은 「Who runs it」 칸으로 옮겼다(2026-10-11) — 거기서 總經理와 나란히 놓는다.
                  여기 두면 「누가 이끄나」를 묻는 손님이 자본금 표 안에서 한 줄을 찾아야 한다 */}
              {회사.website && (
                <tr>
                  <th>Company site</th>
                  <td><a href={회사.website} rel="external noopener" target="_blank">{회사.website.replace(/^https?:\/\//, '')}</a></td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {같은갈래.length > 0 && (
      <section>
        <h2>
          Other companies in {업종 ?? 'the same classification'}
          {업종한자 && <span class="aside" lang="zh-Hant"> {업종한자}</span>}
        </h2>
        <p class="note">
          {갈래회사수} listed companies file under this classification. Showing {같은갈래.length}.
          {업종주소값 && <> See <a href={`/taiwan/sector/${업종주소값}`}>all {갈래회사수}, with the
          medians for the classification</a>.</>}
        </p>
        <ul class="peers">
          {같은갈래.map((p: any) => (<li><a href={`/taiwan/company/${p.slug}`}>{p.name}</a></li>))}
        </ul>
      </section>
    )}

    <footer class="src">
      <p>
        <b>Source.</b> Taiwan Stock Exchange (TWSE) open data service, released through Taiwan's
        Open Government Data platform under the Open Government Data License, version 1.0 —
        commercial use permitted with attribution.
      </p>
      <p>
        <b>Not investment advice.</b> This page reports what was filed. It contains no
