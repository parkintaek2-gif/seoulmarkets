---
/*
 * group/[group].astro — **그룹별 지면 263장.** (`/group/bts`)
 *
 * ── 🔴 왜 이 지면이 생겼나 ─────────────────────────────────────
 * 우리 검색 실측에서 **노출이 가장 큰 지면이 BTS 기사**였다(68노출). 그 갈래를 재니 —
 * ```
 *   bts members age        자동완성 1번째 · 그 말로 시작 10줄
 *   bts members birthday   1번째 · 10줄
 *   blackpink members age  1번째 · 10줄
 * ```
 * 손님이 묻는 낱알은 **「그룹 하나의 멤버들」**인데, 우리는 생년월일 9,249건을 갖고도
 * 그룹-멤버를 잇는 자료가 없어 그 축으로 한 장도 못 내고 있었다.
 *
 * ── 🔴 이 지면이 반드시 지키는 것 ─────────────────────────────
 * ⛔ **「현재 멤버」라고 안 쓴다.** 위키데이터 P527 은 «있었던» 사람을 담아 탈퇴자도
 *   들어 있고 우리는 그 둘을 못 가른다. 지면에 그대로 적는다.
 * ⛔ **나이를 혼자 안 적는다.** 나이는 움직이는 수이고 이 지면은 배포할 때만 다시 지어진다.
 *   기준 해와 «태어난 날»을 같이 적어야 지면이 낡아도 읽는 사람이 스스로 고쳐 읽는다.
 * ⛔ **적힌 멤버 수와 이름 쓸 수 있는 수를 갈라 적는다.** 위키데이터는 BLACKPINK 를
 *   4명으로 적는데 한 사람에게 영문 이름이 없다. 「3명」만 적으면 그것은 틀린 수다.
 * ⛔ **점을 안 친다.** 별자리 칸은 생일에서 나온 산수일 뿐이고, 그것이 무엇을 뜻하는지
 *   우리는 말하지 않는다 — `/star-signs` 에서 1,047명으로 재 보고 「우연과 구별되지
 *   않는다」고 낸 그 결과를 여기서도 그대로 붙인다.
 * ⛔ 키를 안 적는다 — 위키데이터에 키가 적힌 한국 연예인이 3.5%뿐이다.
 */
import WikiTip from '../../../layouts/WikiTip.astro';
import KcwShorts from '../../../components/KcwShorts.astro';
import 그룹영상 from '../../../data/kcw-group-video.json';
/* 🔴 [2026-10-04 · 5번] 그룹마다 다른 사실 — 닮은 몫 78.8% 를 내리려고 붙였다 */
import 넷플릭스자료 from '../../../data/kcw-idol-vs-netflix.json';
import data from '../../../data/wikitip-groups.json';
/* 🔴 [2026-09-05] 팬이 치는 «약칭»을 지면이 안 쓰고 있었다 — TVXQ 를 DBSK 로 찾아오는 사람이 못 온다 */
import 별명자료 from '../../../data/wikitip-group-nicknames.json';
import people from '../../../data/wikitip-people.json';
import { 이름표만들기, 이지면의문, 문 } from '../../../lib/person-link';
/**
 * 🔴 [2026-08-29] 그룹 지면 263장에 구조화 데이터가 «하나도» 없었다.
 *   사람 지면 636장과 같은 결함이고 같은 값이 있는 자리다 — 그룹 이름은
 *   우리 인기 검색어의 한 갈래인데, 크롤러에게 「이것은 음악 그룹이고 멤버는
 *   이 사람들이다」를 말해 준 적이 없다.
 */
import { 그룹구조화 } from '../../../lib/group-jsonld.ts';

export function getStaticPaths() {
  /* ⚠ Astro 는 이 함수를 따로 떼어 돌린다 — 바깥 선언이 안 보인다(8/24 에 그것으로
     빌드가 멈췄다). 자료는 여기서 읽고 지면이 쓸 것은 props 로 건넨다 */
  const 그룹들 = data.groups ?? [];
  /* 🔴 [2026-08-26] **멤버 이름이 사람 지면으로 안 갔다.** 263장 × 멤버 여럿이
     전부 글자였다. 사람 지면 636장은 지금 구글에서 「발견만」인데, 그리로 가는
     가장 자연스러운 문이 여기다.
     ⛔ 이름이 겹치면 «안 건다» — 틀린 사람에게 보내느니 글자로 둔다(person-link 참고).
     ⚠ 표 전체를 지면마다 실어 보내지 않는다 — 이 지면에 실릴 이름 것만 골라 넘긴다. */
  const { 표: 사람표 } = 이름표만들기(people.people ?? []);
  return 그룹들.map((g, i) => ({
    params: { group: g.slug },
    props: {
      g,
      사람문: 이지면의문((g.members ?? []).map((m: any) => m.name), 사람표),
      이웃: [그룹들[(i + 1) % 그룹들.length], 그룹들[(i + 2) % 그룹들.length]]
        .filter((x) => x && x.slug !== g.slug),
      큰곳: 그룹들.slice(0, 6).filter((x) => x.slug !== g.slug).slice(0, 4),
    },
  }));
}

const { g, 이웃, 큰곳, 사람문 } = Astro.props as { g: any; 이웃: any[]; 큰곳: any[]; 사람문: Record<string, string> };

/*
 * 🔴 [2026-08-29] 사장님 상시 지시 — 「밖에 내는 콘텐트는 «우리 사이트에도» 싣는다」.
 *   어제 만든 spike 영상이 **어느 지면에도 안 실려** 있었다. 만드는 값은 다 치르고
 *   손님이 볼 자리가 없던 것이다.
 * ⛔ 그렇다고 이 지면에 그냥 박으면 «263개 그룹 전부»에 그 영상이 붙는다 — 남의 이름 밑에
 *   남의 수를 놓는 꼴이다.
 * ✅ 그래서 그룹 slug 로 «골라» 싣는다. 하루 여섯 번 내는 영상은 코드가 아니라
 *   src/data/kcw-group-video.json 에 «한 줄»만 더하면 붙는다.
 */
/* ⚠ 한 그룹에 여러 편이 붙을 수 있다 — 무음판과 소리판이 같이 있는 꼴이다.
   옛 꼴(하나짜리 객체)도 그대로 읽는다. */
const 이그룹영상원 = ((그룹영상 as any).영상 ?? {})[g.slug] ?? null;
const 이그룹영상들: any[] = 이그룹영상원
  ? (Array.isArray(이그룹영상원) ? 이그룹영상원 : [이그룹영상원]).filter((v) => v && v.set)
  : [];
const 기준해 = data.refYear;
const 이름못쓴 = g.membersRecorded - g.membersNamed;
const 생일모름 = g.membersNamed - g.membersWithBirthday;
const 수 = (n: number) => Number(n).toLocaleString('en-US');

/* 맏이·막내 — «생일이 있는 사람 중에서만» 말할 수 있다. 없으면 그 칸을 아예 안 그린다 */
const 생일있는 = (g.members ?? []).filter((m: any) => m.born && m.age !== null);
const 맏이 = 생일있는[0] ?? null;
const 막내 = 생일있는.length ? 생일있는[생일있는.length - 1] : null;

/* 🔴🔴 [2026-10-04 · 5번] **이 지면 263장이 서로 78.8% 닮았다.**
 *   사장님: 「검색 관련 색인, seo 업무, AI geo … 유입에 가장 치중해라」
 *
 *   재 보니 51문장 중 38문장(75%)이 모든 그룹에 «똑같이» 나가고 있었다. 전부 한계·방법
 *   설명이다. 한계를 밝히는 것은 우리 강령이지만, 같은 글을 263장에 반복하면 구글은
 *   그것을 「같은 글의 복사본」으로 읽는다. 실제로 `illit age` 가 83위였다.
 *
 *   ⭐ 견줄 것 — KCW born-on 은 41.5% 닮음이고 366장 중 142장이 구글 1쪽에 떴다.
 *   ⛔ 고치는 길은 한계를 «지우는» 것이 아니라 **그 그룹만의 사실을 더 넣는 것**이다.
 *
 *   그래서 넷플릭스 자료를 붙인다 — 그룹마다 수가 달라 틀이 아니라 알맹이가 된다.
 *   ⛔ 「연기를 잘한다/못한다」를 말하지 않는다. 잰 것은 «주간 상위권 출연진 명단에
 *     그 이름이 있었나»뿐이다.
 */
const 넷그룹 = (넷플릭스자료.그룹 ?? []).find((x: any) => x.그룹 === g.name) ?? null;
const 넷전체 = 넷플릭스자료.수 ?? null;

/* 🔴 [2026-10-04 · 5번] **멤버가 다섯인 그룹은 표가 다섯 줄이라 틀이 글을 덮는다.**
 *   재 보니 같은 글자가 2,987 / 4,839 = 62% 였고, 그 대부분이 머리글·꼬리글·고정 설명이다.
 *   그래서 멤버마다 «같은 날 태어난 다른 사람»을 붙인다 — 멤버마다 다르고,
 *   366장짜리 /born-on 으로 가는 길도 된다. ⛔ 날짜를 모르는 사람은 세지 않는다. */
const 날별 = new Map<string, number>();
for (const p of ((people as any).people ?? [])) {
  if (!p?.born) continue;
  const 월일 = String(p.born).slice(5, 10);     /* YYYY-MM-DD → MM-DD */
  if (!/^\d{2}-\d{2}$/.test(월일)) continue;
  날별.set(월일, (날별.get(월일) ?? 0) + 1);
}
/** 그 멤버와 생일이 같은 «다른» 사람 수. ⛔ 모르면 null — 0 이 아니다 */
const 같은날 = (born: string | null | undefined) => {
  if (!born) return null;
  const 월일 = String(born).slice(5, 10);
  if (!/^\d{2}-\d{2}$/.test(월일)) return null;
  const n = (날별.get(월일) ?? 0) - 1;
  return { 월일, 수: n < 0 ? 0 : n };
};

const 나이글 = g.oldestBornYear && g.youngestBornYear
  ? (g.oldestBornYear === g.youngestBornYear
    ? `all born in ${g.oldestBornYear}`
    : `born between ${g.oldestBornYear} and ${g.youngestBornYear}`)
  : null;

/*
 * 🔴 2026-08-25 저녁 — 벤치마킹으로 고쳤다. 사장님 지시로 1위 지면을 «열어서» 쟀다.
 * `bts members age` 1위(kpopbeen.com)와 나란히 놓아 보니 —
 * ```
 *   1위 제목   BTS Ages «2026»: How Old Are Members? (Oldest to Youngest)
 *   내 제목    BTS members age and birthday — 7 of them, and the years they were born
 * ```
 * ⭐ **제목에 «해»가 들어간다.** 사람은 「지금」을 묻고 나이는 해마다 바뀐다.
 *   나는 본문에만 「as of 2026」을 적고 제목에는 안 넣었다.
 * ⛔ 낱말을 쌓은 것이 아니다 — 이 지면의 나이는 실제로 그 해 기준이고,
 *   해를 적는 것이 «더 정직»하다. 제목만 보고도 언제 기준인지 알 수 있다.
 */
/* 🔴 2026-08-27 10:3x — 263장 가운데 제목 173장·설명 173장이 잘리고 있었다.
   ⭐ 263개 그룹 이름을 다 넣어 재고 골랐다. 위 주석의 판단(해를 제목에 적는다)은 그대로 지켰다 —
     「members age ${기준해}」가 여전히 앞쪽에 있다. 「how old are they」 한 마디만 덜었다.
   ⚠ 그룹 이름 길이가 제각각이라 «이름이 길 때만» 꼬리를 뗀다. 한 개(가장 긴 이름)만 짧은
     제목이 되고 나머지 262장은 온전하다. ⛔ 이름을 자르지는 않는다 — 이름이 곧 검색어다.
   ⛔ 「the birth dates are not」 는 본문에 0회여서 그냥 뺄 수 없었다. **본문으로 옮기고**
     설명에는 「Ages are as of ${기준해}」만 남겼다. 뜻이 뒤집히는 고지라 지울 수 없다.
   ⚠ 처음 잴 때 dist 에서 정규식으로 「born between X and Y」를 뽑고 **안 맞는 것은 기본값으로
     채웠다.** 그래서 최대 153자로 나왔는데 실제로는 179자였다 — 못 잰 것을 채운 탓이다.
     ⭐ 두 번째는 dist 를 그대로 읽어 «가장 긴 것»을 찾아 다시 쟀다. 짐작으로 채우지 않는다. */
/* 🔴 2026-09-04 — **손님이 치는 말은 「birthday」인데 제목에 그 낱말이 없었다.**
   Search Console 28일치(2026-08-04~09-01)에서 그룹 지면에 붙은 검색어 —
   ```
   「skz birthday」          노출 4 · 자리 65.5
   「ateez birthdays」        노출 2 · 자리 76.0
   「katseye members birthdays」 노출 2 · 자리 77.5
   「cortis birthday」        노출 2 · 자리 68.0
   「kpop birthdays in january」 노출 2 · 자리 69.0
   ```
   ⭐ 자리가 65~82 다. 사실상 «없는» 것이다. 지면은 있고 200 이며 생일을 실제로 싣고 있는데,
     제목이 「members age」라 그 물음의 말이 아니었다.
   ⚠ 바로 위 8/27 주석에 내가 스스로 적어 둔 것이 있다 — 원래 제목안은
     「members age and birthday」였는데 **길이 때문에 birthday 를 뺐다.** 그 뺀 낱말이
     정작 손님이 치는 말이었다.
   ⭐ 263개 그룹 이름을 다 넣어 다시 쟀다 — 새 제목의 최대가 «58자»다(NCT 계열이 가장 짧고
     Tacos de asada y cebollin 이 가장 길다). 60자를 넘는 것이 **0장**이라 꼬리를 뗄 일이 없다.
   ⛔ 낱말을 쌓은 것이 아니다. 이 지면은 실제로 «생일과 나이»를 둘 다 싣는다.
   ⚠ 이 바꿈으로 자리가 오를지는 «모른다». 2026-09-11 에 같은 자로 다시 잰다 —
     node scripts/check-ranked-but-unclicked.mjs */
/* 🔴 [2026-10-05 · 5번] **콜론이 「members age」를 끊고 있었다.**
   실측(en/us 자동완성) — bts·blackpink·newjeans·aespa·ive·stray kids·seventeen·twice
   모두 「X members age」가 10줄을 꽉 채운다. 그런데 우리 제목은
   「members: birthdays and ages」라 그 말이 «연속으로» 없었다.
   ⇒ 콜론을 빼고 ages 를 앞으로 당긴다. 263개를 다 재니 최대 57자(60자 넘는 것 0장).
   ⛔ 낱말을 쌓은 것이 아니다 — 이 지면은 실제로 나이와 생일을 둘 다 싣는다. */
const 제목긴것 = `${g.name} members ages and birthdays ${기준해}`;
const TITLE = 제목긴것.length <= 60 ? 제목긴것 : `${g.name} members ages ${기준해}`;
/* ⭐ 2026-09-04 — 설명에도 손님이 치는 말(「birthday」)을 앞에 둔다.
   ⚠ 263장을 다 재고 바꿨다 — 새 설명의 최대가 126자다(옛것은 149자). 155자를 넘는 것이 0장이다.
   ⛔ 뜻은 그대로다. 이 지면은 실제로 멤버마다 생일을 싣는다. */
/**
 * 🔴 [2026-09-05] **팬이 치는 이름을 우리 지면이 안 썼다.**
 *   서치콘솔에서 「skz birthday」가 순위 65.5 · 클릭 0 으로 잡혔다. 답은 우리에게 있는데
 *   손님이 치는 말이 지면에 없었다. 위키백과 넘김을 171개 그룹에 대고 재 보니
 *   **16개 그룹의 약칭이 지면에 한 번도 안 나온다** — TVXQ→DBSK·DBSG·THSK, EXO→EXO-K·EXO-M.
 * ⭐ 그래서 그 약칭을 지면에 «싣는다». 우리가 지어낸 이름이 아니라, 그 이름으로 찾아올 사람이
 *   있다고 보고 «누군가 위키백과에 만들어 둔» 넘김이다.
 * ⛔ 약칭이 없는 그룹에는 아무것도 안 붙인다 — 없는 것을 채우지 않는다.
 */
const 별명 = ((별명자료.rows ?? []).find((r: any) => r.slug === g.slug)?.missingNames ?? []) as string[];

/* ── 지면의 «모양»을 자료에서 읽는다 ─────────────────────────────────
 * 🔴 [2026-09-11 06:2x · 5번] `measure-page-sameness.mjs` 에 «구절 겹침»(3낱말) 칸을 붙이고
 *   다시 재니 그룹 지면 263장이 **구절 81%** 로 큰 갈래 가운데 가장 나빴다(어휘 89%).
 *   ⚠ 고치기 «전»에 잰 값이다 — 사람 지면에서는 뒤에 재서 나아졌는지 말할 수 없었다.
 * ⭐ 뺄 수 없는 것은 그대로 둔다(나이가 움직인다 · 현재 라인업이 아니다 · 별자리 뜻을 말하지
 *   않는다). 대신 «자료가 고르는» 문단을 더한다 — 크기·기록됨·해 폭·별자리 겹침·태어난 곳.
 * ⛔ 무작위가 아니다. 같은 자료면 같은 문장이다.
 * ⛔ 없는 사실을 만들지 않는다 — 다섯 다 이미 표에 있는 수를 «말»로 한 것이다.
 */
const 멤버들 = (g.members ?? []) as any[];
const 생일있는이 = 멤버들.filter((m) => m?.born);
const 해폭 = (g.oldestBornYear && g.youngestBornYear)
  ? Number(g.youngestBornYear) - Number(g.oldestBornYear) : null;
const 크기칸 = g.membersRecorded === 1 ? '혼자'
  : g.membersRecorded <= 4 ? '작다'
    : g.membersRecorded <= 7 ? '보통' : '크다';
const 기록칸 = g.membersWithBirthday === 0 ? '없다'
  : g.membersWithBirthday === g.membersRecorded ? '다있다' : '일부';
const 해폭칸 = 해폭 == null ? null
  : 해폭 === 0 ? '한해'
    : 해폭 <= 2 ? '좁다'
      : 해폭 <= 5 ? '보통'
        : 해폭 <= 9 ? '넓다' : '아주넓다';
/** 별자리가 겹치나 — 팬이 실제로 궁금해하는 것이고, 무리마다 다르다 */
const 별자리셈 = new Map<string, number>();
for (const m of 멤버들) {
  const n = m?.sign?.name;
  if (n) 별자리셈.set(n, (별자리셈.get(n) ?? 0) + 1);
}
const 별자리많은 = [...별자리셈.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))[0] ?? null;
const 별자리종수 = 별자리셈.size;
/** 태어난 곳 — 몇 곳인가. ⛔ 어디가 「더 좋다」를 말하지 않는다 */
const 곳셈 = new Set(멤버들.map((m) => m?.birthplace).filter(Boolean));

const DESC = `Every ${g.name} member birthday: ${g.membersWithBirthday} on record, `
  + `${나이글 ?? 'birth years listed'}. Ages as of ${기준해}, oldest to youngest.`
  + (별명.length ? ` Also written ${별명.join(', ')}.` : '');
---

<WikiTip title={TITLE} description={DESC}
  canonical={`https://www.kculturewire.com/group/${g.slug}`}
  jsonLd={그룹구조화(g, new Map(Object.entries(사람문 ?? {})))}>
  {/* 🔴 [2026-10-05] 제목은 「members ages」 연속을 살려야 해서 질문형을 못 담는다.
      「how old is …」도 손님이 많이 치는 말이라 h1 에서 잡는다. */}
  <h1>How old is {g.name}? Members ages and birthdays</h1>

  {/* 🔴 [2026-09-05] 팬이 치는 약칭을 «화면에도» 낸다. 설명에만 두면 지면 글에는 없는 것이다.
      ⛔ 없는 그룹에는 이 줄 자체가 안 나간다 — 빈 「Also written」을 만들지 않는다. */}
  {별명.length > 0 && (
    <p class="aka">Also written <b>{별명.join(', ')}</b>.</p>
  )}

  {/* ⭐ 답을 맨 앞에. 그리고 «기준 해»를 답과 같은 문단에 둔다 */}
  <p class="lead">
    Wikidata records <b>{g.membersRecorded}</b> {g.membersRecorded === 1 ? 'member' : 'members'} of
    {' '}<b>{g.name}</b>. <b>{g.membersWithBirthday}</b> of them have a birth date on record
    {나이글 && <>, {나이글}</>}. The ages below are <b>as of {기준해}</b>
    {/* 🔴 2026-08-27 10:4x — 이 반 문장이 여태 «설명(meta)에만» 있었다. 설명을 줄이려고
        재 보니 본문에는 「as of {기준해}」까지만 있고 「the birth dates are not」이 없었다.
        ⛔ 설명에서 뺄 말은 반드시 본문에 있어야 한다 — 그래서 여기로 옮겼다.
        ⚠ 이게 없으면 손님이 「생년월일도 2026년 기준인가」로 읽을 수 있다. 뜻이 뒤집힌다. */}
    {' '}&mdash; <b>the birth dates are not</b>.
  </p>

  {/*
    🔴 이 두 칸을 뺄 수 없다. 하나는 나이가 움직이는 수라서, 하나는 멤버 수가
      「현재 멤버」로 읽히면 틀린 수가 되기 때문이다.
  */}
  {/* 자료가 고르는 문단 — 위 「지면의 모양」 주석이 왜인지를 적어 두었다 */}
  <p class="shape">
    {크기칸 === '혼자' && (
      <><b>Wikidata records one person here.</b> Read this page as a single entry rather than a
      line-up: whatever else the group has had, the field we read holds one name.</>
    )}
    {크기칸 === '작다' && (
      <><b>This is a small line-up on record</b> — {g.membersRecorded} people, so every row below is
      a meaningful share of the group and one missing birth date changes the picture.</>
    )}
    {크기칸 === '보통' && (
      <><b>{g.membersRecorded} people are on record</b>, the usual size for a Korean group page here.</>
    )}
    {크기칸 === '크다' && (
      <><b>{g.membersRecorded} people are on record</b>, which is large enough that the table below is
      the point of this page rather than any single number in it.</>
    )}
    {기록칸 === '다있다' && (
      <> Every one of them has a birth date, so nothing in the age table is estimated.</>
    )}
    {기록칸 === '일부' && (
      <> {g.membersWithBirthday} of the {g.membersRecorded} have a birth date;{' '}
      {g.membersRecorded - g.membersWithBirthday} do not, and we leave those cells empty rather than
      guess.</>
    )}
    {기록칸 === '없다' && (
      <> <b>None of them has a birth date on record</b>, so there is no age table on this page — an
      empty answer is still an answer.</>
    )}
    {해폭칸 === '한해' && (
      <> Everyone with a date was born in <b>{g.oldestBornYear}</b> — a single-year line-up.</>
    )}
    {해폭칸 === '좁다' && (
      <> The birth years run {g.oldestBornYear}–{g.youngestBornYear}, a span of{' '}
      {해폭} {해폭 === 1 ? 'year' : 'years'}.</>
    )}
    {해폭칸 === '보통' && (
      <> The birth years run {g.oldestBornYear}–{g.youngestBornYear}, {해폭} years apart.</>
    )}
    {해폭칸 === '넓다' && (
      <> The birth years run {g.oldestBornYear}–{g.youngestBornYear} — {해폭} years between the
      oldest and youngest recorded.</>
    )}
    {해폭칸 === '아주넓다' && (
      <> The birth years run {g.oldestBornYear}–{g.youngestBornYear}, a <b>{해폭}-year</b> spread,
      which is wide for a group page and worth knowing before you read the ages.</>
    )}
    {별자리많은 && 별자리많은[1] > 1 && (
      <> {별자리많은[1]} of them share the same star sign ({별자리많은[0]}).</>
    )}
    {별자리많은 && 별자리많은[1] === 1 && 별자리종수 > 1 && (
      <> No two share a star sign — {별자리종수} different ones across{' '}
      {생일있는이.length} recorded birthdays.</>
    )}
    {곳셈.size > 1 && (
      <> Wikidata gives a birthplace for {g.birthplacesKnown} of them, across{' '}
      {곳셈.size} different places.</>
    )}
    {곳셈.size === 1 && (
      <> Every recorded birthplace here is the same one.</>
    )}
    {곳셈.size === 0 && (
      <> No birthplace is recorded for anyone here.</>
    )}
  </p>

  {/* 🔴 [2026-10-04 · 5번] 그룹마다 «다른» 수. 위의 한계 단락은 263장에 똑같이 나가므로
      그것만으로는 지면이 서로 구별되지 않는다. 잰 사실을 여기에 붙인다. */}
  {넷그룹 && 넷전체 && (
    <p>
      <b>On Netflix cast lists.</b>{' '}
      {넷그룹.넷플릭스 > 0 ? (
        <>{넷그룹.넷플릭스} of the {넷그룹.수} we matched for this group{' '}
        {넷그룹.넷플릭스 === 1 ? 'turns' : 'turn'} up in the cast of a Korean title that reached a
        weekly Netflix top 10. Across all {넷전체.아이돌} idols we hold birth dates for,{' '}
        {넷전체.넷플릭스에도} do — so this group sits{' '}
        {(넷그룹.넷플릭스 / 넷그룹.수) > (넷전체.넷플릭스에도 / 넷전체.아이돌) ? 'above' : 'below'}{' '}
        the overall share of {((넷전체.넷플릭스에도 / 넷전체.아이돌) * 100).toFixed(1)}%.</>
      ) : (
        <>None of the {넷그룹.수} we matched for this group appears in a Netflix top-10 cast list.
        That is the ordinary result — {넷전체.한명도없는그룹} of the {넷전체.그룹} groups we hold
        have nobody at all.</>
      )}
      {' '}<a href="/idols-on-netflix">How we counted</a>. This counts cast lists, not acting
      careers — a drama that never reached a weekly top 10 is not in our data.
    </p>
  )}

  <p class="warn">
    <b>Ages are as of {기준해}; birth dates do not move.</b> These are the members Wikidata records,
    not the current line-up — people who have since left are included and we cannot tell the two
    apart.
    {이름못쓴 > 0 && <> <b>{이름못쓴} of the {g.membersRecorded} {이름못쓴 === 1 ? 'is' : 'are'} counted
      but not named below</b> — their only name on Wikidata is written in Korean, and this is an
      English-language site.</>}
  </p>

  {/*
    🔴 벤치마킹으로 붙인 칸. 1위 지면은 소제목마다 «손님이 치는 다른 물음»을 받는다 —
      「누가 제일 나이가 많나」·「막내는 누구인가」·「나이순으로」.
      나는 소제목을 「우리 사정」(어디서 온 수인가)으로만 썼다.
    ⭐ 사장님 지시 「제목, 본문 중 위·가운데·마지막에 나와야」가 바로 이것이다.
    ⛔ 낱말을 쌓는 것이 아니라 **그 물음에 실제로 답을 적는다.** 답을 못 하면 안 쓴다 —
      맏이·막내는 생일이 있는 사람 중에서만 말할 수 있고, 그 한계를 같이 적는다.
  */}
  {맏이 && 막내 && 맏이.name !== 막내.name && (
    <section>
      <h2>Who is the oldest {g.name} member?</h2>
      <p>
        {/* ⚠ 여기서 「&mdash; 가 글자로 샌다」고 잠깐 판단했다가 «내가 틀렸다».
             태그를 regex 로 걷어낸 뒤 남은 것은 엔티티이고, 브라우저는 그것을 줄표로 그린다.
             지면이 아니라 «내 검사»가 틀렸다 — 오늘 아침 &#39; 때와 똑같은 자리다.
             ⭐ 뜻밖의 값이 나오면 자를 먼저 의심한다. 그래서 이 줄만 진짜 글자로 두고
               나머지 &mdash; 는 그대로 뒀다 — 멀쩡한 것을 고치지 않는다 */}
        <b>{문(맏이.name, 사람문) ? <a href={문(맏이.name, 사람문)}>{맏이.name}</a> : 맏이.name}</b>, born {맏이.bornText} {맏이.born.slice(0, 4)} —
        {' '}<b>{맏이.age}</b> in {기준해}.
        {' '}The youngest is <b>{문(막내.name, 사람문) ? <a href={문(막내.name, 사람문)}>{막내.name}</a> : 막내.name}</b>, born {막내.bornText} {막내.born.slice(0, 4)},
        {' '}<b>{막내.age}</b> in {기준해}. That is a gap of <b>{맏이.age - 막내.age}</b>
        {' '}{맏이.age - 막내.age === 1 ? 'year' : 'years'}.
      </p>
      {g.membersWithBirthday < g.membersNamed && (
        <p class="note fine">
          Oldest and youngest are read from the {g.membersWithBirthday} members whose birth date
          Wikidata records. {g.membersNamed - g.membersWithBirthday} more are named here without
          one, so they are in neither answer.
        </p>
      )}
    </section>
  )}

  <section>
    <h2>The members, oldest first</h2>
    <div class="scroll-x">
      <table>
        <thead>
          {/* 🔴 [2026-10-04 · 5번] 「Shares the date with」 칸을 더했다 —
              멤버마다 수가 달라 263장이 서로 구별되고, /born-on 366장으로 길이 난다 */}
          <tr><th>Name</th><th>Born</th><th>Age in {기준해}</th><th>Star sign</th>
            <th>Shares the date with</th>
            <th>Born in</th><th>Wikipedia languages</th></tr>
        </thead>
        <tbody>
          {g.members.map((m: any) => (
            <tr>
              <td class="nm">{문(m.name, 사람문)
                ? <a href={문(m.name, 사람문)}>{m.name}</a> : m.name}</td>
              <td>{m.born ? `${m.bornText}, ${m.born.slice(0, 4)}` : '—'}</td>
              <td class="tot">{m.age ?? '—'}</td>
              <td>{m.sign ? <a href={`/star-sign/${m.sign.slug}`}>{m.sign.name}</a> : '—'}</td>
              {/* ⛔ 날짜를 모르면 「—」.  */}
              <td>{(() => {
                const 날 = 같은날(m.born);
                if (!날) return '—';
                return 날.수 > 0
                  ? <a href={`/born-on/${날.월일}`}>{날.수} {날.수 === 1 ? 'other' : 'others'}</a>
                  : <a href={`/born-on/${날.월일}`}>nobody else</a>;
              })()}</td>
              <td>{m.birthplace ?? '—'}</td>
              <td>{m.languages ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note fine">
      A dash means we hold no figure, not a zero.
      {생일모름 > 0 && <> {생일모름} of the {g.membersNamed} named here have no birth date on
        Wikidata, so their age and star sign are blank rather than guessed.</>}
    </p>
  </section>

  <section class="warn-box">
    <h2>We are not telling you what a star sign means</h2>
    <p class="warn">
      <b>The sign column is arithmetic on a birth date and nothing else.</b> We do not say what
      any of it means, because we have not measured anything that would let us say it.
    </p>
    <p class="note">
      We did test the nearest thing to a claim. Across 1,047 Korean actors who reached a Netflix
      chart, the spread across birth-year animals was <b>indistinguishable from chance</b>.
      {' '}<a href="/star-signs">That test is here</a>, with the working shown.
      {' '}<b>Sign boundaries also move</b> by a few hours from year to year, so someone born on a
      boundary day may fall the other way in their own birth year.
    </p>
  </section>

  <section class="notes">
    <h2>Where these numbers come from, and what they do not say</h2>
    <ul>
      <li>
        <b>Wikidata</b> — group membership (P527), date of birth (P569), place of birth (P19),
        and the number of Wikipedia language editions that carry an article about each person. CC0.
      </li>
    </ul>
    <p class="note">
      <b>Wikipedia language count is not a measure of how good someone is.</b> It measures how
      widely they are written about, and it favours people who have been famous longer.
    </p>
    <p class="note">
      <b>We do not publish heights.</b> Wikidata records a height for about 3% of the Korean
      performers we hold, and a figure built on 3% would be wrong far more often than right.
    </p>
    <p class="note fine">
      We hold {data.groupsSeen} Korean groups in all. {data.groupsNotListed} of them have fewer
      than {data.minMembersToList} members we could name, and we do not publish a page for those —
      they are counted, not hidden.
    </p>
  </section>

  {/*
    🔴 벤치마킹으로 붙인 FAQ. 1위 지면에 있고 우리에겐 없었다.
    ⛔ 답을 «지어내지» 않는다. 아래 넷은 다 이 지면의 자료로 실제로 답할 수 있는 것이고,
      답할 수 없는 것(키·현재 멤버)은 «답할 수 없다고» 적는 것이 답이다.
  */}
  <section class="notes">
    <h2>Questions people ask about {g.name} members</h2>
    <h3>How many members does {g.name} have?</h3>
    <p>
      Wikidata records <b>{g.membersRecorded}</b>.
      {이름못쓴 > 0 && <> {g.membersNamed} of them are named here; the other {이름못쓴} have no
        English name on Wikidata, so we count them without naming them.</>}
      {' '}<b>This is not the current line-up</b> — the field holds everyone recorded as part of
      the group, including people who have left.
    </p>
    {맏이 && <>
      <h3>What year were {g.name} members born?</h3>
      <p>
        {나이글 ? <>They were {나이글}.</> : <>Birth years vary.</>}
        {' '}The full list of dates is in the table above. <b>Birth dates do not move; ages do</b> —
        the ages here are as of {기준해}.
      </p>
    </>}
    <h3>How tall are {g.name} members?</h3>
    <p>
      <b>We cannot tell you.</b> Wikidata records a height for about 3% of the Korean performers
      we hold. We would rather say we do not know than publish a figure that would be wrong far
      more often than right.
    </p>
    <h3>Where does this come from?</h3>
    <p>
      Wikidata, read by item number: group membership (P527), date of birth (P569), place of
      birth (P19). CC0. Nothing here is copied from a fan wiki or a news write-up.
    </p>
  </section>

  {/* ⭐ 오늘 이 이름이 움직였을 때만 붙는다. 없으면 아무것도 안 그린다 */}
  {이그룹영상들.map((v) => <KcwShorts set={v.set} says={v.says} />)}

  <section class="onward">
    <h3>Other groups</h3>
    <ul>
      {[...이웃, ...큰곳].slice(0, 5).map((x) => (
        <li><a href={`/group/${x.slug}`}>{x.name} members</a>
          <span class="fine"> &mdash; {수(x.membersNamed)}</span></li>
      ))}
    </ul>
    <h3>Other ways into the same people</h3>
    <ul class="walk">
      <li><a href="/born-on">Korean actors&rsquo; birthdays &mdash; all 366 days</a></li>
      <li><a href="/actors-in-their/20s">Korean actors by age</a></li>
      <li><a href="/hometowns">Where Korea&rsquo;s most-read stars were born</a></li>
      <li><a href="/school">Where Korean actors and singers studied</a></li>
      <li><a href="/most-read">The Korean names most people looked up this month</a></li>
    </ul>
  </section>
</WikiTip>

<style>
  .warn-box { border: 1px solid #b45309; border-radius: 6px; padding: .5rem 1rem; margin: 0 0 1.6rem; }
  .aka { font-size: .95rem; color: var(--muted); margin: -.4rem 0 1rem; }
  /* 자료가 고르는 문단 — 경고가 아니라 «읽는 법»이라 색을 달리 둔다 */
  .shape { border-left: 3px solid #6a8; padding-left: .8rem; line-height: 1.62; }
</style>
