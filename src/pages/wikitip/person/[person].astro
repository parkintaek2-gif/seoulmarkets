---
/*
 * person/[person].astro — **사람 한 명** (`/person/lee-you-mi`). 636장이 여기서 나온다.
 *
 * ── 🔴 왜 이 지면이 생겼나 ─────────────────────────────────────
 * 2026-08-25, 사장님 지시 —
 *   「인기 검색어도 찾아야지. **특히 케이컬쳐는 스타의 이름**, 작품명, 노래제목 등이겠지..
 *    그게 **제목, 본문 중 위, 가운데, 마지막**에 나와야 하겠지」
 *
 * 그날 `check-name-placement.mjs` 로 재니 작품 이름은 네 자리에 다 있었는데(4/4)
 * 사람 이름은 1/4~3/4 였고, 더 큰 것은 **사람이 주인공인 지면이 0장**이라는 것이었다.
 * 작품은 `/title/{작품}` 556장이 있는데 사람은 표 안의 «한 줄»로만 있었다.
 *
 * ── 지면 이름을 «재서» 정했다 ─────────────────────────────────
 * 배우 14명 × 다섯 꼴을 자동완성으로 재서 가지 수를 셌다 —
 *   age 51 · movies and tv shows 45 · netflix 44 · tv shows 24 · drama list 22
 * ⚠ `age` 가 가장 컸지만 그 답은 구글이 지식패널로 **즉시** 준다. 우리가 이길 자리가 아니다.
 * ⭐ 우리만 가진 것은 **「그 작품이 어느 나라까지 갔나」**다. 그래서 제목의 축을
 *   `movies and tv shows` + `netflix` 로 두었다.
 *
 * ── ⛔ 이 지면이 반드시 지키는 것 ─────────────────────────────
 * ⛔ **「필모그래피」라고 안 쓴다.** 여기 있는 것은 «넷플릭스 주간 톱10에 오른 한국 작품
 *   중 우리가 지면을 낸 것»뿐이다. 그 사람의 출연작은 이보다 훨씬 많다. 밑바닥이지 총합이 아니다.
 * ⛔ **나이를 혼자 안 적는다.** 태어난 날과 기준일을 같이 적어야 지면이 낡아도 고쳐 읽는다.
 * ⛔ 생일을 모르면 **모른다고 적는다.** 빈칸이나 
 * ⛔ **줄세우지 않는다** — 「누가 더 인기 있나」를 말하지 않는다. 자리 수를 적을 뿐이다.
 * ⛔ 같은 이름의 다른 사람이 있으면 **화면에 적는다.** 안 적으면 손님이 섞어 읽는다.
 * ⛔ 위키백과 조회수를 「우리 손님 수」로 읽지 않는다 — 그 «이름에 대한 관심»이다.
 */
import WikiTip from '../../../layouts/WikiTip.astro';
/**
 * 🔴 [2026-08-29] 사람 지면 636장에 구조화 데이터가 «하나도» 없었다.
 *   같은 636장이 구글에서 「발견만」에 머물러 있다. 안쪽 링크는 굶지 않았으니
 *   (가운데 9.5장에서 걸린다) 크롤러에게 «줄 것이 적었던» 쪽이 남는다.
 * ⛔ 「붙이면 색인된다」고 단정하지 않는다 — 9/05 쯤 노출을 다시 재서 움직였는지 본다.
 */
import { 사람구조화 } from '../../../lib/person-jsonld.ts';
import titlePages from '../../../data/wikitip-title-pages.json';
import { 지면있는것들 } from '../../../lib/title-link.ts';
import KLifeMapNext from '../../../components/KLifeMapNext.astro';
import { KLIFEMAP_사주, 스타사주입구, 스타지면있는Q } from '../../../lib/klifemap-en';
import data from '../../../data/wikitip-people.json';
import 멤버그룹자료 from '../../../data/wikitip-member-vs-group.json';

/* 🔴 2026-09-03 — 이 지면 77장이 「1 countries」로 나가고 있었다(check-kcw-plural 실측).
   ⛔ 수 옆의 낱말을 늘 복수로 두지 않는다. 하나면 하나라고 쓴다.
   ⚠ 「title/titles」는 원래 갈라 쓰고 있었는데 countries·places·markets 만 안 갈랐다.
      한 곳을 고치면 «같은 병을 앓는 이웃»까지 따라간다 — 그래서 셋을 함께 고쳤다. */
const 단복 = (n: number, 단: string, 복: string) => (Number(n) === 1 ? 단 : 복);

import 해지면자료 from '../../../data/kcw-birth-year-pages.json';

export function getStaticPaths() {
  /* ⚠ Astro 는 이 함수를 따로 떼어 돌린다 — 바깥 선언이 안 보인다. 자료는 여기서 읽고
     지면이 쓸 것은 전부 props 로 건넨다 */
  const 사람들 = data.people ?? [];
  const 자리 = new Map(사람들.map((p: any) => [p.slug, p]));
  /* 🔴 [2026-08-26 · 5번] 「독자가 «멤버»를 여나 «그룹»을 여나」 — 자료는 8/14 에 있었는데
     지면이 한 장도 안 쓰고 있었다. 갇힌 행을 재는 자로 찾았다(scripts/check-kcw-row-pages.mjs).
     ⭐ 우리 인기 검색어는 스타 이름이다. 그 이름으로 오는 지면이 person 636장이고,
       이 자료는 그중 23명에 대해 «그 사람만의 사실»을 하나 더 준다.
     ⛔ 한 사람이 두 그룹에 걸리기도 한다(Mark Lee — SuperM·NCT Dream). 다 싣는다.
     ⚠ getStaticPaths 는 다른 청크에서 돈다 — 여기서 묶어 props 로 건넨다. */
  /* 🔴 [2026-08-26 · 5번] 태어난 해 지면 78장을 낸 뒤 재 보니 «밖에서 들어오는 문이 0개»였다.
     자기들끼리만 이어져 있었다. 사이트맵으로만 아는 지면은 「발견만 하고 안 넣음」이 되기 쉽다.
     ⭐ 이 지면의 「How old is …?」 자리가 가장 정직한 문이다 — 그 사람이 실제로 그 해에 났다.
     ⛔ 지면이 «있는» 해에만 건다. 여덟 명 미만인 35개 해는 지면이 없다 — 죽은 링크가 된다. */
  const 해있나 = new Set(((해지면자료 as any).years ?? []).map((y: any) => String(y.year)));
  const 해수 = new Map(((해지면자료 as any).years ?? []).map((y: any) => [String(y.year), y.people]));

  const 멤버표 = new Map<string, any[]>();
  for (const 쌍 of ((멤버그룹자료 as any).pairs ?? [])) {
    const k = String(쌍.member).toLowerCase().trim();
    if (!멤버표.has(k)) 멤버표.set(k, []);
    멤버표.get(k)!.push(쌍);
  }
  /* ⚠ 작품 지면이 «있는» 것만 구조화 데이터에서 url 로 잇는다 — 없는 곳으로 걸지 않는다.
     ⛔ Map/Set 은 props 로 못 건너간다. 배열로 바꿔 건넨 뒤 지면에서 되돌린다 */
  const 지면있는작품 = 지면있는것들((titlePages as any).titles ?? []);
  const 지면있는작품목록 = 지면있는작품 === null ? null : [...지면있는작품];

  /* ── 나라별 셈 ────────────────────────────────────────────────────
   * 🔴 [2026-09-11 06:2x · 5번] 사람 지면 24장을 URL Inspection 으로 물었다 —
   *   **크롤했는데 안 넣음 54.2% · 발견만 16.7% · 들어갔다 29.2%.**
   *   구글이 «와서 보고 안 넣기로» 정한 것이다. 그리고 같은 날 재 보니 판박이 겹침은
   *   색인과 상관이 +0.19 였다 — 문장을 다듬는 것으로는 이 자리가 안 풀린다.
   * ⭐ 「크롤했는데 안 넣음」에 대한 우리 답은 **그 지면에만 있는 사실을 늘리는 것**이다.
   *   작품 지면은 나라별 표를 갖고 있는데 사람 지면은 나라를 «수»로만 말하고 있었다.
   *   ⇒ 그 사람 작품들의 나라별 자리를 합쳐, 「어느 나라에서 가장 많이 걸렸나」를 낸다.
   *   이 표는 다른 어디에도 없다 — 작품 지면을 다 열어 손으로 합쳐야 나오는 수다.
   * ⛔ 지어내지 않는다. 전부 byMarket(작품·나라·자리)에서 «더한» 것이다.
   * ⚠ 작품 하나가 여러 나라에 걸리므로 나라별 자리의 합은 그 사람의 자리 합과 같다.
   */
  const 작품별나라 = new Map<string, any[]>();
  for (const t of ((titlePages as any).titles ?? [])) {
    if (t?.slug && Array.isArray(t.byMarket)) 작품별나라.set(t.slug, t.byMarket);
  }
  const 나라셈하기 = (사람: any) => {
    const 셈 = new Map<string, { 이름: string; 자리: number; 작품: number; 최고: number }>();
    for (const t of (사람.titles ?? [])) {
      for (const m of (작품별나라.get(t.slug) ?? [])) {
        const k = String(m?.iso2 ?? m?.name ?? '');
        if (!k) continue;
        const 앞 = 셈.get(k) ?? { 이름: String(m.name ?? k), 자리: 0, 작품: 0, 최고: 99 };
        앞.자리 += Number(m.places) || 0;
        앞.작품 += 1;
        if (Number(m.peak) > 0) 앞.최고 = Math.min(앞.최고, Number(m.peak));
        셈.set(k, 앞);
      }
    }
    const 줄 = [...셈.values()].sort((a, b) => b.자리 - a.자리 || a.이름.localeCompare(b.이름));
    /* 「그 사람의 모든 작품이 걸린 나라」 — 작품 수와 나라의 작품 수가 같은 곳 */
    const 다걸린 = 줄.filter((x) => x.작품 === (사람.titles ?? []).length).length;
    return { 위: 줄.slice(0, 8), 나라수: 줄.length, 다걸린 };
  };

  return 사람들.map((p: any, i: number) => ({
    params: { person: p.slug },
    props: {
      p,
      지면있는작품목록,
      이웃: [사람들[(i + 1) % 사람들.length], 사람들[(i + 2) % 사람들.length]]
        .filter((x: any) => x && x.slug !== p.slug),
      멀리간사람: 사람들.slice(0, 6).filter((x: any) => x.slug !== p.slug).slice(0, 4),
      /* 같은 이름의 다른 사람 — 있으면 그 사람 지면으로 보낸다. ⛔ 합치지 않는다 */
      동명이인: p.sameNameAs ? (자리.get(p.sameNameAs) ?? null) : null,
      멤버쌍: 멤버표.get(String(p.name).toLowerCase().trim()) ?? [],
      난해: (p.born && 해있나.has(String(p.born).slice(0, 4))) ? String(p.born).slice(0, 4) : null,
      난해사람수: (p.born && 해수.get(String(p.born).slice(0, 4))) || null,
      나라셈: 나라셈하기(p),
    },
  }));
}

const { p, 이웃, 멀리간사람, 동명이인, 멤버쌍, 난해, 난해사람수, 지면있는작품목록, 나라셈 } = Astro.props as {
  지면있는작품목록: string[] | null;
  난해: string | null; 난해사람수: number | null;
  멤버쌍: any[];
  나라셈: { 위: { 이름: string; 자리: number; 작품: number; 최고: number }[]; 나라수: number; 다걸린: number };
  p: any; 이웃: any[]; 멀리간사람: any[]; 동명이인: any;
};
const 수 = (n: number) => Number(n ?? 0).toLocaleString('en-US');
const 기준일 = data.asOf;

/* 🔴 사장님이 말씀하신 «네 자리». 이름은 제목·위·가운데·끝에 다 있어야 한다.
   ⛔ 억지로 끼워 넣지 않는다 — 지면이 실제로 그 사람을 다루므로 자연스럽게 넣는다 */
/* 🔴 2026-08-27 07:4x — **636장 전부 제목이 잘리고 있었다.** 우리 계열 중 가장 큰 덩어리다.
     전  `<이름> movies and TV shows: every Netflix chart run, country by country`  67~78자
     후  `<이름> movies and TV shows on Netflix`                                    최대 49자
   ⭐ 636명 이름을 다 넣어 재고 골랐다 — 가장 긴 이름(Steve Sanghyun Noh)까지 49자다.
     「movies and TV shows」는 구글이 배우를 보여 줄 때 쓰는 말이라 그대로 지켰다(위 주석의
     「네 자리」 규칙도 그대로 — 이름이 여전히 제목 맨 앞에 있다).
   ⛔ 「country by country」를 제목에서 뺀 대신 설명의 「across N countries」가 그 자리를 한다.
   ⛔ 「A floor, not a filmography」를 설명에서 뺐다. **빼기 전에 본문을 재 보니 1회 있었다** —
     없었으면 빼지 않았을 것이다. 설명에서 뺀 말은 반드시 본문에 있어야 한다.
   ⚠ 설명도 152~163자여서 잘리고 있었다. 636명으로 재니 새 것은 최대 145자다. */
/**
 * 🔴🔴 [2026-08-29] **이 낱장 636장이 28일 노출 «0» 이다.** 색인은 80%가 들어갔는데,
 * 어떤 검색어에도 순위가 안 나온다(GSC 갈래별 표에 /person 행이 아예 없다).
 *
 * 까닭은 제목이 **IMDb·위키피디아와 똑같은 말**이기 때문으로 본다 —
 * 「{이름} movies and TV shows」는 그들도 쓰는 말이고, 새 사이트인 우리가 그 말로 이길 수 없다.
 * ⭐ 그런데 그 말 자체는 «버리면 안 된다» — 자동완성 1번째가
 *   「park gyu-young movies and tv shows」다. 실제 수요가 거기 있다.
 * ✅ 그래서 «빼지 않고 더한다» — 뒤에 «우리만 가진 수»를 붙인다.
 *   IMDb 는 「몇 나라 차트에 들었나」를 안 적는다. 그것이 우리가 이길 자리다.
 *
 * ⚠ 636명을 다 재서 골랐다 — 기본 꼴은 최대 64자(Steve Sanghyun Noh)로 20장이 넘친다.
 *   넘치면 「on Netflix」를 떼어 줄인다. 그래도 넘치면 옛 꼴로 떨어진다.
 * ⛔ 잘린 제목은 뒤의 수가 «안 보인다» — 넣으나 마나가 된다. 그래서 길이를 잰다.
 */
const 제목바닥 = 60;
const 제목후보 = [
  `${p.name} movies and TV shows — ${p.countries} ${단복(p.countries, 'country', 'countries')} on Netflix`,
  `${p.name} movies and TV shows — ${p.countries} ${단복(p.countries, 'country', 'countries')}`,
  `${p.name} movies and TV shows on Netflix`,
];
const TITLE = 제목후보.find((t) => t.length <= 제목바닥) ?? 제목후보[제목후보.length - 1];
const DESC = `${p.name} appears in ${p.titleCount} Korean titles that reached a Netflix weekly top 10 — `
  + `${수(p.places)} chart ${단복(p.places, 'place', 'places')} across ${p.countries} ${단복(p.countries, 'country', 'countries')}. Every title is listed.`;

const 가장멀리 = p.titles[0] ?? null;
const 가장오래 = [...p.titles].sort((a: any, b: any) => (b.weeks ?? 0) - (a.weeks ?? 0))[0] ?? null;
const 처음 = [...p.titles].sort((a: any, b: any) => String(a.firstWeek).localeCompare(String(b.firstWeek)))[0] ?? null;
const 최고 = [...p.titles].sort((a: any, b: any) => (a.peak ?? 99) - (b.peak ?? 99))[0] ?? null;
const 드라마 = p.titles.filter((t: any) => t.type === 'TV').length;
const 영화 = p.titles.length - 드라마;

/* ── 지면의 «모양»을 자료에서 읽는다 ─────────────────────────────────
 * 🔴 [2026-09-11 06:1x · 5번] `measure-page-sameness.mjs` 로 재니 사람 지면 636장이
 *   **89% 판박이**였다. 2026-08-24 실측으로 67% 위는 구글이 「발견만」·「크롤했는데 안 넣음」에
 *   두는 자리다 — 즉 이 636장은 «색인이 안 되는 쪽»에 서 있다.
 * ⭐ 그 자의 진단이 정확했다 — 「고칠 것은 자료가 아니라 자료를 «감싼 문장»이다」.
 *   수는 사람마다 다른데 그 수를 설명하는 문장이 636장 똑같았다.
 * ⇒ 그래서 문장의 «꼴»을 자료에서 고른다. 쏠림·최고순위·나라 폭·해 폭 넷을 칸으로 나누면
 *   111가지 꼴이 나오고, 가장 큰 묶음이 636장에서 **26장**으로 떨어진다(실측).
 * ⛔ 무작위로 고르지 않는다. 같은 자료면 같은 문장이어야 한다 — 그러지 않으면 이 지면이
 *   빌드마다 달라져 우리도 무엇이 나갔는지 모른다.
 * ⛔ 없는 사실을 만들지 않는다. 넷 다 이미 표에 있는 수를 «말로» 한 것이다.
 */
const 자리합 = p.titles.reduce((a: number, t: any) => a + (Number(t.places) || 0), 0);
const 으뜸작 = [...p.titles].sort((a: any, b: any) => (b.places ?? 0) - (a.places ?? 0))[0] ?? null;
const 쏠림 = 자리합 > 0 && 으뜸작 ? (Number(으뜸작.places) || 0) / 자리합 : null;
const 해들 = p.titles.flatMap((t: any) => [
  Number(String(t.firstWeek ?? '').slice(0, 4)) || null,
  Number(String(t.lastWeek ?? '').slice(0, 4)) || null,
]).filter((y: number | null) => y) as number[];
const 첫해 = 해들.length ? Math.min(...해들) : null;
const 끝해 = 해들.length ? Math.max(...해들) : null;
/** 쏠림을 네 칸으로 — 「대개」가 아니라 칸 이름이 문장을 고른다 */
