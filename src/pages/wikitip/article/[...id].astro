<style>
  /* 카드뉴스 — 한 줄로 늘어놓고 옆으로 민다. ⛔ 넘김 단추를 만들지 않는다(정적 지면이다) */
  .cardnews { margin: 2.6rem 0; }
  .cardnews .cards { display: flex; gap: .6rem; overflow-x: auto; padding-bottom: .5rem; }
  .cardnews img { width: 200px; height: auto; border-radius: 8px; flex: 0 0 auto; background: #0e0c14; }

  /* 🔴 2026-10-23 · 1번 — 출처 주소에 끊을 자리가 없으면(위키백과 «Doctor_X:_Age_of_…») 폰 폭이 445px 로
