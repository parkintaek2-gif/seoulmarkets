  .onward a { color: var(--accent); }
  /* B2B 로 나가는 길. ⛔ 광고 자리가 아니라 우리 물건이다 — 화면에서도 그렇게 보이게 조용히 둔다 */
  .b2b { margin-top: 2.6rem; padding: 1rem 1.1rem; background: var(--card);
         border: 1px solid var(--line); border-radius: 6px; font-size: .92rem; }
