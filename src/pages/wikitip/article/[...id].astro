---
/**
 * K Culture Wire — 기사 지면. (`/article/<slug>`)
 *
 * ── 왜 SeoulMarkets 기사 라우트를 안 쓰나 ──────────────────────
 * `src/pages/article/[...id].astro` 는 `Base.astro`(금융 머리말)에 `SITE_URL`
 * (seoulmarkets.com)로 붙는다. 그대로 쓰면 K컬처 도메인에 금융 매체 얼굴이 나간다 —
 * 8/3 에 `/esports` 제목이 「… | SeoulMarkets」로 나갔던 그 사고다.
 *
 * ── 왜 이 지면이 생겼나 (사장님 지시 2026-08-05 11:30) ─────────
 * 「네가 할 일은 **영어뉴스+데이터가공**이다」. 8/6 까지 K Culture Wire 는
 * 데이터 지면 7장뿐이고 **기사가 0편**이었다. 그릇이 없어서 못 쓴 것이라 먼저 만들었다.
 *
 * ── 출처·검증을 본문 아래에 그대로 편다 ────────────────────────
 * 사장님 지시 「아직은 언론사가 아니다. 그 자격에 기대지 않는다」 —
 * 우리가 파는 것은 숫자의 신뢰다. **무엇을 뺐는지까지** 지면에 적는다.
 * ⛔ 광고 자리를 만들지 않았다. Riot Production(App 866800) 승인 전에 광고가 뜨면
 *    API 가 영구 취소된다. `WikiTip.astro` 와 같은 이유다.
 */
import { getCollection, render } from 'astro:content';
import cardnewsData from '../../../data/wikitip-cardnews.json';
import WikiTip from '../../../layouts/WikiTip.astro';
import { 이웃표 } from '../../../lib/kcw-neighbours.mjs';
import ContentRail from '../../../components/ContentRail.astro';
/* 🔴 [2026-11-15 · 사장님] 「광고는 케이컬쳐만 … 거기에만 광고 넣어」 */
import AdSlot from '../../../components/AdSlot.astro';
import starPages from '../../../data/klifemap-star-pages.json';
import { 자매링크 } from '../../../lib/sister-link';

export async function getStaticPaths() {
  const all = await getCollection('kcwArticles');
  const live = all.filter((e) => !e.data.draft);
  return live.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;

/* 태그 → 주소. `tag/[tag].astro` 와 «같은 규칙»이어야 한다 — 어긋나면 링크가 404 가 된다 */
const 태그슬러그 = (t: string) => String(t ?? '').toLowerCase()
  .replace(/[’'`]/g, '').replace(/&/g, ' and ')
  .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

/* ⛔ 한 편짜리 태그는 지면이 없다. 링크로 걸면 404 가 되므로 «지면이 있는 것만» 링크한다.
   그래서 여기서 태그별 편수를 다시 센다 — tag 지면과 같은 문턱(2편)을 쓴다 */
const 태그수 = new Map<string, number>();
for (const e of (await getCollection('kcwArticles')).filter((x: any) => !x.data.draft)) {
  for (const t of (e.data.tags ?? [])) {
    const s = 태그슬러그(t);
    if (s) 태그수.set(s, (태그수.get(s) ?? 0) + 1);
  }
}
const 태그지면 = new Set([...태그수].filter(([, n]) => n >= 2).map(([s]) => s));

/* 이 기사의 카드뉴스. ⛔ 없으면 null 이고 아무것도 안 그린다 — 빈 상자는 없는 것만 못하다.
   ⛔ 장수를 손으로 적지 않는다. build-kcw-cardnews-index.mjs 가 파일을 세어 적어 둔다 */
const 카드뉴스 = (cardnewsData.sets ?? []).find((c) => c.set === entry.id) ?? null;
const { Content } = await render(entry);

/**
 * 🔴 [2026-10-26 · 5번] **이 기사의 주인공이 KLifeMap 에 지면을 가지고 있으면 그리로 보낸다.**
 *
 * 그날 KLifeMap 을 재니 — 돈 되는 지면 12장이 구글 색인에 하나도 없고, 그 가운데 열 장은
 * 구글이 «읽고도 안 넣었다». 사이트맵·robots·hreflang·내부 링크·본문 길이에 흠은 없었다.
 * 남은 설명은 «밖에서 들어오는 링크»인데, 우리 네 사이트는 **첫 화면끼리만** 이어져 있었다.
 * KCW 기사 한 장을 열어 보니 klifemap 링크가 바닥글 하나(첫 화면行)뿐이었다.
 *
 * ⇒ 주제가 맞는 속 지면끼리 잇는다. KCW 기사 43편이 KLifeMap 스타 지면 24명분으로 간다.
 *
 * ⛔ **본문에서 이름을 찾지 않는다.** 본문으로 재니 「V」가 146편, 「Ten」이 43편 걸렸다 —
 *   로마숫자와 열(ten)이 사람 이름으로 잡힌 것이다. 태그는 사람이 그 기사의 주인공으로
 *   붙인 것이라 그 거짓이 없다. **태그만 본다.**
 * ⛔ 주소를 지어내지 않는다 — `klifemap-star-pages.json` 은 `/all?lang=en` 화면에 실제로
 *   걸려 있는 링크를 긁어 만든 표다.
 */
const 스타표 = new Map(
  (starPages.스타 ?? []).map((s: any) => [String(s.이름).toLowerCase(), s]),
);
const 이기사의스타 = [...new Map(
  (d.tags ?? [])
    .map((t: string) => 스타표.get(String(t).toLowerCase()))
    .filter(Boolean)
    .map((s: any) => [s.이름, s]),
).values()] as any[];

/**
 * 같은 자료 지면을 쓴 다른 기사. **규칙으로 뽑는다** — 손으로 고르면 다음에 빠진다.
 * ⛔ 순위로 세우지 않는다. 낸 순서다.
 */
const 모든기사 = (await getCollection('kcwArticles')).filter((e) => !e.data.draft);
const 전체기사수 = 모든기사.length;

/**
 * 🔴 2026-08-21 — 실측: 107편 중 **33편이 나가는 기사 링크가 0개**, 51편이 3개 미만이었다.
 *   `pages` 를 공유하는 기사만 이웃으로 삼았는데, 지면 하나에 기사 하나인 편이 많아서다.
 *   2번: 「손님 188명이 **한 편만 읽고 나간다**」 — 그 막다른 길이 여기였다.
 *
 * ⭐ 그래서 **세 겹으로** 채운다. 어느 겹이든 «규칙»이지 손으로 고르는 것이 아니다.
 *   ① 같은 자료 지면을 쓴 기사      가장 가깝다
 *   ② 태그가 겹치는 기사            많이 겹치는 순 → 최신순
 *   ③ 같은 갈래(category)의 최신 기사  ①②로 셋이 안 차면
 * ⛔ 순위·인기로 세우지 않는다. ⛔ 자기 자신은 안 넣는다. ⛔ 같은 기사를 두 번 안 넣는다.
 * ⚠ 셋으로 맞춘다 — 넷을 주면 고르기가 어려워지고, 둘은 막다른 길에 가깝다.
 *
 * 🔴 2026-08-22 — **셋을 채우는 것만으로는 부족했다.** 같은 규칙으로 «누가 가리켜지나»를 세니
 *   108편이 가리키는 서로 다른 기사가 83편이고 **25편은 아무도 안 가리켰다**(한 편에 최다 19번).
 *   둘째 겹이 「겹침 수 → 최신순」이라 최근에 낸 편들끼리 태그를 나눠 가지고 **서로를 물었다.**
 *   ⛔ 「관련기사 3개가 다 있다」와 「108편이 다 문이 된다」는 다른 말이다 — 8/21 에 앞의 것만 재고 닫았다.
 *
 *   그래서 세 자리 중 **셋째를 「덜 가리켜진 편」에게 준다.** 규칙은 한 자리
 *   (`src/lib/kcw-neighbours.mjs`)에 두고 지면은 읽기만 한다 — 자는 `check-kcw-article-doors.mjs`.
 *   잰 것: 안 가리켜지는 편 **0편** · 가리켜지는 서로 다른 편 **108편(전부)** · 최다 15번.
 *   ⚠ 셋째 자리도 **이 기사의 후보 안에서만** 고른다. 문을 고르게 내는 것과 엉뚱한 문을
 *     내는 것은 다르다.
 */
const 이웃id = 이웃표(
  모든기사.map((e) => ({
    id: e.id,
    pages: e.data.pages ?? [],
    tags: e.data.tags ?? [],
    category: e.data.category,
    pubDate: e.data.pubDate,
  })),
).get(entry.id) ?? [];
const 기사찾기 = new Map(모든기사.map((e) => [e.id, e]));
const 이웃 = 이웃id.map((id) => 기사찾기.get(id)).filter(Boolean);

const url = `https://www.kculturewire.com/article/${entry.id}`;
/**
 * 이 기사만의 공유 카드. `scripts/make-og-articles.mjs` 가 미리 만들어 둔다.
 * ⛔ 8/8 아침까지 36편이 **같은 /og.svg** 를 달고 있었다. SVG 는 카카오톡·X·페이스북이 안 그린다 —
 *    공유되는 순간이 유입의 첫 칸인데 그 칸이 비어 있었다.
 * ⚠ 카드가 없는 기사는 여기가 404 가 된다. `check-visitor-walk.mjs` 가 그걸 잡는다.
 */
const 카드 = `https://www.kculturewire.com/og/${entry.id}.png`;
const iso = (v: Date) => new Date(v).toISOString();
/**
 * 🔴 2026-08-08 17:5x — **날짜가 라이브에서 하루 일찍 나가고 있었다.**
 *
 * frontmatter 의 dataAsOf 는 `2026-07-26T00:00:00+09:00`(KST 자정)이다.
 * `toLocaleDateString` 에 timeZone 을 안 주면 **그리는 기계의 시간대**로 그린다.
 * 내보내는 기계는 UTC 라 그 순간이 7월 25일 15시 → 화면에 **25 July** 로 나갔다.
 * 45편 전부가 그랬고, 내 화면(KST)에서는 26 July 라 **영원히 안 보였다.**
 *
 * ⛔ 우리 날짜는 KST 로 적는다. 그리는 것도 KST 로 못박는다.
 *    같은 병을 값 쪽에서 지키는 자는 `scripts/check-price-dates.mjs` 다.
 */
const 날짜 = (v: Date) =>
  new Date(v).toLocaleDateString('en-GB', { timeZone: 'Asia/Seoul', day: 'numeric', month: 'long', year: 'numeric' });

/**
 * 갈래 이름 — 화면의 빵가루 링크와 articleSection·BreadcrumbList 가 «같은 것»을 쓴다.
 *
 * 🔴 [2026-09-03 실측] 이 지도가 실제 갈래와 안 맞았다.
 *   적혀 있던 것   screen · music · esports · people · industry
 *   실제로 쓰는 것 stars 49편 · titles 64편 · industry 27편 · tradition 3편
 *   → screen·music·people 은 «한 편도 없는» 갈래였고, stars·titles·tradition 은 지도에 없어
 *     화면에 소문자 그대로(「titles」) 나가고 있었다. 영문 매체가 제 갈래 이름을 소문자로 냈다.
 * ⛔ 없는 갈래를 지도에 두면 다음 사람이 «그 갈래가 있다»고 읽는다. 실제로 세어 맞춘다.
 * ⚠ /section/<갈래> 네 장이 다 살아 있는 것을 라이브 200 으로 확인했다 —
 *   빵가루가 없는 주소를 가리키면 없는 것보다 나쁘다.
 */
const CATEGORY: Record<string, string> = {
  stars: 'Stars', titles: 'Titles', industry: 'Industry', tradition: 'Tradition',
};

/**
 * ⭐ [2026-09-03 · 5번] 실측으로 두 구멍을 찾아 채운다.
 *
 *   BreadcrumbList   세 사이트 통틀어 «0장»이었다. 이것이 있으면 검색 결과에
 *                    날 주소(kculturewire.com/article/ten-wikipedias-…) 대신
 *                    「K Culture Wire › Stars › 제목」이 뜬다.
 *   Dataset          KCW 기사 143편 중 **139편에 표가 있는데 0편**에 붙어 있었다.
 *                    6번(서울마켓)은 61편 중 61편에 붙인다 — 우리만 빠져 있었다.
 *
 * [왜 지금 이것을 하나 — 제목을 못 건드리기 때문이다]
 *   같은 날 실측: KCW 는 100yearmap 보다 «노출이 더 많은데»(5,010 대 4,712)
 *   클릭이 3분의 1이다(34 대 96). 못 찾는 게 아니라 «안 눌리는» 것이다.
 *   고칠 자리는 제목·설명인데 /market·/group·/esports 와 기사 여덟 편 묶음이
 *   9/24~30 까지 실험 중이라 손댈 수 없다.
 *   ✅ 그래서 «제목 글자를 안 건드리고 검색 결과의 모양을 바꾸는» 길을 쓴다.
 *      구조화 데이터는 실험이 재는 값(제목·설명 글자)을 건드리지 않는다.
 *
 * [GEO 에도 걸린다]
 *   Dataset 은 AI 가 우리를 인용할 때 «무엇을 잰 표인지»를 읽는 자리다.
 *   distribution 이 기사별 마크다운 판(.md)을 그대로 가리킨다 — 이미 143편 다 있다.
 *
 * ⛔ 표가 없으면 Dataset 을 «안 낸다». 없는 것을 있다고 하지 않는다.
 */
const 절이름 = CATEGORY[d.category] ?? d.category;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'K Culture Wire', item: 'https://www.kculturewire.com/' },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: 'https://www.kculturewire.com/articles' },
    { '@type': 'ListItem', position: 3, name: 절이름, item: `https://www.kculturewire.com/section/${d.category}` },
    { '@type': 'ListItem', position: 4, name: d.title, item: url },
  ],
};

/**
 * 본문 첫 마크다운 표의 머리글을 variableMeasured 로 낸다.
 * ⛔ 이 정규식은 `src/pages/article/[...id].astro` 의 표찾기() 와 «똑같이» 유지한다 —
 *    두 사이트가 다른 자를 쓰면 한쪽이 통과할 때 한쪽이 못 잡는 일이 생긴다.
 */
function 표찾기(본문: string): string[] | null {
  const m = 본문.match(/^\|(.+)\|\r?\n\|[\s:|-]+\|\r?\n(?:\|.*\|\r?\n?)+/m);
  if (!m) return null;
  const 칸들 = m[1].split('|').map((x) => x.trim()).filter(Boolean);
  return 칸들.length ? 칸들 : null;
}
const 표머리 = 표찾기(entry.body ?? '');
const datasetLd = 표머리
  ? {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: d.title,
      description: d.dek,
      url,
      datePublished: iso(d.pubDate),
      dateModified: iso(d.updatedDate ?? d.pubDate),
      variableMeasured: 표머리,
      creator: { '@type': 'Organization', name: 'K Culture Wire' },
      distribution: { '@type': 'DataDownload', encodingFormat: 'text/markdown', contentUrl: `${url}.md` },
      isAccessibleForFree: true,
      /**
       * ⭐ [2026-09-03 · 5번] 구글 «데이터셋 검색»(Dataset Search)에 걸리도록 권장 칸을 채운다.
       *
       * [왜 — 사장님이 「함께 찾으라」 하신 그 문제의 답 하나다]
       *   4번 진단: 「검색엔진이 아직 우리를 실어주지 않는 초기 단계」.
       *   보통 검색에서 신뢰를 쌓는 데는 몇 달이 걸린다. 그런데 **데이터셋 검색은 다른 통로**이고,
       *   우리는 오늘 Dataset 스키마를 139편에 붙여 «자격을 새로 얻었다».
       *   경쟁이 얕은 통로에서 시작하는 것이 넓은 말과 정면으로 싸우는 것보다 싸다 —
       *   3번이 지역명·대학명으로 이미 증명한 것과 같은 셈이다.
       *
       * [⛔ 지어내지 않은 것 — license]
       *   구글이 권장하는 칸 가운데 `license` 를 **비워 두었다.**
       *   우리 표를 어떤 조건으로 쓸 수 있는지는 **법적·사업적 결정**이고 아직 정해지지 않았다.
       *   CLAUDE.md 가 「데이터 출처 라이선스를 먼저 확정한다」고 못박은 자리다.
       *   ⛔ 없는 결정을 스키마에 적으면 그것이 «약속»이 된다. 정해지면 그때 넣는다.
       *
       * [채운 셋은 다 «사실»이다]
       *   temporalCoverage  이 표가 «언제까지의» 자료인가 — frontmatter 의 dataAsOf 그대로
       *   spatialCoverage   우리는 한국을 잰다 — 어느 기사든 그렇다
       *   keywords          frontmatter 의 tags 그대로. 우리가 새로 붙인 말이 아니다
       */
      temporalCoverage: iso(d.dataAsOf ?? d.pubDate).slice(0, 10),
      spatialCoverage: { '@type': 'Place', name: 'South Korea' },
      keywords: d.tags ?? [],
    }
  : null;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  headline: d.title,
  description: d.dek,
  image: [카드],
  datePublished: iso(d.pubDate),
  dateModified: iso(d.updatedDate ?? d.pubDate),
  articleSection: CATEGORY[d.category] ?? d.category,
  inLanguage: 'en',
  author: { '@type': 'Organization', name: 'K Culture Wire' },
  publisher: { '@type': 'Organization', name: 'K Culture Wire' },
};

/* ⛔ Dataset 은 표가 있을 때만 낸다 — filter(Boolean) 이 그 몫이다 */
const jsonLd = [articleLd, breadcrumbLd, datasetLd].filter(Boolean);
---

<WikiTip title={d.title} description={d.dek} canonical={url} jsonLd={jsonLd}
  ogImage={카드}>
  {/* 🔴 [2026-09-16 · 사장님] 「1칼럼을 2칼럼으로」 ·
