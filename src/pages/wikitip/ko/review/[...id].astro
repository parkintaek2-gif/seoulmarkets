---
/**
 * K Culture Wire — **리뷰 본문.** (`/ko/review/<slug>`)
 *
 * ── 🔴🔴 사장님 지시 (2026-10-26) ─────────────────────────────────────
 * 「**스포츠에선 각 팀의 엠블럼을 사진으로 쓰지말고, 각 팀이나 해당 협회 사이트에서
 *   제공하는 사진을 써라. TV프로그램은 각 방송사 홈페이지에서 사진을 갖다 써라.
 *   OTT 프로그램은 타사 기사 중 제공처가 OTT인 사진을 갖다가 써라.**」
 * 「리뷰는 1. 방송이면 최근회차 내용, OTT면 공개된 회차 내용, K-POP이면 최근 공연, 음원
 *   2. **스포츠는 당일 경기 내용과 결과, 다음 경기 일정 포함** 등을 중심으로 함.
 *   **리뷰라고 꼭 비평일 필요는 없다. 오히려 네티즌들의 댓글을 리뷰로 사용하도록 해라.**」
 *
 * ⇒ 사진 규칙은 본 지면이 아니라 `src/lib/리뷰사진규칙.mjs` 가 검증한다. 위반 시 **빌드가 중단**된다.
 *   지면에서 차단하면 지면을 추가할 때 또 누락된다 — 본 저장소가 수차례 겪은 결함 유형이다.
 *
 * ── ⛔ 본 지면이 준수하는 사항 ────────────────────────────────────────
 * ⛔ **사진 하단에 제공처를 반드시 기재한다.** 「제공」은 부기하지 않는다 —
 *   중부매일 지침 v7 과 동일한 형식(`설명. / 라이엇 게임즈`)으로 통일한다.
 * ⛔ **평점을 부여하지 않는다.** 강령 — 우리가 바늘을 세우지 않는다.
 *   관찰한 내용을 기재하고, 판단은 독자가 한다. 사장님도 「꼭 비평일 필요는 없다」고 하셨다.
 * ⛔ 광고 영역을 생성하지 않는다. Riot Production(App 866800) 승인 전이다.
 */
import { getCollection, render } from 'astro:content';
import WikiTip from '../../../../layouts/WikiTip.astro';
import { 분류조회 } from '../../../../lib/리뷰분류.mjs';

export async function getStaticPaths() {
  const 전체 = await getCollection('kcwReviews');
  return 전체.filter((e) => !e.data.draft)
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const 해당분류 = 분류조회(d.category);

const 날짜표기 = (x: Date) => {
  const t = new Date(x);
  return `${t.getFullYear()}년 ${t.getMonth() + 1}월 ${t.getDate()}일`;
};

const 정본주소 = `https://www.kculturewire.com/ko/review/${entry.id}`;

/**
 * ⛔ `Review` 가 아니라 `Article` 로 발행한다. schema.org 의 Review 는 **평점이 중심**이고,
 *   당사는 평점을 부여하지 않는다. 평점 없는 Review 를 발행하면 구글이 조각을 생성하지 못하고,
 *   임의로 평점을 생성하면 강령을 위반한다.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  inLanguage: 'ko',
  headline: d.title,
  description: d.dek,
  datePublished: new Date(d.pubDate).toISOString(),
  ...(d.updatedDate ? { dateModified: new Date(d.updatedDate).toISOString() } : {}),
  mainEntityOfPage: 정본주소,
  about: { '@type': 'Thing', name: d.subject.명칭 },
  author: { '@type': 'Organization', name: d.author },
  publisher: { '@type': 'Organization', name: 'K Culture Wire' },
  ...(d.image ? { image: [`https://www.kculturewire.com${d.image.src}`] } : {}),
};

/* 동일 분류의 타 리뷰 — 이용자가 다음 글로 이동하게 한다. ⛔ 자기 자신은 제외한다 */
const 관련리뷰 = (await getCollection('kcwReviews'))
  .filter((e) => !e.data.draft && e.id !== entry.id && e.data.category === d.category)
  .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate))
  .slice(0, 5);
---

<WikiTip
  title={d.title}
  description={d.dek}
  lang="ko"
  page={`/ko/review/${entry.id}`}
  jsonLd={jsonLd}
  ogImage={d.image ? `https://www.kculturewire.com${d.image.src}` : undefined}
>
  <article>
    <p class="cat"><a href={`/ko/${d.category}`}>{해당분류?.명칭 ?? d.category}</a></p>
    <h1>{d.title}</h1>
    <p class="dek">{d.dek}</p>
    <p class="meta">
      {날짜표기(d.pubDate)}
      {d.updatedDate && <span> · {날짜표기(d.updatedDate)} 수정</span>}
      <span> · {d.author}</span>
    </p>

    {d.image && (
      <figure>
        <img src={d.image.src} alt={d.image.대체텍스트} loading="eager" />
        {/* 🔴 「제공」을 부기하지 않는다 — 「설명. / 라이엇 게임즈」 형식이다(중부매일 v7 과 동일) */}
        <figcaption>
          {d.image.캡션} / {d.image.제공처}
        </figcaption>
      </figure>
    )}

    {/*
      무엇을 리뷰했는지. ⛔ 대상이 있어야 리뷰다.
      🔴 [2026-10-26 · 사장님] 「순한글, 번역투, **너희 ai만 쓰는 표현 금지**」
        여기가 「대상 / 일시 / 주체」라는 표였다. 그것은 우리가 자료를 담는 칸 이름이지
        독자가 읽는 말이 아니다. 신문 지면이 쓰는 꼴로 한 줄로 적는다.
    */}
    <p class="subject">
      {d.subject.주체} 「{d.subject.명칭}」 ·{' '}
      {날짜표기(d.subject.일시)}{' '}
      {d.subject.유형 === 'match' ? '경기' : d.subject.유형 === 'channel' ? '확인' : '공개'}
    </p>

    <div class="body">
      <Content />
    </div>

    {/*
      🔴🔴 [2026-10-26 · 사장님 지시] 「리뷰라고 꼭 비평일 필요는 없다.
        **오히려 네티즌들의 댓글을 리뷰로 사용하도록 해라.**」
      ⛔ 당사가 좋다·나쁘다를 판정하지 않는다. 이용자가 실제로 작성한 문장을 **원문대로**
        전재하고, 문장마다 입수 경로를 연결한다. 주소가 없는 댓글은 스키마가 차단한다.
      ⛔ 계정명을 기재하지 않는다 — 전재 대상은 문장이지 개인이 아니다.
    */}
    {d.반응.length > 0 && (
      <section class="react">
        <h2>네티즌 반응</h2>
        <ul>
          {d.반응.map((r) => (
            <li>
              <blockquote>{r.내용}</blockquote>
              <p class="from">
                <a href={r.주소} rel="nofollow noopener">{r.출처}</a>
              </p>
            </li>
          ))}
        </ul>
        <p class="fine">
          공개된 게시판에 올라온 글을 그대로 옮겼습니다. 아이디는 쓰지 않습니다.
        </p>
      </section>
    )}

    {/* 🔴 사장님 — 「스포츠는 당일 경기 내용과 결과, **다음 경기 일정 포함**」 */}
    {d.다음일정 && (
      <section class="next">
        <h2>다음 일정</h2>
        <p>
          <b>{d.다음일정.명칭}</b> · {날짜표기(d.다음일정.일시)} · {d.다음일정.주체}
        </p>
      </section>
    )}

    {/* 🔴 [2026-10-26 · 사장님] 「케이컬쳐와이어에서 **보도자료를 잘 활용해라**」
        ⛔ 쓴 것만 적는다. 안 쓴 보도자료를 실적처럼 늘어놓지 않는다. */}
    {d.보도자료.length > 0 && (
      <section class="src">
        <h2>참고한 보도자료</h2>
        <ul>
          {d.보도자료.map((b) => (
            <li>
              {b.발표처} — <a href={b.주소} rel="nofollow noopener">{b.제목}</a>
              {b.일시 && <span> ({날짜표기(b.일시)})</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {d.sources.length > 0 && (
      <section class="src">
        <h2>수치 출처</h2>
        <ul>
          {d.sources.map((s) => (
            <li>
              {s.org} — {s.api}
              {s.url && <span> · <a href={s.url} rel="nofollow noopener">{s.url}</a></span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {d.image && (
      <p class="photo-src">
        사진 — {d.image.제공처}. 받아 온 곳:{' '}
        <a href={d.image.출처주소} rel="nofollow noopener">{d.image.출처주소}</a>
      </p>
    )}

    {d.corrections.length > 0 && (
      <section class="corr">
        <h2>정정</h2>
        <ul>
          {d.corrections.map((c) => <li>{날짜표기(c.date)} — {c.note}</li>)}
        </ul>
      </section>
    )}

    {관련리뷰.length > 0 && (
      <section class="more">
        <h2>{해당분류?.명칭} 더 보기</h2>
        <ul>
          {관련리뷰.map((r) => <li><a href={`/ko/review/${r.id}`}>{r.data.title}</a></li>)}
        </ul>
      </section>
    )}
  </article>
</WikiTip>

<style>
  .cat { font-size: .8rem; font-weight: 700; margin: 0 0 .4rem; }
  h1 { font-size: 1.7rem; line-height: 1.35; letter-spacing: -.02em; margin: 0 0 .5rem; }
  .dek { color: var(--muted); margin: 0 0 .6rem; }
  .meta { color: var(--muted); font-size: .82rem; margin: 0 0 1.6rem; }
  figure { margin: 0 0 1.6rem; }
  figure img { width: 100%; height: auto; display: block; border-radius: 6px; }
  figcaption { font-size: .82rem; color: var(--muted); margin-top: .5rem; }
  .subject { margin: 0 0 2rem; padding: .7rem .9rem; font-size: .88rem;
             background: var(--card); border-left: 3px solid var(--accent); border-radius: 0 4px 4px 0; }
  .body :global(h2) { font-size: 1.15rem; margin: 2rem 0 .6rem; }
  .body :global(p) { margin: 0 0 1.1rem; }
  /* 🔴 [2026-11-10] 채널번호·편성표는 본문의 절반이 표다. 표 꾸밈이 없으면 줄이 붙어
     읽히지 않고, 칸이 많은 표는 390px 화면 밖으로 밀려 가로 흔들림이 생긴다.
     ⇒ 표 자체를 가로로 미는 칸으로 만든다 — 지면 전체가 흔들리지 않는다 */
  .body :global(h3) { font-size: 1rem; margin: 1.5rem 0 .5rem; }
  .body :global(ul), .body :global(ol) { margin: 0 0 1.1rem; padding-left: 1.2rem; }
  .body :global(li) { margin: .2rem 0; }
  .body :global(a) { color: var(--accent); }
  .body :global(img) { max-width: 100%; height: auto; display: block; margin: 0 0 1.4rem; }
  .body :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 1.4rem;
                         font-size: .88rem; display: block; overflow-x: auto; }
  .body :global(th), .body :global(td) { padding: .45rem .6rem; text-align: left;
                                         border-bottom: 1px solid var(--line); white-space: nowrap; }
  .body :global(th) { background: var(--card); font-weight: 700; }
  .react { margin-top: 2.5rem; }
  .react h2 { font-size: 1.15rem; margin: 0 0 .8rem; }
  .react ul { list-style: none; padding: 0; margin: 0; }
  .react li { padding: .9rem 0; border-top: 1px solid var(--line); }
  .react blockquote { margin: 0; font-size: .96rem; }
  .react blockquote::before { content: '“'; color: var(--accent); margin-right: .1rem; }
  .react blockquote::after { content: '”'; color: var(--accent); margin-left: .1rem; }
  .react .from { margin: .35rem 0 0; font-size: .78rem; color: var(--muted); }
  .react .fine { margin-top: .9rem; font-size: .78rem; color: var(--muted); }
  .next { margin-top: 2.5rem; padding: .9rem 1rem; background: var(--card);
          border: 1px solid var(--line); border-radius: 6px; }
  .next h2 { font-size: 1rem; margin: 0 0 .3rem; }
  .next p { margin: 0; font-size: .9rem; }
  .src, .corr, .more { margin-top: 2.5rem; }
  .src h2, .corr h2, .more h2 { font-size: 1rem; margin: 0 0 .5rem; }
  .src ul, .corr ul, .more ul { padding-left: 1.1rem; margin: 0; }
  .src li, .corr li, .more li { font-size: .88rem; margin: .25rem 0; }
  .photo-src { margin-top: 1.6rem; font-size: .8rem; color: var(--muted); }
  /* 🔴 [2026-10-31] 출처 주소가 길면 390px 화면 밖으로 밀려 가로 흔들림이 생겼다
     (경기 기록 주소 — 406px·463px 로 재짐). 주소는 아무 데서나 줄을 바꾼다 */
  .src li, .photo-src { overflow-wrap: anywhere; }
</style>
