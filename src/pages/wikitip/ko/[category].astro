---
/**
 * K Culture Wire — **분류별 리뷰 목록.** (`/ko/esports` 등)
 *
 * ── ⛔ 리뷰가 0건인 분류도 지면을 생성하는 이유 ───────────────────────
 * 메뉴에 9종이 모두 게시돼 있다(사장님이 9종을 전부 지정하셨다). 그런데 수록분이 없다고
 * 지면을 생성하지 않으면 **클릭 시 404** 다. 본 저장소에 이미 기재된 교훈 —
 * 「지면만 만들고 메뉴를 안 고치면 절반만 수행한 것」의 역방향 사례다.
 *
 * ⇒ 9종을 모두 생성한다. 단 **수록분이 없는 분류는 `noindex`** 다 — 공란 지면이 색인되면
 *   사이트 전체가 빈약해 보인다. 이용자에게는 「아직 없다」를 그대로 기재한다.
 * ⛔ 「곧 게재됩니다」를 기재하지 않는다. 시점을 모르는 것을 약속하지 않는다.
 */
import { getCollection } from 'astro:content';
import WikiTip from '../../../layouts/WikiTip.astro';
import { 분류, 분류조회 } from '../../../lib/리뷰분류.mjs';

export async function getStaticPaths() {
  const 전체 = (await getCollection('kcwReviews')).filter((e) => !e.data.draft);
  /* ⛔ 수록분이 있는 분류만 순회하지 않는다 — 메뉴가 9종을 모두 게시하므로 9종을 모두 생성한다 */
  return 분류.map((c) => ({
    params: { category: c.코드 },
    props: {
      목록: 전체.filter((r) => r.data.category === c.코드)
        .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate)),
    },
  }));
}

const { category } = Astro.params;
const { 목록 } = Astro.props;
const 해당분류 = 분류조회(category);

const 날짜표기 = (d: Date) => {
  const t = new Date(d);
  return `${t.getFullYear()}년 ${t.getMonth() + 1}월 ${t.getDate()}일`;
};

/* ⛔ 제목에 사이트 이름을 적지 않는다 — 틀(WikiTip.astro)이 「 | K Culture Wire」를 붙인다.
   🔴 처음에 여기에 적었더니 라이브 제목이 「드라마리뷰 — K Culture Wire | K Culture Wire」였다.
   ⚠ 대신 분류마다 **무엇을 다루는지**를 붙인다 — 손님이 검색하는 말이 거기에 들어 있다. */
const TITLE = `${해당분류?.명칭 ?? category} — ${해당분류?.중심내용 ?? ''}`.trim().replace(/—\s*$/, '');
const DESC = 목록.length === 0
  ? `${해당분류?.설명 ?? ''} 아직 올라온 리뷰가 없습니다.`
  : `${해당분류?.설명 ?? ''} 리뷰 ${목록.length}건.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  inLanguage: 'ko',
  name: TITLE,
  description: DESC,
  url: `https://www.kculturewire.com/ko/${category}`,
};
---

<WikiTip
  title={TITLE}
  description={DESC}
  lang="ko"
  page={`/ko/${category}`}
  jsonLd={jsonLd}
  noindex={목록.length === 0}
>
  <h1>{해당분류?.명칭 ?? category}</h1>

  {목록.length === 0 && (
    <p class="none">
      아직 올라온 리뷰가 없습니다. <a href="/ko">다른 것</a>을 보십시오.
    </p>
  )}

  {목록.length > 0 && (
    <ul class="list">
      {/* 🔴 [2026-10-28 · 사장님] 「**k-review 드라마 등 각 메뉴에도 썸네일 넣어**」
          앞 지면(`/ko`)에는 썸네일이 있는데 분류 지면에는 제목과 설명뿐이었다.
          ⛔ `:has()` 를 쓰지 않는다 — 사진이 있는 줄에만 이름표를 직접 단다(`/ko` 와 같은 길).
          ⛔ 자르는 기준은 «위»다. 가운데로 자르면 얼굴이 날아간다(사장님 2026-10-28). */}
      {목록.map((r) => (
        <li class={r.data.image ? 'with-thumb' : ''}>
          {r.data.image && (
            <a class="thumb" href={`/ko/review/${r.id}`} tabindex="-1" aria-hidden="true">
              <img src={r.data.image.src} alt="" loading="lazy" />
            </a>
          )}
          <a class="t" href={`/ko/review/${r.id}`}>{r.data.title}</a>
          <p class="dek">{r.data.dek}</p>
          <p class="when">{날짜표기(r.data.pubDate)} · {r.data.subject.명칭}</p>
        </li>
      ))}
    </ul>
  )}

  {/* 🔴 사장님 사진 규칙 — 해당 분류에 적용되는 항목만 공개한다 */}
  <p class="fine">
    {해당분류?.계열 === 'sports'
      ? '여기 사진은 구단이나 협회가 제공한 경기 사진만 씁니다. 사진이 없는 경기는 점수판 그림을 저희가 만들어 올립니다.'
      : '여기 사진은 방송사나 해당 OTT가 제공한 것만 씁니다.'}
  </p>
</WikiTip>

<style>
  h1 { font-size: 1.5rem; letter-spacing: -.02em; margin: 0 0 .4rem; }
  .lede { color: var(--muted); margin: 0 0 2rem; }
  .none { color: var(--muted); }
  .list { list-style: none; padding: 0; margin: 0; }
  .list li { padding: 1rem 0; border-top: 1px solid var(--line); }
  /* ⚠ `:has()` 를 안 쓴다 — 안 도는 바우저가 있으면 짱이 통째로 무너진다.
     사진이 있는 줄에만 이름표를 달아 갈라 낸다(`/ko` 와 같은 길). */
  .list li.with-thumb { display: grid; grid-template-columns: 96px 1fr; gap: 0 .9rem; align-items: start; }
  .list li.with-thumb > .t,
  .list li.with-thumb > .dek,
  .list li.with-thumb > .when { grid-column: 2; }
  .thumb { grid-column: 1; grid-row: 1 / span 3; line-height: 0; }
  /* 🔴 [2026-10-28 · 사장님] 「썸네일에 사람 얼굴이 잘렸잖아. 사진을 위를 기준으로 하면
     얼굴이 잘리지 않을거야」 — 자르는 기준을 «위»로 둔다. 발밑이 잘리는 편이 낫다. */
  .thumb img { width: 96px; height: 64px; object-fit: cover; object-position: top; border-radius: 4px; }
  .list a.t { font-weight: 700; font-size: 1.05rem; }
  .dek { margin: .3rem 0 0; color: var(--muted); font-size: .9rem; }
  .when { margin: .3rem 0 0; color: var(--muted); font-size: .8rem; }
  .fine { margin-top: 2.5rem; color: var(--muted); font-size: .82rem; }
</style>
