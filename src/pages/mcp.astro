---
/**
 * `/mcp` — **MCP 서버 안내.** 손님의 AI(Claude·ChatGPT 등)가 우리 자료를 직접 부르게 붙이는 법.
 *
 * 🔴 [2026-11-26 · 5번] 사장님 2026-11-25 「에스마켓츠 어디에 팔 지 정했으니 팔기 시작해」 — 다섯 가운데 둘째.
 *   영어권 손님은 구글이 아니라 AI 로 온다. 서버(`/v1/mcp`)만 세우고 안내가 없으면 아무도 못 붙인다.
 * ⛔ 도구 목록을 여기 손으로 적지 않는다 — 서버의 도구표(src/lib/mcp.mjs)에서 읽는다. 둘이 갈리지 않는다.
 * ⛔ 없는 것을 약속하지 않는다 — 무료 등급의 한도와 「못 받은 것은 못 받았다고 적는다」를 그대로 쓴다.
 */
import Base from '../layouts/Base.astro';
import { 도구표 } from '../lib/mcp.mjs';

const TITLE = 'MCP server — Korean market data for your AI assistant';
const DESC = 'Connect Claude, ChatGPT or any MCP client to SeoulMarkets: Korean filings, valuations, analyst targets, '
  + 'trade and index data in English, with the source and collection date on every answer.';
const URL = 'https://seoulmarkets.com/v1/mcp';
const 도구들 = 도구표.map((d) => ({ 이름: d.name, 설명: d.description, 인자: Object.keys(d.인자) }));
const 설정 = JSON.stringify({ mcpServers: { seoulmarkets: { type: 'http', url: URL } } }, null, 2);
---

<Base title={TITLE} description={DESC} noAds>
  <div class="wrap">
    <article class="mp">
      <p class="kicker">SeoulMarkets · for developers</p>
      <h1>MCP server</h1>
      <p class="lead">
        Point your AI assistant at one URL and it can query Korean market data in English —
        filings, valuations, analyst target prices, trade and index series — instead of guessing.
        Every answer carries its <b>source</b> and the <b>date we collected it</b>.
      </p>

      <p class="url"><span>Server URL</span><code>{URL}</code></p>

      <h2>Connect</h2>
      <ul class="steps">
        <li><b>Claude</b> — Settings → Connectors → Add custom connector → paste the URL above.</li>
        <li><b>ChatGPT</b> — Settings → Connectors (developer mode) → add a remote MCP server with the URL above.</li>
        <li><b>Claude Code, Cursor and other clients</b> — add this to your MCP configuration:</li>
      </ul>
      <pre class="code"><code>{설정}</code></pre>
      <p class="fine">Transport: Streamable HTTP, stateless, JSON responses. No sign-in is needed for the free tier.</p>

      <h2>{도구들.length} tools</h2>
      <div class="tablebox">
        <table>
          <thead><tr><th>Tool</th><th>What it returns</th><th>Arguments</th></tr></thead>
          <tbody>
            {도구들.map((d) => (
              <tr>
                <td><code>{d.이름}</code></td>
                <td>{d.설명}</td>
                <td class="args">{d.인자.length ? d.인자.join(', ') : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>What to expect</h2>
      <ul class="steps">
        <li>The tools read the same data as the <a href="/api">HTTP API</a>. Nothing is generated by a model on our side.</li>
        <li>A field the source did not provide is marked as not collected. We do not fill gaps with zero.</li>
        <li>The free tier is rate-limited and returns a limited number of rows per call.
          Full files and higher limits come with a licence — see <a href="/pricing">pricing</a>, or <a href="/trial">request a trial</a>.</li>
        <li>These are statistics from public filings. They are not investment advice.</li>
      </ul>

      <p class="fine">Questions, or a dataset you need that is not listed:
        <span class="mail">admin@klifedesign.net</span></p>
    </article>
  </div>
</Base>

<style>
  .wrap { padding: 0 1rem; }
  .mp { max-width: 46rem; margin: 0 auto; }
  .kicker { font-size: .74rem; text-transform: uppercase; letter-spacing: .08em; color: var(--accent);
            font-weight: 700; margin: 1.2rem 0 .3rem; }
  .mp h1 { font-size: clamp(1.7rem, 5vw, 2.4rem); line-height: 1.2; margin: 0 0 .6rem; }
  .mp h2 { font-size: 1.15rem; margin: 1.8rem 0 .6rem; }
  .lead { font-size: 1.05rem; line-height: 1.7; margin: 0 0 1.2rem; }
  .url { margin: 0 0 1rem; padding: .8rem 1rem; border: 2px solid var(--accent, #b4884a); border-radius: 8px; }
  .url span { display: block; font-size: .76rem; text-transform: uppercase; letter-spacing: .06em;
              color: var(--muted); margin-bottom: .25rem; }
  .url code { font-size: 1rem; font-weight: 700; word-break: break-all; user-select: all; }
  .steps { padding-left: 1.2rem; margin: 0 0 .8rem; line-height: 1.7; font-size: .95rem; }
  .steps li { margin: 0 0 .35rem; }
  .code { margin: 0 0 .6rem; padding: .8rem 1rem; background: var(--card); border: 1px solid rgba(127,127,127,.35);
          border-radius: 8px; overflow-x: auto; font-size: .85rem; line-height: 1.5; }
  .tablebox { overflow-x: auto; margin: 0 0 1rem; }
  table { border-collapse: collapse; width: 100%; font-size: .86rem; line-height: 1.5; min-width: 34rem; }
  th, td { text-align: left; vertical-align: top; padding: .5rem .6rem; border-bottom: 1px solid rgba(127,127,127,.3); }
  th { font-size: .76rem; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
  td code { font-size: .82rem; white-space: nowrap; }
  .args { color: var(--muted); font-size: .8rem; }
  .mp a { color: var(--accent); text-decoration: none; border-bottom: 1px solid currentColor; }
  .mp a:hover { color: var(--ink); }
  .fine { font-size: .84rem; color: var(--muted); line-height: 1.6; }
  .mail { user-select: all; font-weight: 600; }
</style>
